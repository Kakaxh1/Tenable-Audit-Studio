<if>
  <condition type:"AND">
    <custom_item>
      type        : CONFIG_CHECK
      description : "Check for set routing-options multicast"
      regex       : "set routing-options multicast .+"
      expect      : "set routing-options multicast .+"
    </custom_item>
  </condition>

  <then>
    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CONFIG_CHECK
          description : "multicast threshold suppress"
          regex       : "set routing-options multicast .+"
          expect      : "set routing-options multicast forwarding-cache threshold suppress [0-9]+"
        </custom_item>

        <custom_item>
          type        : CONFIG_CHECK
          description : "multicast threshold reuse"
          regex       : "set routing-options multicast .+"
          expect      : "set routing-options multicast forwarding-cache threshold reuse [0-9]+"
        </custom_item>

        <custom_item>
          type        : CONFIG_CHECK
          description : "multicast threshold log-warning"
          regex       : "set routing-options multicast .+"
          expect      : "set routing-options multicast forwarding-cache threshold log-warning [0-9]+"
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "JUEX-RT-000680 - The Juniper multicast RP router must be configured to limit the multicast forwarding cache so that its resources are not saturated by managing an overwhelming number of PIM and MSDP source-active entries."
          info        : "MSDP peering between networks enables sharing of multicast source information. Enclaves with an existing multicast topology using PIM-SM can configure their RP routers to peer with MSDP routers. As a first step of defense against a denial-of-service (DoS) attack, all RP routers must limit the multicast forwarding cache to ensure that router resources are not saturated managing an overwhelming number of PIM and MSDP source-active entries."
          solution    : "Configure MSDP-enabled RP routers to limit the multicast forwarding cache for source-active entries.

set routing-options multicast forwarding-cache threshold suppress <1..200000>
set routing-options multicast forwarding-cache threshold reuse <1..200000>
set routing-options multicast forwarding-cache threshold log-warning <percent to generate warning>"
          reference   : "800-53|SC-5,800-53r5|SC-5a.,800-53r5|SC-5b.,CAT|III,CCI|CCI-002385,CCI|CCI-004866,CSF|DE.CM-1,CSF|PR.DS-4,CSF2.0|DE.CM-01,CSF2.0|PR.IR-01,DISA_Benchmark|Juniper_EX_RTR_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|SC-5,ITSG-33|SC-5a.,NESA|T3.3.1,NIAv2|GS8e,NIAv2|GS10c,QCSC-v1|8.2.1,Rule-ID|SV-254040r997535_rule,STIG-ID|JUEX-RT-000680,Vuln-ID|V-254040"
          see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Juniper_EX_Switches_Y26M01_STIG.zip"
          show_output : YES
        </report>
      </then>
    </if>
  </then>

  <else>
    <report type:"PASSED">
      description : "JUEX-RT-000680 - The Juniper multicast RP router must be configured to limit the multicast forwarding cache so that its resources are not saturated by managing an overwhelming number of PIM and MSDP source-active entries."
      info        : "MSDP peering between networks enables sharing of multicast source information. Enclaves with an existing multicast topology using PIM-SM can configure their RP routers to peer with MSDP routers. As a first step of defense against a denial-of-service (DoS) attack, all RP routers must limit the multicast forwarding cache to ensure that router resources are not saturated managing an overwhelming number of PIM and MSDP source-active entries."
      solution    : "Configure MSDP-enabled RP routers to limit the multicast forwarding cache for source-active entries.

set routing-options multicast forwarding-cache threshold suppress <1..200000>
set routing-options multicast forwarding-cache threshold reuse <1..200000>

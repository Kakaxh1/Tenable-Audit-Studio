      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Juniper_EX_Switches_Y26M01_STIG.zip"
      regex       : "set interfaces .+ proxy-arp (un)restricted?"
      expect      : "set interfaces .+ proxy-arp (un)restricted?"
      severity    : MEDIUM
    </custom_item>
  </then>

  <else>

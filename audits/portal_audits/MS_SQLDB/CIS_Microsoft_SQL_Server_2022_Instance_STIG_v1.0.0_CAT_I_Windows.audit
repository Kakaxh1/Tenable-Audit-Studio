<check_type:"Windows" version:"2">
<group_policy:"CIS Microsoft SQL Server 2022 Instance STIG">

<if>
  <condition type:"AND">
    <custom_item>
      type        : REG_CHECK
      description : "Check for Microsoft SQL Server Installation"
      value_type  : POLICY_TEXT
      value_data  : "HKLM\SOFTWARE\Microsoft\Microsoft SQL Server\@SQL_VERSION@"
      reg_option  : MUST_EXIST
    </custom_item>
  </condition>


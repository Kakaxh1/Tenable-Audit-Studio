#
# description : This .audit is designed against the CIS PostgreSQL 18 Benchmark v1.0.0
#
#<ui_metadata>
#<display_name>CIS PostgreSQL 18 v1.0.0 L1 Database Unix</display_name>
#<spec>
#  <type>CIS</type>
#  <name>PostgreSQL 18</name>
#  <profile>L1 Database</profile>
#  <version>1.0.0</version>

    <if>
      <condition auto:"WARNING" type:"AND">
        <custom_item>
          type        : SQL_POLICY
          description : "Review file and directory permissions for every returned subdirectory and tablespace location"
          sql_request : "select name, setting from pg_settings where (name ~ '_directory$' or name ~ '_tablespace')"

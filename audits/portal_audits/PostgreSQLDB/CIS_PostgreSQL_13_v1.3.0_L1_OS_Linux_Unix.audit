    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "fips-mode-setup"
          cmd         : "fips-mode-setup --check"
          expect      : "FIPS mode is enabled."
        </custom_item>


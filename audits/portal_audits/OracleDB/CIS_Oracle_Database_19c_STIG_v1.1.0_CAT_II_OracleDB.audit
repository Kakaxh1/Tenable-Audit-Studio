#<ui_metadata>
#<display_name>CIS Oracle Database 19c STIG v1.1.0 CAT II OracleDB</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Oracle Database 19c STIG</name>
#  <profile>CAT II</profile>
#  <version>1.1.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/26166</link>
#</spec>

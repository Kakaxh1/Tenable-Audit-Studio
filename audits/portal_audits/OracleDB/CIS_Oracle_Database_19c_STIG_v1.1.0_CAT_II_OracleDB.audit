https://docs.oracle.com/en/database/oracle/oracle-database/19/refrn/REMOTE_LOGIN_PASSWORDFILE.html"
      reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CAT|II,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,LEVEL|2M,NESA|T3.2.1,Rule-ID|SV-270526r1115966_rule,STIG-ID|O19C-00-009400,SWIFT-CSCv1|2.3,Vuln-ID|V-270526"
      see_also    : "https://workbench.cisecurity.org/benchmarks/26166"
      sql_request : "SELECT name, inst_id, con_id, value AS PARAMETER_VALUE FROM sys.gv_$parameter WHERE upper(name) = 'REMOTE_LOGIN_PASSWORDFILE' ORDER BY 1;"
      sql_types   : REGEX, REGEX, REGEX, REGEX
      sql_expect  : ".+", ".+", ".+", "(EXCLUSIVE|NONE)"
    </custom_item>

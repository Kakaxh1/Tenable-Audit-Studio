              description : "check if extproc is accessible via listener"
              value_type  : POLICY_TEXT
              value_data  : "@WIN_ORACLE_HOME@\network\admin\listener.ora"
              regex       : "(?i)^[^#]+\((key|program)[\s]*=[\s]*extproc[\s]*\).*$"
              expect      : "(?i)^[^#]+\((key|program)[\s]*=[\s]*extproc[\s]*\).*$"
            </custom_item>
          </condition>


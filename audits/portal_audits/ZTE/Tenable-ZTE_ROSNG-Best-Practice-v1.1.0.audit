#<ui_metadata>
#<display_name>Tenable ZTE ROSNG Best Practices</display_name>
#<spec>
#  <type>TNS</type>
#  <name>Tenable ZTE ROSNG Best Practices</name>
#  <version>1.1.0</version>
#  <link>https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&amp;id=30768582&amp;type=docfeedback</link>
#</spec>
#<labels>tenable,zte</labels>
#</ui_metadata>

<check_type:"ZTE_ROSNG">

<if>
  <condition type:"AND">
    <custom_item>
      type        : CMD_EXEC
      description : "ZTE ZXROSNG is installed"
      cmd         : "show zxrp-info"
      expect      : "ZXROSNG"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "Tenable ZTE ROSNG Best Practices"
      see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
      show_output : YES
    </report>

## 7  Management Layer Security Requirements
# 7.1 (1.1) Secure Login and telnet Disabling

    <custom_item>
      type        : CMD_EXEC
      description : "1.1 Secure Login and telnet Disabling - Enable SSH server"
      info        : "From the perspective of security, the management plane should support at least the SSH/SSL login mode. Ordinary plain text telnet/ftp login is vulnerable to attack, and such secure login modes as SSH and SFTP should be supported. The session validity period must be limited."
      solution    : "It is recommended to enable ssh server

      Enable SSH server by running:
      ZXR10 (config)#ssh server enable"
      see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
      cmd         : "show running-config ssh all"
      expect      : "ssh server enable"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "1.1 Secure Login and telnet Disabling - Disable telnet server"
      info        : "From the perspective of security, the management plane should support at least the SSH/SSL login mode. Ordinary plain text telnet/ftp login is vulnerable to attack, and such secure login modes as SSH and SFTP should be supported. The session validity period must be limited."
      solution    : "It is recommended to disable telnet server.

      Disable telnet server by running:
      ZXR10 (config)#line telnet server disable"
      see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
      cmd         : "show running-config telnet all"
      expect      : "line telnet server disable"
    </custom_item>

# 7.2 (1.2) Password Security Policy

    <if>
      <condition type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "Check if strong-password check has been disabled"
          cmd         : "show running-config system-user all"
          expect      : "strong-password check disable"
        </custom_item>
      </condition>

      <then>
        <report type:"WARNING">
          description : "1.2 Password Security Policy - a) The default password length shouldn't be below 8 characters"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' is displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended to set password length to at least 8 characters

          ZXR10# configure terminal
          ZXR10 (config)# system-user
          ZXR10 (config-system-user)# strong-password length 8"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>

        <report type:"WARNING">
          description : "1.2 Password Security Policy - b) The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' is displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended to set password consists of digits, letters, and symbols

          ZXR10# configure terminal
          ZXR10 (config)# system-user
          ZXR10 (config-system-user)# strong-password length 8 character number capital lowercase special-character"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>

        <report type:"WARNING">
          description : "1.2 Password Security Policy - c) Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password - strong-password dictionary"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' is displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended to set password to support check of simple passwords and weak passwords

          ZXR10# configure terminal
          ZXR10 (config)# system-user
          ZXR10 (config-system-user)# strong-password dictionary"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>

        <report type:"WARNING">
          description : "1.2 Password Security Policy - c) Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password - same-consecutive"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' is displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended to set password to support check of simple passwords and weak passwords

          ZXR10# configure terminal
          ZXR10 (config)# system-user
          ZXR10 (config-system-user)# strong-password same-consecutive 5"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>

        <report type:"WARNING">
          description : "1.2 Password Security Policy - d) Display password in cipher text"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' is displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended config to support stores passwords in ciphertext, do not include the following phrases in the configuration:

          - encrypt none
          - authentication null
          - encrypted null
          - encryption null
          - security-protocol noauth
          - encrypted noauth"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>

        <report type:"WARNING">
          description : "1.2 Password Security Policy - e) Check for strong-password username-related-chk inverse"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended to set the password to irrelevant to the username and date.

          ZXR10# configure terminal
          ZXR10 (config)# system-user
          ZXR10 (config-system-user)# strong-password username-related-chk inverse"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>

        <report type:"WARNING">
          description : "1.2 Password Security Policy - e) Check for strong-password date-check enable"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended to set the password to irrelevant to the username and date.

          ZXR10# configure terminal
          ZXR10 (config)# system-user
          ZXR10 (config-system-user)# strong-password date-check enable"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>

        <report type:"WARNING">
          description : "1.2 Password Security Policy - f) The validity period of an account can be configured"
          info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

          a)	The default password length shouldn't be below 8 characters.

          b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

          c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

          d)	Display password in cipher text. Check either of the following words exist in configuration file:
          -	Encrypt none
          -	Authentication null
          -	Encrypted null
          -	Encryption null
          -	Security-protocol noauth
          -	Encrypted noauth

          e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
          If 'strong-password max-length' displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

          f)	The validity period of an account can be configured.

          NOTE: strong-password check disable has been configured.

          NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
          solution    : "It is recommended to set the password validity period

          ZXR10# configure terminal
          ZXR10 (config)# system-user
          ZXR10 (config-system-user)# user-name xxx
          ZXR10 (config-system-user-username)# password-duration 360"
          see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
          show_output : YES
        </report>
      </then>

      <else>
        <if>
          <condition type:"OR">
            <custom_item>
              type        : CMD_EXEC
              description : "Check system-user command for password length"
              cmd         : "show running-config system-user all"
              expect      : ".*strong-password length ([8-9]|[1-9][0-9]|\\d{3,})"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "Check strong-password-info command for password length"
              cmd         : "show strong-password-info"
              expect      : "Min\s+Length\s+:\s+([8-9]|[1-9][0-9]|\\d{3,})"
            </custom_item>
          </condition>

          <then>
            <report type:"PASSED">
              description : "1.2 Password Security Policy - a) The default password length shouldn't be below 8 characters"
              info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

              a)	The default password length shouldn't be below 8 characters.

              b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

              c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

              d)	Display password in cipher text. Check either of the following words exist in configuration file:
              -	Encrypt none
              -	Authentication null
              -	Encrypted null
              -	Encryption null
              -	Security-protocol noauth
              -	Encrypted noauth

              e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
              If 'strong-password max-length' is displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

              f)	The validity period of an account can be configured."
              solution    : "It is recommended to set password length to at least 8 characters

              ZXR10# configure terminal
              ZXR10 (config)# system-user
              ZXR10 (config-system-user)# strong-password length 8"
              see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
              show_output : YES
            </report>
          </then>

          <else>
            <report type:"FAILED">
              description : "1.2 Password Security Policy - a) The default password length shouldn't be below 8 characters"
              info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

              a)	The default password length shouldn't be below 8 characters.

              b)	The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4

              c)	Configure 'strong-password dictionary' and 'same-consecutive' to avoid weak password

              d)	Display password in cipher text. Check either of the following words exist in configuration file:
              -	Encrypt none
              -	Authentication null
              -	Encrypted null
              -	Encryption null
              -	Security-protocol noauth
              -	Encrypted noauth

              e)	If 'strong-password max-length' is not displayed in configuration, then pass this check.
              If 'strong-password max-length' is displayed in configuration, but max-length value below 10, or not both configuration 'username-related-chk inverse' and 'strong-password date-check enable' commands, then fail this check.

              f)	The validity period of an account can be configured.

              NOTE: strong-password length and/or strong-password-info is not configured."
              solution    : "It is recommended to set password length to at least 8 characters

              ZXR10# configure terminal
              ZXR10 (config)# system-user
              ZXR10 (config-system-user)# strong-password length 8"
              see_also    : "https://support.zte.com.cn/support/doccenter/DocumentProductHandBookDetail.aspx?sid=102&id=30768582&type=docfeedback"
              show_output : YES
            </report>
          </else>
        </if>

        <if>
          <condition type:"OR">
            <custom_item>
              type        : CMD_EXEC
              description : "Check system-user command for password complexity"
              cmd         : "show running-config system-user all"
              expect      : "(.*strong-password length .+ character number capital lowercase special-character|.*strong-password length .+ character number capital lowercase|.*strong-password length .+ character number capital special-character|.*strong-password length .+ character number lowercase special-character|.*strong-password length .+ character capital lowercase special-character)|(.*strong-password length .+ character-set-num [3-4])"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "Check strong-password-info command for password complexity"
              cmd         : "show strong-password-info"
              expect      : "Character\sSet\s+ :\s+(number,\s+capital,\s+lowercase,\s+special-character|number,\s+capital,\s+lowercase|number,\s+capital,\s+special-character|number,\s+lowercase,\s+special-character|capital,\s+lowercase,\s+special-character)"
            </custom_item>
          </condition>

          <then>
            <report type:"PASSED">
              description : "1.2 Password Security Policy - b) The password must include either three of 'number', 'capital', 'lowercase', 'special-character' or set the 'character-set-num' value to 3-4"
              info        : "Strong passwords are supported to prevent passwords from being cracked. When a password is set, password complexity is detected by default. If a password does not meet the policy, a warning is required. A strong password mode should be provided. The password verification mechanism is as follows:

              a)	The default password length shouldn't be below 8 characters.


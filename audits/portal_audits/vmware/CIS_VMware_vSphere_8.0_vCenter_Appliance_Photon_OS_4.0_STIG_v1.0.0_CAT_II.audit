          expect      : "^[\\s]*-w[\\s]+/var/log/lastlog[\\s]+(-p[\\s]+([rx]*wa[rx]*))([\\s]*(-k[\\s]+|-F[\\s]+key=)[-\\w]+)*[\\s]*$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC

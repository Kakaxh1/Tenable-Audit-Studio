          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/logs/threadmonitor.log\"[\\s]+Tag=\"ui-threadmonitor\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>


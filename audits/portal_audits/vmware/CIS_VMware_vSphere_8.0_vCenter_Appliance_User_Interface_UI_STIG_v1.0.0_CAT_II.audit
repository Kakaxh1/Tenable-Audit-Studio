          type        : CMD_EXEC
          description : "check for vsphere-ui catalina"
          cmd         : "/bin/echo $(/bin/cat /etc/vmware-syslog/vmware-services-vsphere-ui.conf)"
          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/logs/catalina.\\*.log\"[\\s]+Tag=\"ui-runtime-catalina\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>


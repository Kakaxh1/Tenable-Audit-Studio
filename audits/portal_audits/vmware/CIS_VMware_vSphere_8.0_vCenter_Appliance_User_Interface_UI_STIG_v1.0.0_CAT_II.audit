          cmd         : "/bin/echo $(/bin/cat /etc/vmware-syslog/vmware-services-vsphere-ui.conf)"
          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/logs/localhost.\*.log\"[\\s]+Tag=\"ui-runtime-localhost\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>


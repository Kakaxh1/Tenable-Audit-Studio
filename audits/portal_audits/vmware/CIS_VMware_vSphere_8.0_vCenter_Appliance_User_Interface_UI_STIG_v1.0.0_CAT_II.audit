      see_also    : "https://workbench.cisecurity.org/benchmarks/23631"
      file        : "/usr/lib/vmware-vsphere-ui/server/conf/catalina.properties"
      regex       : "^[\\s]*org.apache.catalina.connector.RECYCLE_FACADES[\\s]*=[\\s]*"
      expect      : "^[\\s]*org.apache.catalina.connector.RECYCLE_FACADES[\\s]*=[\\s]*true[\\s]*$"
      required    : NO
    </custom_item>

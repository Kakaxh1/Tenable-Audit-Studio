        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "check for vsphere-ui gc log"
          cmd         : "/bin/echo $(/bin/cat /etc/vmware-syslog/vmware-services-vsphere-ui.conf)"
          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/vsphere-ui-gc\\*\"[\\s]+Tag=\"ui-gc\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "check for vsphere-ui rpm log"
          cmd         : "/bin/echo $(/bin/cat /etc/vmware-syslog/vmware-services-vsphere-ui.conf)"
          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/logs/vsphere-ui-rpm.log\"[\\s]+Tag=\"ui-rpm\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>


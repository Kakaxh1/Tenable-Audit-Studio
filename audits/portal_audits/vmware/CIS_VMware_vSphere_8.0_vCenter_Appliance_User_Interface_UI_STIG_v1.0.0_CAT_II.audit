          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/logs/changelog.log\"[\\s]+Tag=\"ui-changelog\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>


          cmd         : "/bin/echo $(/bin/cat /etc/vmware-syslog/vmware-services-vsphere-ui.conf)"
          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/logs/vspheremessaging.log\"[\\s]+Tag=\"ui-vspheremessaging\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "check for vsphere-ui runtime log stderr"
          cmd         : "/bin/echo $(/bin/cat /etc/vmware-syslog/vmware-services-vsphere-ui.conf)"
          expect      : "[\\s]*input\\(type=\"imfile\"[\\s]+File=\"/var/log/vmware/vsphere-ui/logs/vsphere-ui-runtime.log\\*\"[\\s]+Tag=\"ui-runtime-stderr\"[\\s]+Severity=\"info\"[\\s]+Facility=\"local0\"\\)[\\s]*"
        </custom_item>


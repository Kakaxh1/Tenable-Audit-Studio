esxcli system ssh server config set -k ciphers -v aes256-gcm@openssh.com mailto:aes256-gcm@openssh.com,aes128-gcm@openssh.com mailto:aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr


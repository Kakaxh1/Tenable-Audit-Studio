      see_also        : "https://workbench.cisecurity.org/benchmarks/27024"
      file            : "/etc/yum.repos.d/*.repo"
      regex           : "^[\\s]*gpgcheck[\\s]*="
      expect          : "^[\\s]*gpgcheck[\\s]*=[\\s]*1[\\s]*$"
      file_required   : NO
      min_occurrences : "1"

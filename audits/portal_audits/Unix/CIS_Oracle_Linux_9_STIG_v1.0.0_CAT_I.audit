          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA3-512"
        </custom_item>

        <custom_item>

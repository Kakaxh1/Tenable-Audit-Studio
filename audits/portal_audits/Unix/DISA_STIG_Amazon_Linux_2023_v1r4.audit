      see_also        : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Amazon_Linux_2023_V1R4_STIG.zip"
      file            : "/etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf"
      regex           : "^[\\s]*ucredit"
      expect          : "^[\\s]*ucredit[\\s]*=[\\s]*@PASSWORD_UCREDIT@[\\s]*$"

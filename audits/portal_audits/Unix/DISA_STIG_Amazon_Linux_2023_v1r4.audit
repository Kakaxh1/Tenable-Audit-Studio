      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Amazon_Linux_2023_V1R4_STIG.zip"
      cmd         : "/sbin/sshd -T | /bin/grep -i ClientAliveInterval"
      expect      : "(?i)^[\\s]*ClientAliveInterval[\\s]+([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\\s]*$"
    </custom_item>


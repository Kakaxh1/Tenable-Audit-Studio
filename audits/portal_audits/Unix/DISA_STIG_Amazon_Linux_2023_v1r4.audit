          cmd         : "(/sbin/grubby --info=ALL | /bin/grep args | /bin/grep -v 'audit=1') 2>&1 | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
          expect      : "^pass$"
        </custom_item>

        <custom_item>

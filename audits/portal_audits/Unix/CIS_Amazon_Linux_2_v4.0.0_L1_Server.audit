              type        : BANNER_CHECK
              description : "banner text"
              file        : "/etc/issue"
              content     : "@BANNER_TEXT@"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "msrv and ID= not included"
              cmd         : "/bin/grep -Psi -- \"(\\\\\\\\v|\\\\\\\\r|\\\\\\\\m|\\\\\\\\s|\\b$(/bin/grep '^ID=' /etc/os-release 2>/dev/null | /bin/cut -d= -f2 | /bin/sed -e 's/\"//g')\\b)\" /etc/issue | /bin/awk '{print} END {if (NR == 0) print \"pass\"; else print \"fail\"}'"
              expect      : "^pass$"

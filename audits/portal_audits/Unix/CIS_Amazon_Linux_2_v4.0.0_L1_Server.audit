              cmd         : "/sbin/sysctl net.ipv6.conf.all.accept_source_route"
              expect      : "(?i)^[\\s]*net.ipv6.conf.all.accept_source_route[\\s]*=[\\s]*0[\\s]*$"
            </custom_item>

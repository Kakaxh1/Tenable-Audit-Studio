          expect      : "^0$"
        </custom_item>
      </condition>

      <then>
        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              type        : CMD_EXEC
              description : "config net.ipv6.conf.all.accept_redirects"
              cmd         : "#!/bin/bash
{
   l_parameter_name=\"net.ipv6.conf.all.accept_redirects\" l_var=\"\" a_sorted=()
   a_searchpath=(\"/run/sysctl.d/\" \"/etc/sysctl.d/\" \"/usr/local/lib/sysctl.d/\" \\
   \"/usr/lib/sysctl.d/\" \"/lib/sysctl.d/\")
   unset A_files;declare -A A_files
   A_files+=([\"sysctl.conf\"]=\"/etc/sysctl.conf\")
   for l_searchpath in \"${a_searchpath[@]}\"; do
      if [ -d \"$l_searchpath\" ]; then
         while IFS= read -r -d $'\\0' l_filename; do
            if [ -f \"$l_filename\" ]; then
               l_basename=\"$(basename \"$l_filename\")\"
               if [ -z \"${A_files[\"$l_basename\"]}\" ]; then
                  A_files+=([\"$l_basename\"]=\"$l_filename\")
               fi
            fi
         done < <(find \"$l_searchpath\" -type f -name '*.conf' -print0)
      fi
   done
   while IFS= read -rd '' l_key; do
      a_sorted+=( \"$l_key\" )
   done < <(printf '%s\\0' \"${!A_files[@]}\" | sort -rz)
   l_var=\"$(grep -PHos -- \"^\\h*$l_parameter_name\\h*=\\h*\\H+\\b\" /etc/sysctl.conf | tail -n 1)\"
   if [ -z \"$l_var\" ]; then
      for l_keyname in \"${a_sorted[@]}\";do
         if grep -Pqs -- \"^\\h*$l_parameter_name\\b\" \"${A_files[\"$l_keyname\"]}\"; then
            l_var=\"$(grep -PHos -- \"^\\h*$l_parameter_name\\h*=\\h*\\H+\\b\" \\
            \"${A_files[\"$l_keyname\"]}\" | tail -n 1)\"
            break
         fi
      done
   fi
   [ -n \"$l_var\" ] && awk -F: '{print \" - \"$2\" is set in: \"$1}' <<< \"$l_var\"
} | /bin/awk 'NR == 1 { if (/net.ipv6.conf.all.accept_redirects\\s*=\\s*0 is set/) { print \"Pass\" } else { print \"Fail\" } } { print }'"
              expect      : "^Pass$"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "/sbin/sysctl net.ipv6.conf.all.accept_redirects"
              cmd         : "/sbin/sysctl net.ipv6.conf.all.accept_redirects"
              expect      : "(?i)^[\\s]*net.ipv6.conf.all.accept_redirects[\\s]*=[\\s]*0[\\s]*$"
            </custom_item>

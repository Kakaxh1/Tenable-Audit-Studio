      <condition type:"AND">
        <custom_item>
          type        : RPM_CHECK
          description : "Check for package at"
          rpm         : "at-0.0.0-0"
          operator    : "gt"
          required    : YES
        </custom_item>
      </condition>

      <then>
        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>

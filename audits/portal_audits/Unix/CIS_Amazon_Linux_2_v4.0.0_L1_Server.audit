      grep -Psi '^\\h*ForwardToSyslog\\h*=\\h*')\"
      [ -n \"$l_out\" ] && printf '%s\\n' \"\" \"File: \\\"$l_file\\\" contains:\" \"$l_out\"
   done
}"

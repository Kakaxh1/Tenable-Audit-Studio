          cmd         : "UID_MIN=$(awk '/^\\s*UID_MIN/{print $2}' /etc/login.defs); [ -n \"${UID_MIN}\" ] && /sbin/auditctl -l | /bin/awk \"(/^ *-a *always,exit/||/^ *-a *exit,always/)  && /-F *auid!=(unset|-1|=4294967295)/  && /-F *auid>=${UID_MIN}/  &&/ -S/  && /[, ]lremovexattr[, ]/\" | /bin/awk '{print} END {if (NR != 0) print \"pass\" ; else print \"fail\"}' || printf \"ERROR: Variable 'UID_MIN' is unset.\\n\""

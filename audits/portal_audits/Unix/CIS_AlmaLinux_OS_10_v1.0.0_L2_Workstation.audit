          cmd         : "/sbin/auditctl -l | /bin/awk '(/^ *-a *always,exit/ || /^ *-a *exit,always/) && / -S/ && /settimeofday/' | /bin/awk '{print} END {if (NR != 0) print \"pass\" ; else print \"fail\"}'"
          expect      : "^pass$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "auditctl clock_settime"
          cmd         : "/sbin/auditctl -l | /bin/awk '(/^ *-a *always,exit/ || /^ *-a *exit,always/) && / -S/ && /clock_settime/' | /bin/awk '{print} END {if (NR != 0) print \"pass\" ; else print \"fail\"}'"
          expect      : "^pass$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC

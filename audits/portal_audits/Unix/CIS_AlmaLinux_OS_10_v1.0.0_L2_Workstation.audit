            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "automount-open is locked"
              cmd         : "/bin/gsettings writable org.gnome.desktop.media-handling automount-open"
              expect      : "^[\\s]*false[\\s]*$"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "automount is disabled"
              cmd         : "/bin/gsettings get org.gnome.desktop.media-handling automount"
              expect      : "^[\\s]*false[\\s]*$"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "automount-open is disabled"

          cmd         : "#!/bin/bash
      {
LOGFILE=$(/bin/grep -rPsi \"^\\h*Defaults\\h+([^#]+,\\h*)?logfile\\h*=\\h*(\\\"|\\')?\\H+(\\\"|\\')?(,\\h*\\H+\\h*)*\\h*(#.*)?$\" /etc/sudoers* | /bin/awk -F= '{gsub(/\"/, \"\", $2); gsub(/\\//, \"\\\\/\", $2); print $2}')
if [ -n \"${LOGFILE}\" ]; then
  /bin/awk \"(/^ *-a *always,exit/ || /^ *-a *exit,always/ || /-w/) && (/perm=wa/ || /-p *wa/) && /(path=)?${LOGFILE}/\" /etc/audit/audit.rules | /bin/awk '{print} END {if (NR>0) print \"pass\"; else print \"fail\";}'
else
  echo \"fail: logfile= is NOT set in /etc/sudoers*\"
fi

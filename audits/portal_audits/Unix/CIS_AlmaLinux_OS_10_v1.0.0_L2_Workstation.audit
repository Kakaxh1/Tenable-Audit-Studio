if [ -n \"${LOGFILE}\" ]; then
  /sbin/auditctl -l | /bin/awk \"(/^ *-a *always,exit/ || /^ *-a *exit,always/ || /-w/) && (/perm=wa/ || /-p *wa/) && /(path=)?${LOGFILE}/\" | /bin/awk '{print} END {if (NR>0) print \"pass\"; else print \"fail\";}'
else
  echo \"fail: logfile= is NOT set in /etc/sudoers*\"
fi
}"

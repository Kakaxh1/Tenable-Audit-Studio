      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/pam.d/common-password"
      regex       : "^[\\s]*password[\\s]+requisite[\\s]+pam_cracklib\\.so[^#\\r\\n]*\\blcredit="

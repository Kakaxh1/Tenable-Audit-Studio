    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "auditctl setuid b32"
          cmd         : "/sbin/auditctl -l | /bin/grep -w 'execve'"
          expect      : "^[\\s]*-a[\\s]+(always,exit|exit,always)[\\s]+-F[\\s]+arch=b32[\\s]+(.*(-S[\\s]+execve[\\s]+|([\\s]+|,)execve([\\s]+|,))).*-C[\\s]+uid!=euid[\\s]+-F[\\s]+euid=0[\\s]*([\\s]+(-k[\\s]+|-F[\\s]+key=)[\\S]+)*[\\s]*$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "auditctl setuid b64"
          cmd         : "/sbin/auditctl -l | /bin/grep -w 'execve'"
          expect      : "^[\\s]*-a[\\s]+(always,exit|exit,always)[\\s]+-F[\\s]+arch=b64[\\s]+(.*(-S[\\s]+execve[\\s]+|([\\s]+|,)execve([\\s]+|,))).*-C[\\s]+uid!=euid[\\s]+-F[\\s]+euid=0[\\s]*([\\s]+(-k[\\s]+|-F[\\s]+key=)[\\S]+)*[\\s]*$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "auditctl setgid b32"
          cmd         : "/sbin/auditctl -l | /bin/grep -w 'execve'"
          expect      : "^[\\s]*-a[\\s]+(always,exit|exit,always)[\\s]+-F[\\s]+arch=b32[\\s]+(.*(-S[\\s]+execve[\\s]+|([\\s]+|,)execve([\\s]+|,))).*-C[\\s]+gid!=egid[\\s]+-F[\\s]+egid=0[\\s]*([\\s]+(-k[\\s]+|-F[\\s]+key=)[\\S]+)*[\\s]*$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "auditctl setgid b64"
          cmd         : "/sbin/auditctl -l | /bin/grep -w 'execve'"
          expect      : "^[\\s]*-a[\\s]+(always,exit|exit,always)[\\s]+-F[\\s]+arch=b64[\\s]+(.*(-S[\\s]+execve[\\s]+|([\\s]+|,)execve([\\s]+|,))).*-C[\\s]+gid!=egid[\\s]+-F[\\s]+egid=0[\\s]*([\\s]+(-k[\\s]+|-F[\\s]+key=)[\\S]+)*[\\s]*$"
        </custom_item>

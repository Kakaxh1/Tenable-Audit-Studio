      expect      : "^[\\s]*password[\\s]*requisite[\\s]*pam_cracklib\\.so[\\s]*"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611035 - SLEM 5 must employ passwords with a minimum of 15 characters."
      info        : "The shorter the password, the lower the number of possible combinations that need to be tested before the password is compromised.

Password complexity, or strength, is a measure of the effectiveness of a password in resisting attempts at guessing and brute-force attacks. Password length is one factor of several that helps determine strength and how long it takes to crack a password. Use of more characters in a password helps exponentially increase the time and/or resources required to compromise the password."
      solution    : "Configure SLEM 5 to enforce a minimum 15-character password length.

Edit \"/etc/pam.d/common-password\" and edit the line containing \"pam_cracklib.so\" to contain the option \"minlen=15\" after the third column.

The DOD standard requires a minimum 15-character password length."
      reference   : "800-171|3.5.7,800-171r3|03.05.07a.,800-53|IA-5(1)(a),800-53r5|IA-5(1)(a),CAT|II,CCI|CCI-000205,CN-L3|7.1.2.7(e),CN-L3|7.1.3.1(b),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(a),NESA|T5.2.3,NIAv2|AM19a,NIAv2|AM19b,NIAv2|AM19c,NIAv2|AM19d,NIAv2|AM22a,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261382r996577_rule,STIG-ID|SLEM-05-611035,SWIFT-CSCv1|4.1,TBA-FIISB|26.2.1,TBA-FIISB|26.2.4,Vuln-ID|V-261382"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/pam.d/common-password"
      regex       : "^[\\s]*password[\\s]*requisite[\\s]*pam_cracklib\\.so[^#\\r\\n]*\\bminlen[\\s]*=[\\s]*"
      expect      : "^[\\s]*password[\\s]*requisite[\\s]*pam_cracklib\\.so[^#\\r\\n]*\\bminlen[\\s]*=[\\s]*@PASSWORD_MINIMUM_LENGTH@\\b"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611040 - SLEM 5 must require the change of at least eight of the total number of characters when passwords are changed."
      info        : "If SLEM 5 allows the user to consecutively reuse extensive portions of passwords, this increases the chances of password compromise by increasing the window of opportunity for attempts at guessing and brute-force attacks."
      solution    : "Configure SLEM 5 to require at least eight characters be changed between the old and new passwords during a password change with the following command:

Edit \"/etc/pam.d/common-password\" and edit the line containing \"pam_cracklib.so\" to contain the option \"difok=8\" after the third column."
      reference   : "800-171|3.5.7,800-171r3|03.05.07b.,800-53|IA-5(1)(b),800-53r5|IA-5(1)(b),CAT|II,CCI|CCI-000195,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(b),NESA|T5.2.3,NIAv2|AM22d,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261383r996580_rule,STIG-ID|SLEM-05-611040,SWIFT-CSCv1|4.1,Vuln-ID|V-261383"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/pam.d/common-password"
      regex       : "^[\\s]*password[\\s]+requisite[\\s]+pam_cracklib\\.so[^#\\r\\n]*\\bdifok="
      expect      : "^[\\s]*password[\\s]+requisite[\\s]+pam_cracklib\\.so[^#\\r\\n]*\\bdifok=@PASSWORD_DIFOK@\\b"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611045 - SLEM 5 must not allow passwords to be reused for a minimum of five generations."
      info        : "Password complexity, or strength, is a measure of the effectiveness of a password in resisting attempts at guessing and brute-force attacks. If the information system or application allows the user to consecutively reuse their password when that password has exceeded its defined lifetime, the end result is a password that is not changed as per policy requirements."
      solution    : "Configure SLEM 5 password history to prohibit the reuse of a password for a minimum of five generations.

Edit \"/etc/pam.d/common-password\" and edit the line containing \"pam_pwhistory.so\" to contain the option \"remember=5 use_authtok\" after the third column."
      reference   : "800-171|3.5.8,800-171r3|03.05.07e.,800-53|IA-5(1)(e),800-53r5|IA-5(1)(e),CAT|II,CCI|CCI-000200,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(e),NESA|T5.2.3,NIAv2|AM22c,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261384r996583_rule,STIG-ID|SLEM-05-611045,SWIFT-CSCv1|4.1,TBA-FIISB|26.2.3,Vuln-ID|V-261384"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/pam.d/common-password"
      regex       : "(?i)^[\\s]*password[\\s]+requisite[\\s]+pam_pwhistory\\.so[^#\\n\\r]*\\bremember[\\s]*=[\\s]*@PASSWORD_HISTORY_REMEMBER@\\b[^#\\n\\r]*\\buse_authtok\\b"
      expect      : "(?i)^[\\s]*password[\\s]+requisite[\\s]+pam_pwhistory\\.so[^#\\n\\r]*\\bremember[\\s]*=[\\s]*@PASSWORD_HISTORY_REMEMBER@\\b[^#\\n\\r]*\\buse_authtok\\b"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611050 - SLEM 5 must configure the Linux Pluggable Authentication Modules (PAM) to only store encrypted representations of passwords."
      info        : "Passwords need to be protected at all times, and encryption is the standard method for protecting passwords. If passwords are not encrypted, they can be plainly read (i.e., clear text) and easily compromised."
      solution    : "Configure SLEM 5 Linux PAM to only store encrypted representations of passwords. All account passwords must be hashed with SHA512 encryption strength.

Edit \"/etc/pam.d/common-password\" and edit the line containing \"pam_unix.so\" to contain the SHA512 keyword after third column. Remove the \"nullok\" option if it exists."
      reference   : "800-171|3.5.10,800-171r3|03.05.07c.,800-53|IA-5(1)(c),800-53r5|IA-5(1)(c),CAT|II,CCI|CCI-000196,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ITSG-33|IA-5(1)(c),NESA|T5.2.3,NIAv2|CY6,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261385r996586_rule,STIG-ID|SLEM-05-611050,SWIFT-CSCv1|4.1,TBA-FIISB|26.1,Vuln-ID|V-261385"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/pam.d/common-password"
      regex       : "^[\\s]*password[\\s]*requisite[\\s]*pam_unix\\.so[^#\\r\\n]*\\bsha512\\b"
      expect      : "^[\\s]*password[\\s]*requisite[\\s]*pam_unix\\.so[^#\\r\\n]*\\bsha512\\b"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK_NOT
      description : "SLEM-05-611055 - SLEM 5 must not be configured to allow blank or null passwords."
      info        : "Passwords need to be protected at all times, and encryption is the standard method for protecting passwords. If passwords are not encrypted, they can be plainly read (i.e., clear text) and easily compromised."
      solution    : "Configure SLEM 5 to not allow blank or null passwords.

Remove any instances of the \"nullok\" option in \"/etc/pam.d/common-auth\" and \"/etc/pam.d/common-password\" to prevent logons with empty passwords."
      reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CAT|I,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,NESA|T3.2.1,Rule-ID|SV-261386r996587_rule,STIG-ID|SLEM-05-611055,SWIFT-CSCv1|2.3,Vuln-ID|V-261386"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/pam.d/*"
      regex       : "^[\\s]*[^#\\n\\r]+pam_unix\\.so[^#\\n\\r]+nullok"
      expect      : "^[\\s]*[^#\\n\\r]+pam_unix\\.so[^#\\n\\r]+nullok"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "SLEM-05-611060 - SLEM 5 must not have accounts configured with blank or null passwords."
      info        : "If an account has an empty password, anyone could log on and run commands with the privileges of that account. Accounts with empty passwords should never be used in operational environments."
      solution    : "Configure all accounts on the system to have a password or lock the account with the following commands:

Perform a password reset:
     > sudo passwd <username>

Lock the account:
     > sudo passwd -l <username>"
      reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CAT|I,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,NESA|T3.2.1,Rule-ID|SV-261387r996588_rule,STIG-ID|SLEM-05-611060,SWIFT-CSCv1|2.3,Vuln-ID|V-261387"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      cmd         : "/bin/awk -F: '!$2 {print $1}' /etc/shadow | /bin/awk '{print} END {if (NR == 0) print \"No accounts have blank or null passwords\"; else print \"Blank or null passwords found on system\"}'"
      expect      : "^No accounts have blank or null passwords$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "SLEM-05-611065 - SLEM 5 must employ user passwords with a minimum lifetime of 24 hours (one day)."
      info        : "Enforcing a minimum password lifetime helps prevent repeated password changes to defeat the password reuse or history enforcement requirement. If users are allowed to immediately and continually change their password, the password could be repeatedly changed in a short period of time to defeat the organization's policy regarding password reuse."
      solution    : "Configure SLEM 5 to enforce 24 hours/one day or greater as the minimum password age for user accounts.

Change the minimum time period between password changes for each <username> account to \"1\" day with the command, replacing <username> with the user account that must be changed:

     > sudo passwd -n 1 <username>"
      reference   : "800-171|3.5.2,800-171r3|03.05.07d.,800-53|IA-5(1)(d),800-53r5|IA-5(1)(d),CAT|II,CCI|CCI-000198,CN-L3|7.1.2.7(e),CN-L3|7.1.3.1(b),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(d),NESA|T5.2.3,NIAv2|AM20,NIAv2|AM21,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261388r1184422_rule,STIG-ID|SLEM-05-611065,SWIFT-CSCv1|4.1,TBA-FIISB|26.2.2,Vuln-ID|V-261388"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      cmd         : "v1=$(/bin/awk '/^UID_MIN/ {print $2}' /etc/login.defs);/bin/awk -v \"uidmin=${v1}\" -F: 'FILENAME == \"/etc/passwd\" { if ($3 >= uidmin && $1 != \"nobody\") users[$1] } FILENAME == \"/etc/shadow\" { if ($1 in users && ($4 < 1)) badusers[$1]; } END { if (length(badusers) > 0){ for (user in badusers) {print user} } else { print \"No users found\" } }' /etc/passwd /etc/shadow"
      expect      : "^No users found$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "SLEM-05-611070 - SLEM 5 must employ user passwords with a maximum lifetime of 60 days."
      info        : "Any password, no matter how complex, can eventually be cracked. Therefore, passwords need to be changed periodically. If SLEM 5 does not limit the lifetime of passwords and force users to change their passwords, there is the risk that SLEM 5 passwords could be compromised."
      solution    : "Configure SLEM 5 to enforce a maximum password age of each <username> account to 60 days. The command in the check text will give a list of users that need to be updated to be in compliance:

     > sudo passwd -x 60 <username>"
      reference   : "800-171|3.5.2,800-171r3|03.05.07d.,800-53|IA-5(1)(d),800-53r5|IA-5(1)(d),CAT|II,CCI|CCI-000199,CN-L3|7.1.2.7(e),CN-L3|7.1.3.1(b),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(d),NESA|T5.2.3,NIAv2|AM20,NIAv2|AM21,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261389r1038967_rule,STIG-ID|SLEM-05-611070,SWIFT-CSCv1|4.1,TBA-FIISB|26.2.2,Vuln-ID|V-261389"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      cmd         : "v1=$(/bin/awk '/^UID_MIN/ {print $2}' /etc/login.defs);/bin/awk -v \"uidmin=${v1}\" -F: 'FILENAME == \"/etc/passwd\" { if ($3 >= uidmin && $1 != \"nobody\") users[$1] } FILENAME == \"/etc/shadow\" { if ($1 in users && ($5 < 1 || $5 > 60)) badusers[$1]; } END { if (length(badusers) > 0){ for (user in badusers) {print user} } else { print \"No users found\" } }' /etc/passwd /etc/shadow"
      expect      : "^No users found$"
    </custom_item>

    <custom_item>
      type        : FILE_CHECK
      description : "SLEM-05-611075 - SLEM 5 must employ a password history file."
      info        : "Password complexity, or strength, is a measure of the effectiveness of a password in resisting attempts at guessing and brute-force attacks. If the information system or application allows the user to consecutively reuse their password when that password has exceeded its defined lifetime, the end result is a password that is not changed as per policy requirements."
      solution    : "Configure SLEM 5 to create the password history file with the following commands:

Create the file:
     > sudo touch /etc/security/opasswd

Set ownership permissions:
     > sudo chown root:root /etc/security/opasswd

Set access permissions:
     > sudo chmod 0600 /etc/security/opasswd"
      reference   : "800-171|3.5.8,800-171r3|03.05.07e.,800-53|IA-5(1)(e),800-53r5|IA-5(1)(e),CAT|II,CCI|CCI-000200,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(e),NESA|T5.2.3,NIAv2|AM22c,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261390r996595_rule,STIG-ID|SLEM-05-611075,SWIFT-CSCv1|4.1,TBA-FIISB|26.2.3,Vuln-ID|V-261390"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/security/opasswd"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "SLEM-05-611080 - SLEM 5 must employ FIPS 140-2/140-3-approved cryptographic hashing algorithms for system authentication."
      info        : "The system must use a strong hashing algorithm to store the password. The system must use a sufficient number of hashing rounds to ensure the required level of entropy.

Passwords need to be protected at all times, and encryption is the standard method for protecting passwords. If passwords are not encrypted, they can be plainly read (i.e., clear text) and easily compromised."
      solution    : "Configure SLEM 5 to encrypt all stored passwords with FIPS 140-2/140-3-approved cryptographic hash.

Add or modify the following line in the \"/etc/login.defs\" file:

ENCRYPT_METHOD SHA512

Lock all interactive user accounts not using SHA512 hashing until the passwords can be regenerated."
      reference   : "800-171|3.5.10,800-171r3|03.05.07c.,800-53|IA-5(1)(c),800-53|IA-7,800-53r5|IA-7,CAT|I,CCI|CCI-000196,CCI|CCI-000803,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ITSG-33|IA-5(1)(c),ITSG-33|IA-7,ITSG-33|IA-7a.,NESA|M5.2.1,NESA|M5.2.6,NESA|M5.3.1,NESA|T5.2.3,NESA|T7.4.1,NIAv2|CY6,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261391r996598_rule,STIG-ID|SLEM-05-611080,SWIFT-CSCv1|4.1,TBA-FIISB|26.1,Vuln-ID|V-261391"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      cmd         : "/usr/bin/cut -d: -f1,2 /etc/shadow | /bin/grep -Pv ':[*!\\$]' | /bin/grep -Pv '^\\$6\\$' | /bin/awk -F: '{print $1} END {if (NR == 0) print \"All interactive user passwords are encrypted\"; else print \"There are interactive user passwords that are not encrypted\"}'"
      expect      : "^All interactive user passwords are encrypted$"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611085 - SLEM 5 shadow password suite must be configured to use a sufficient number of hashing rounds."
      info        : "The system must use a strong hashing algorithm to store the password. The system must use a sufficient number of hashing rounds to ensure the required level of entropy.

Passwords need to be protected at all times, and encryption is the standard method for protecting passwords. If passwords are not encrypted, they can be plainly read (i.e., clear text) and easily compromised."
      solution    : "Configure SLEM 5 shadow password suite to encrypt passwords using sufficient number of hashing rounds.

Add or modify the following line in the \"/etc/login.defs\" file:

SHA_CRYPT_MIN_ROUNDS 100000"
      reference   : "800-171|3.5.10,800-171r3|03.05.07c.,800-53|IA-5(1)(c),800-53|IA-7,800-53r5|IA-7,CAT|I,CCI|CCI-000196,CCI|CCI-000803,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ITSG-33|IA-5(1)(c),ITSG-33|IA-7,ITSG-33|IA-7a.,NESA|M5.2.1,NESA|M5.2.6,NESA|M5.3.1,NESA|T5.2.3,NESA|T7.4.1,NIAv2|CY6,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261392r1184425_rule,STIG-ID|SLEM-05-611085,SWIFT-CSCv1|4.1,TBA-FIISB|26.1,Vuln-ID|V-261392"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/login.defs"
      regex       : "^[\\s]*SHA_CRYPT_(MIN|MAX)_ROUNDS"
      expect      : "^[\\s]*SHA_CRYPT_(MIN|MAX)_ROUNDS[\\s]+@HASHING_ROUNDS@\\b"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611090 - SLEM 5 must employ FIPS 140-2/140-3 approved cryptographic hashing algorithm for system authentication (login.defs)."
      info        : "Unapproved mechanisms that are used for authentication to the cryptographic module are not verified and therefore cannot be relied on to provide confidentiality or integrity, and DOD data may be compromised.

SLEM 5 using encryption are required to use FIPS 140-2/140-3 compliant mechanisms for authenticating to cryptographic modules.

FIPS 140-2/140-3 is the current standard for validating that mechanisms used to access cryptographic modules use authentication that meets DOD requirements. This allows for Security Levels 1, 2, 3, or 4 for use on a general-purpose computing system."
      solution    : "Configure SLEM 5 to require \"ENCRYPT_METHOD\" of \"SHA512\".

Add or modify the following line in the \"/etc/login.defs\" file:

ENCRYPT_METHOD SHA512"
      reference   : "800-53|IA-7,800-53r5|IA-7,CAT|II,CCI|CCI-000803,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(d),ITSG-33|IA-7,ITSG-33|IA-7a.,NESA|M5.2.1,NESA|M5.2.6,NESA|M5.3.1,NESA|T7.4.1,QCSC-v1|13.2,Rule-ID|SV-261393r996602_rule,STIG-ID|SLEM-05-611090,Vuln-ID|V-261393"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/login.defs"
      regex       : "(?i)^[\\s]*ENCRYPT_METHOD"
      expect      : "(?i)^[\\s]*ENCRYPT_METHOD[\\s]+@PASSWORD_ENCRYPTION@[\\s]*$"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611095 - SLEM 5 must be configured to create or update passwords with a minimum lifetime of 24 hours (one day)."
      info        : "Enforcing a minimum password lifetime helps prevent repeated password changes to defeat the password reuse or history enforcement requirement. If users are allowed to immediately and continually change their password, the password could be repeatedly changed in a short period of time to defeat the organization's policy regarding password reuse."
      solution    : "Configure SLEM 5 to enforce 24 hours/one day or greater as the minimum password age.

Add or modify the following line in the \"/etc/login.defs\" file:

PASS_MIN_DAYS <days>

The DOD requirement is \"1\", but a greater value is acceptable."
      reference   : "800-171|3.5.2,800-171r3|03.05.07d.,800-53|IA-5(1)(d),800-53r5|IA-5(1)(d),CAT|II,CCI|CCI-000198,CN-L3|7.1.2.7(e),CN-L3|7.1.3.1(b),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(d),NESA|T5.2.3,NIAv2|AM20,NIAv2|AM21,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261394r996604_rule,STIG-ID|SLEM-05-611095,SWIFT-CSCv1|4.1,TBA-FIISB|26.2.2,Vuln-ID|V-261394"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/login.defs"
      regex       : "^[\\s]*PASS_MIN_DAYS[\\s]+"
      expect      : "^[\\s]*PASS_MIN_DAYS[\\s]+@PASSWORD_MIN_DAYS@[\\s]*$"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "SLEM-05-611100 - SLEM 5 must be configured to create or update passwords with a maximum lifetime of 60 days."
      info        : "Any password, no matter how complex, can eventually be cracked. Therefore, passwords need to be changed periodically. If SLEM 5 does not limit the lifetime of passwords and force users to change their passwords, there is the risk that SLEM 5 passwords could be compromised."
      solution    : "Configure SLEM 5 to enforce a maximum password age of 60 days or less.

Add or modify the following line in the \"/etc/login.defs\" file:

PASS_MAX_DAYS <days>

The DOD requirement is 60 days or less (but greater than zero, as zero days will lock the account immediately)."
      reference   : "800-171|3.5.2,800-171r3|03.05.07d.,800-53|IA-5(1)(d),800-53r5|IA-5(1)(d),CAT|II,CCI|CCI-000199,CN-L3|7.1.2.7(e),CN-L3|7.1.3.1(b),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|SLEM_5_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ISO/IEC-27001|A.9.4.3,ITSG-33|IA-5(1)(d),NESA|T5.2.3,NIAv2|AM20,NIAv2|AM21,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-261395r1038967_rule,STIG-ID|SLEM-05-611100,SWIFT-CSCv1|4.1,TBA-FIISB|26.2.2,Vuln-ID|V-261395"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/login.defs"
      regex       : "^[\\s]*PASS_MAX_DAYS[\\s]+"
      expect      : "^[\\s]*PASS_MAX_DAYS[\\s]+@PASSWORD_MAX_DAYS@[\\s]*$"
    </custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : RPM_CHECK
          description : "pcsc-ccid installed"
          rpm         : "pcsc-ccid-0.0.0-0"
          operator    : "gt"
          required    : YES
        </custom_item>

        <custom_item>
          type        : RPM_CHECK
          description : "opensc installed"
          rpm         : "opensc-0.0.0-0"
          operator    : "gt"
          required    : YES
        </custom_item>

        <custom_item>
          type        : RPM_CHECK
          description : "pcsc-lite installed"
          rpm         : "pcsc-lite-0.0.0-0"
          operator    : "gt"
          required    : YES
        </custom_item>

        <custom_item>
          type        : RPM_CHECK
          description : "coolkey installed"
          rpm         : "coolkey-0.0.0-0"
          operator    : "gt"
          required    : YES
        </custom_item>

        <custom_item>
          type        : RPM_CHECK
          description : "pcsc-tools installed"
          rpm         : "pcsc-tools-0.0.0-0"
          operator    : "gt"
          required    : YES
        </custom_item>

        <custom_item>
          type        : RPM_CHECK

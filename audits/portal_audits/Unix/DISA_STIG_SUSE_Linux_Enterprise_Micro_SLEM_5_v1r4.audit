      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_SLEM_5_V1R4_STIG.zip"
      file        : "/etc/audit/audisp-remote.conf"
      regex       : "(?i)^[\\s]*network_failure_action"
      expect      : "(?i)^[\\s]*network_failure_action[\\s]*=[\\s]*(syslog|single|halt)[\\s]*$"
    </custom_item>


    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "HostKeyAlgorithms"
          file            : "/etc/ssh/ssh_config /etc/ssh/ssh_config.d/*.conf"
          regex           : "^[\\s]*HostKeyAlgorithms ecdsa-sha2-nistp256-cert-v01@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp256,sk-ecdsa-sha2-nistp256@openssh.com[\\s]*$"
          expect          : "^[\\s]*HostKeyAlgorithms ecdsa-sha2-nistp256-cert-v01@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp256,sk-ecdsa-sha2-nistp256@openssh.com[\\s]*$"
          required        : NO
          min_occurrences : "1"
        </custom_item>

        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "MACs"
          file            : "/etc/ssh/ssh_config /etc/ssh/ssh_config.d/*.conf"
          regex           : "^[\\s]*MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-256[\\s]*$"
          expect          : "^[\\s]*MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-256[\\s]*$"
          required        : NO
          min_occurrences : "1"
        </custom_item>

        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "KexAlgorithms"
          file            : "/etc/ssh/ssh_config /etc/ssh/ssh_config.d/*.conf"
          regex           : "^[\\s]*KexAlgorithms ecdh-sha2-nistp256[\\s]*$"
          expect          : "^[\\s]*KexAlgorithms ecdh-sha2-nistp256[\\s]*$"

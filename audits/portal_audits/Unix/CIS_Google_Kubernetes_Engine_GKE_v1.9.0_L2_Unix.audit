              see_also    : "https://workbench.cisecurity.org/benchmarks/24112"
              cmd         : "@KUBECTL_PATH@/kubectl get all --kubeconfig @KUBECONFIG@"
              expect      : "^Manual Review Required$"
              severity    : MEDIUM
            </custom_item>
          </then>


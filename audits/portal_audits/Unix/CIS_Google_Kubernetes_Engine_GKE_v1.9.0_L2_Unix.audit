#<ui_metadata>
#<display_name>CIS Google Kubernetes Engine GKE v1.9.0 L2 Unix</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Google Kubernetes Engine GKE</name>
#  <profile>L2</profile>

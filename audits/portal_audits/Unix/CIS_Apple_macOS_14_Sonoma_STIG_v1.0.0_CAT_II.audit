#    <name>MINIMUM_COMPLEX_CHAR</name>
#    <default>1</default>
#    <description>Minimum Complex Characters</description>
#    <info>Miminum complex characters length enforced by configuration profile.</info>
#    <value_type>STRING</value_type>

    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "PermitEmptyPasswords"
          cmd         : "/sbin/sshd -dd 2>&1 | /bin/awk '/filename/ {print $4}' | /bin/tr -d '\\r' | /bin/tr '\\n' ' ' | /bin/xargs /bin/grep -iH '^\\s*permitemptypasswords'"
          expect      : "(?i)PermitEmptyPasswords[\\s]+\"?no\"?[\\s]*$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "PermitUserEnvironment"
          cmd         : "/sbin/sshd -dd 2>&1 | /bin/awk '/filename/ {print $4}' | /bin/tr -d '\\r' | /bin/tr '\\n' ' ' | /bin/xargs /bin/grep -iH '^\\s*permituserenvironment'"
          expect      : "(?i)PermitUserEnvironment[\\s]+\"?no\"?[\\s]*$"
        </custom_item>

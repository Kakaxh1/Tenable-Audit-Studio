      see_also    : "https://workbench.cisecurity.org/benchmarks/22168"
      cmd         : "/sbin/sshd -dd 2>&1 | /bin/awk '/filename/ {print $4}' | /bin/tr -d '\\r' | /bin/tr '\\n' ' ' | /bin/xargs /bin/grep -iH '^\\s*x11forwarding'"
      expect      : "(?i)X11Forwarding[\\s]+\"?no\"?[\\s]*$"
    </custom_item>

    <if>
      <condition type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "GDM is installed"
          cmd         : "/bin/dpkg -s gdm gdm3 lightdm kdm | /bin/grep Status: 2>&1"

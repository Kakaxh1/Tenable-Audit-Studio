    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "Existence: The 'logging' configuration block must be defined."
          cmd         : "/usr/bin/grep -q '^\\s*logging\\s*{' @NAMED_CONF@ && /usr/bin/echo 'LOGGING_BLOCK_FOUND' || /usr/bin/echo 'FAIL'"
          expect      : "LOGGING_BLOCK_FOUND"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "Existence: The logging block must contain at least one 'channel' definition."
          cmd         : "/usr/bin/awk '/^\\s*logging\\s*{/ { f=1 } f && /^\\s*channel\\s+/ { print \"CHANNEL_FOUND\"; exit } /^\\s*};/ { f=0 }' @NAMED_CONF@ | /usr/bin/grep -q \"CHANNEL_FOUND\" && /usr/bin/echo \"PASS\" || /usr/bin/echo \"FAIL\""
          expect      : "PASS"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "Existence: The logging block must contain at least one 'category' definition."
          cmd         : "/usr/bin/awk '/^logging\\s*{/ { f=1 } f && /^\\s*category\\s+/ { print \"CATEGORY_FOUND\"; exit } /^};/ { f=0 }' @NAMED_CONF@ | /usr/bin/grep -q \"CATEGORY_FOUND\" && /usr/bin/echo \"PASS\" || /usr/bin/echo \"FAIL\""
          expect      : "PASS"
        </custom_item>

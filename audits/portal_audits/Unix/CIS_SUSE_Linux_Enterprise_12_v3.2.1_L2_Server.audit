          required        : NO
          min_occurrences : "1"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "auditctl - /etc/sudoers.d"
          cmd         : "/sbin/auditctl -l | /bin/grep -P -s -- \"^\\s*-w\\s+/etc/sudoers.d/?\\s+-p\\s+wa\\s+-k\\s+\\S+ *$\" | /bin/awk '{print} END {if (NR > 0 ) print \"pass\"; else print \"fail\"}'"
          expect      : "^pass$"
        </custom_item>

        <custom_item>

              expect          : "^[\\s]*-a always,exit -F arch=b64 (-S\\s+adjtimex\\s+-S\\s+settimeofday|-S\\s+settimeofday\\s+-S\\s+adjtimex) -k \\S+"
              required        : NO
              min_occurrences : "1"
            </custom_item>


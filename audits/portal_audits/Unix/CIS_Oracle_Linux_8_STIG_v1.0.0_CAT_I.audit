          see_also    : "https://workbench.cisecurity.org/benchmarks/23791"
          file        : "/boot/efi/EFI/redhat/user.cfg"
          regex       : "^[\\s]*GRUB2_PASSWORD[\\s]*="
          expect      : "^[\\s]*GRUB2_PASSWORD[\\s]*=[\\s]*grub\\.pbkdf2\\.sha512\\.[A-Za-z0-9\\.]+[\\s]*$"
        </custom_item>
      </then>

      <else>
        <report type:"PASSED">
          description : "1.17 OL08-00-010140"
          info        : "OL 8 operating systems booted with United Extensible Firmware Interface (UEFI) must require authentication upon booting into single-user mode and maintenance.

GROUP ID: V-248537

          see_also    : "https://workbench.cisecurity.org/benchmarks/23791"
          file        : "/etc/security/faillock.conf"
          regex       : "^[\\s]*deny[\\s]*=[\\s]*"
          expect      : "^[\\s]*deny[\\s]*=[\\s]*@PASSWORD_LOCKOUT_DENY@[\\s]*$"
        </custom_item>
      </then>


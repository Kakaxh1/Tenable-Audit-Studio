          expect      : "^[\\s]*-a[\\s]+(always,exit|exit,always)[\\s]+-F[\\s]+arch=b64[\\s]+-S[\\s]+execve[\\s]+-C[\\s]+gid!=egid[\\s]+(([\\s]+-k[\\s]+|-F[\\s]+key=)[\\S]+[\\s]*)?$"

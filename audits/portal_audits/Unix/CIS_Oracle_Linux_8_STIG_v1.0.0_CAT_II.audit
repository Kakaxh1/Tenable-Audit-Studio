          see_also    : "https://workbench.cisecurity.org/benchmarks/23791"
          cmd         : "/bin/gsettings get org.gnome.desktop.screensaver lock-enabled"
          expect      : "^[\\s]*true[\\s]*$"
        </custom_item>

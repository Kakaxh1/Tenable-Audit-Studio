      <condition type:"AND">
        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "Oracle 8.0 or 8.1 is installed"
          file        : "/etc/oracle-release"
          regex       : ".*[\\s]+release[\\s]+8\\.[01]([\\s].*)?$"
          expect      : ".*[\\s]+release[\\s]+8\\.[01]([\\s].*)?$"

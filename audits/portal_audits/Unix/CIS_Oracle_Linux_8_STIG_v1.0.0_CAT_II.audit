      see_also    : "https://workbench.cisecurity.org/benchmarks/23791"
      file        : "/etc/systemd/system.conf"
      regex       : "(?i)^[\\s]*CtrlAltDelBurstAction[\\s]*="
      expect      : "(?i)^[\\s]*CtrlAltDelBurstAction[\\s]*=[\\s]*none[\\s]*$"
    </custom_item>


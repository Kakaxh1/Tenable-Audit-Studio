      see_also    : "https://workbench.cisecurity.org/benchmarks/23791"
      file        : "/etc/audit/audit.rules"
      regex       : "^[\\s]*-a[\\s]+(always,exit|exit,always)[\\s]+-F[\\s]+path=/usr/bin/crontab[\\s]+(-F[\\s]+perm=([rwa]*x[rwa]*)[\\s]+)?-F[\\s]+auid>=1000[\\s]+-F[\\s]+auid!=(4294967295|-1|unset)([\\s]+(-k[\\s]+|-F[\\s]+key=)[-\\w]+)*[\\s]*$"

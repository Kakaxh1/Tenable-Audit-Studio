          see_also    : "https://workbench.cisecurity.org/benchmarks/23791"
          file        : "/etc/pam.d/system-auth"
          regex       : "^[\\s]*password[\\s]+(required|requisite)[\\s]+pam_pwquality\\.so[^#\\n\\r]+retry=@PASSWORD_RETRY@[^#\\n\\r]*$"
          expect      : "^[\\s]*password[\\s]+(required|requisite)[\\s]+pam_pwquality\\.so[^#\\n\\r]+retry=@PASSWORD_RETRY@[^#\\n\\r]*$"

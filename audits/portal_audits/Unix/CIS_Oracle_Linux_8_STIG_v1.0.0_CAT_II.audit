        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "Oracle 8.2+ is installed"
          file        : "/etc/oracle-release"
          regex       : ".*[\\s]+release[\\s]+8\\.([2-9]|[1-9][0-9])([\\s].*)?$"
          expect      : ".*[\\s]+release[\\s]+8\\.([2-9]|[1-9][0-9])([\\s].*)?$"

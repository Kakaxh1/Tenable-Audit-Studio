      see_also    : "https://workbench.cisecurity.org/benchmarks/26403"
      cmd         : "/bin/openssl x509 -text -in /etc/sssd/pki/sssd_auth_ca_db.pem | /bin/grep -Ei '^\\s*(issuer|subject|not before|not after)'"
      expect      : "^Manual Review Required$"
      severity    : MEDIUM
    </custom_item>


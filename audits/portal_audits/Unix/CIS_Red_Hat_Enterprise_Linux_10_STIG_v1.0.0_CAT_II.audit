      see_also    : "https://workbench.cisecurity.org/benchmarks/26403"
      cmd         : "log_file=$(/bin/grep '^log_file' /etc/audit/auditd.conf 2>/dev/null | /bin/awk '{print $3}' | head -1); if [ -z \"$log_file\" ]; then log_file='/var/log/audit/audit.log'; fi; log_group=$(/bin/grep -P '^[ ]*log_group[ ]+=.*$' /etc/audit/auditd.conf 2>/dev/null | /bin/awk '{print $3}' | head -1); if [ -z \"$log_group\" ]; then log_group='root'; fi; if [ -f \"$log_file\" ]; then actual_group=$(stat -c '%G' \"$log_file\" 2>/dev/null); if [ \"$actual_group\" = \"$log_group\" ] || [ \"$actual_group\" = 'root' ]; then echo 'PASS - All files group owned by root or restricted logging group'; else echo \"FAIL: audit log file $log_file is owned by group $actual_group, expected $log_group or root\"; fi; else echo \"FAIL: audit log file $log_file does not exist\"; fi"
      expect      : "^PASS - All files group owned by root or restricted logging group$"
    </custom_item>


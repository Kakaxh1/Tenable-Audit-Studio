      see_also        : "https://workbench.cisecurity.org/benchmarks/26403"
      file            : "/etc/security/pwquality.conf /etc/security/pwquality.conf/*.conf"
      regex           : "^[\\s]*@PASSWORD_COMPLEXITY_ENFORCEMENT@[\\s]*$"
      expect          : "^[\\s]*@PASSWORD_COMPLEXITY_ENFORCEMENT@[\\s]*$"
      file_required   : NO
      min_occurrences : "1"
      string_required : NO
    </custom_item>


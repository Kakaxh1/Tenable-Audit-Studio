          description : "Verify that all system device files are correctly labeled"
          cmd         : "/bin/find /dev -context *:device_t:* \\( -type c -o -type b \\) \\( -not -wholename \"/dev/vsock\" -not -wholename \"/dev/vmci\" \\) -printf \"%p %Z\\n\" | /bin/awk '{print} END {if (NR == 0) print \"No results found\"'}"
          expect      : "^No results found$"
        </custom_item>

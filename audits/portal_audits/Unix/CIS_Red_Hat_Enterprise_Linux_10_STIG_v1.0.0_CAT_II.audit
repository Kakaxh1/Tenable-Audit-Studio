      cmd         : "v1=$(/bin/awk '/^UID_MIN/ {print $2}' /etc/login.defs);/bin/awk -v \"uidmin=${v1}\" -F: 'FILENAME == \"/etc/passwd\" { if ($3 >= uidmin && $1 != \"nfsnobody\" && $1 != \"nobody\") users[$1] } FILENAME == \"/etc/shadow\" { if ($1 in users && ($5 < 1 || $5 > 60)) badusers[$1]; } END { if (length(badusers) > 0){ for (user in badusers) {print user} } else { print \"No users found\" } }' /etc/passwd /etc/shadow"

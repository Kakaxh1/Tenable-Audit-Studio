          expect      : "^pass$"
        </custom_item>

        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "ExecStart set with rescue"
          file            : "/usr/lib/systemd/system/rescue.service /etc/systemd/system/rescue.service.d/*.conf"
          regex           : "^[\\s]*ExecStart=-"
          expect          : "^[\\s]*ExecStart=-/usr/lib/systemd/systemd-sulogin-shell[\\s]+rescue[\\s]*$"
          required        : NO
          min_occurrences : "1"
        </custom_item>

          see_also    : "https://workbench.cisecurity.org/benchmarks/26403"
          cmd         : "/bin/gsettings writable org.gnome.login-screen disable-restart-buttons"
          expect      : "^[\\s]*false[\\s]*$"
        </custom_item>

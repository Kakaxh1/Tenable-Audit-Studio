          description : "Check for host USB capabilities"
          cmd         : "/sbin/lshw | /bin/grep -i '\\-usb' | /bin/awk '{print} END {if (NR > 0) print \"pass\"; else print \"fail\"}'"
          expect      : "^pass$"
        </custom_item>
      </condition>

      <then>

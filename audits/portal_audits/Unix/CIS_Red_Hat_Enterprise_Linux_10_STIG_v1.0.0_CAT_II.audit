      see_also    : "https://workbench.cisecurity.org/benchmarks/26403"
      file        : "/etc/audit/auditd.conf"
      regex       : "(?i)^[\\s]*name_format[\\s]*=[\\s]*"
      expect      : "(?i)^[\\s]*name_format[\\s]*=[\\s]*(hostname|fqd|numeric)[\\s]*$"
    </custom_item>


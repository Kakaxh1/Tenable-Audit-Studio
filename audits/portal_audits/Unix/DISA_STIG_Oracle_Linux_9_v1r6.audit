          required    : YES
        </custom_item>
      </condition>

      <then>
        <custom_item>
          type        : CMD_EXEC
          description : "OL09-00-002100 - OL 9 must disable the graphical user interface automount function unless required."
          info        : "Automatically mounting file systems permits easy introduction of unknown devices, thereby facilitating malicious activity.

Satisfies: SRG-OS-000114-GPOS-00059, SRG-OS-000378-GPOS-00163"
          solution    : "Configure the GNOME desktop to disable automated mounting of removable media.

The dconf settings can be edited in the /etc/dconf/db/* location.

Update the [org/gnome/desktop/media-handling] section of the \"/etc/dconf/db/local.d/00-security-settings\" database file and add or update the following lines:

[org/gnome/desktop/media-handling]
automount-open=false

Update the dconf system databases:

$ sudo dconf update"
          reference   : "800-171r3|03.05.02,800-53|IA-3,800-53r5|IA-3,CAT|II,CCI|CCI-000778,CCI|CCI-001958,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|Oracle_Linux_9_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ITSG-33|IA-3,ITSG-33|IA-3a.,NESA|T5.4.3,QCSC-v1|13.2,Rule-ID|SV-271670r1091722_rule,STIG-ID|OL09-00-002100,TBA-FIISB|27.1,Vuln-ID|V-271670"
          see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Oracle_Linux_9_V1R6_STIG.zip"
          cmd         : "/bin/gsettings get org.gnome.desktop.media-handling automount-open"
          expect      : "^[\\s]*false[\\s]*$"
        </custom_item>
      </then>

      <else>
        <report type:"PASSED">
          description : "OL09-00-002100 - OL 9 must disable the graphical user interface automount function unless required."
          info        : "Automatically mounting file systems permits easy introduction of unknown devices, thereby facilitating malicious activity.

Satisfies: SRG-OS-000114-GPOS-00059, SRG-OS-000378-GPOS-00163"
          solution    : "Configure the GNOME desktop to disable automated mounting of removable media.

The dconf settings can be edited in the /etc/dconf/db/* location.

Update the [org/gnome/desktop/media-handling] section of the \"/etc/dconf/db/local.d/00-security-settings\" database file and add or update the following lines:

[org/gnome/desktop/media-handling]
automount-open=false

Update the dconf system databases:

$ sudo dconf update"
          reference   : "800-171r3|03.05.02,800-53|IA-3,800-53r5|IA-3,CAT|II,CCI|CCI-000778,CCI|CCI-001958,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|Oracle_Linux_9_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ITSG-33|IA-3,ITSG-33|IA-3a.,NESA|T5.4.3,QCSC-v1|13.2,Rule-ID|SV-271670r1091722_rule,STIG-ID|OL09-00-002100,TBA-FIISB|27.1,Vuln-ID|V-271670"

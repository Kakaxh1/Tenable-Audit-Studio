      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Oracle_Linux_9_V1R6_STIG.zip"
      cmd         : "/sbin/sshd -T | /bin/grep -i KerberosAuthentication"
      expect      : "(?i)[\\s]*KerberosAuthentication[\\s]+\"?no\"?[\\s]*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "OL09-00-002357 - OL 9 must not allow a noncertificate trusted host SSH logon to the system."

      <then>
        <custom_item>
          type        : CMD_EXEC
          description : "OL09-00-002162 - OL 9 effective dconf policy must match the policy keyfiles."
          info        : "Unlike text-based keyfiles, the binary database is impossible to check through most automated and all manual means; therefore, to evaluate dconf configuration, both have to be true at the same time - configuration files have to be compliant, and the database needs to be more recent than those keyfiles, which gives confidence that it reflects them."
          solution    : "Update the dconf databases by running the following command:

$ sudo dconf update"
          reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CAT|II,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,DISA_Benchmark|Oracle_Linux_9_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,NESA|T3.2.1,Rule-ID|SV-271692r1091788_rule,STIG-ID|OL09-00-002162,SWIFT-CSCv1|2.3,Vuln-ID|V-271692"
          see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Oracle_Linux_9_V1R6_STIG.zip"
          cmd         : "function dconf_needs_update { for db in $(/bin/find /etc/dconf/db -maxdepth 1 -type f); do db_mtime=$(/bin/stat -c %Y \"$db\"); keyfile_mtime=$(/bin/stat -c %Y \"$db\".d/* | /bin/sort -n | tail -1); if [ -n \"$db_mtime\" ] && [ -n \"$keyfile_mtime\" ] && [ \"$db_mtime\" -lt \"$keyfile_mtime\" ]; then echo \"$db needs update\"; return 1; fi; done; }; dconf_needs_update | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
          expect      : "^pass$"
        </custom_item>
      </then>


    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "OL09-00-002348 - OL 9 SSH daemon must not allow rhosts authentication."
      info        : "SSH trust relationships mean a compromise on one host can allow an attacker to move trivially to other hosts."

      cmd         : "/sbin/sysctl net.ipv4.conf.default.accept_source_route"
      expect      : "^[\\s]*net\\.ipv4\\.conf\\.default\\.accept_source_route[\\s]*=[\\s]*0[\\s]*$"
    </custom_item>


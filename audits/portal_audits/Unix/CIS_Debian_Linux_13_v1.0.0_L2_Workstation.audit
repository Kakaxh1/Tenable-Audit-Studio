              expect      : "^pass$"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC
              description : "is-enabled"
              cmd         : "/bin/systemctl is-enabled autofs.service 2>/dev/null | /bin/grep 'enabled' | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"

#<ui_metadata>
#<display_name>CIS Amazon Linux 2023 STIG v1.0.0 CAT I</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Amazon Linux 2023 STIG</name>
#  <profile>CAT I</profile>
#  <version>1.0.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/26107</link>
#</spec>
#<labels>agent,amazon_linux_2023</labels>

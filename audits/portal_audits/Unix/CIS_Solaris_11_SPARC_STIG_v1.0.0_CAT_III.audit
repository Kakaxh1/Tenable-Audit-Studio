          see_also    : "https://workbench.cisecurity.org/benchmarks/23765"
          cmd         : "/usr/bin/echo $(for user in $(/usr/bin/cut -d: -f1 /etc/passwd | /usr/xpg4/bin/grep -E -v '^root'); do echo \"$user: $(userattr -v audit_flags $user 2>&1)\"; done | awk '/user_attr/ { print; f++} END { if (!f) print \"pass\" }')"

          see_also    : "https://workbench.cisecurity.org/benchmarks/22008"
          cmd         : "/bin/gsettings get org.gnome.settings-daemon.peripherals.smartcard removal-action"
          expect      : "^[\\s]*'lock-screen'[\\s]*$"
        </custom_item>
      </then>


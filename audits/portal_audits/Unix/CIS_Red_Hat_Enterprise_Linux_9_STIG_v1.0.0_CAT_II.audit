    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "systemd-sysctl"
          cmd         : "/usr/lib/systemd/systemd-sysctl --cat-config | /bin/grep -Ev '^(#|;)' | /bin/grep -F fs.protected_symlinks | /bin/tail -1"
          expect      : "^[\\s]*fs\\.protected_symlinks[\\s]*=[\\s]*1[\\s]*$"

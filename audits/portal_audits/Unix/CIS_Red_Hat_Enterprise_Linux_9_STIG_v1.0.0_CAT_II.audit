        <custom_item>
          type        : CMD_EXEC
          description : "sysctl"
          cmd         : "/sbin/sysctl kernel.perf_event_paranoid"
          expect      : "^[\\s]*kernel\\.perf_event_paranoid[\\s]*=[\\s]*2[\\s]*$"

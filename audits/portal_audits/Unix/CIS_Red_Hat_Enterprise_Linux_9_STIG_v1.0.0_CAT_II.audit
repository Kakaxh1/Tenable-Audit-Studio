      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : BANNER_CHECK
          description : "Ensure banner content is set correctly"
          file        : "@SSH_BANNER_FILE@"
          content     : "@BANNER_TEXT@"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "/etc/ssh/sshd_config"
          cmd         : "/sbin/sshd -T | /bin/grep -i Banner"
          expect      : "(?i)[\\s]*Banner[\\s]+\"?@SSH_BANNER_FILE@\"?"
        </custom_item>
      </condition>


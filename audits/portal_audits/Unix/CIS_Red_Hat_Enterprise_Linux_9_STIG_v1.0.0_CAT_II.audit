          see_also    : "https://workbench.cisecurity.org/benchmarks/22008"
          cmd         : "/bin/gsettings get org.gnome.desktop.screensaver lock-enabled"
          expect      : "^[\\s]*true[\\s]*$"
        </custom_item>

          see_also    : "https://workbench.cisecurity.org/benchmarks/22008"
          file        : "/etc/postfix/main.cf"
          regex       : "^[\\s]*smtpd_client_restrictions[\\s]*="
          expect      : "^[\\s]*smtpd_client_restrictions[\\s]*=[\\s]*permit_mynetworks,[\\s]*reject[\\s]*$"

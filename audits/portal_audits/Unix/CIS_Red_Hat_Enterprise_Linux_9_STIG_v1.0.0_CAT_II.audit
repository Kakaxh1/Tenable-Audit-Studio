      see_also    : "https://workbench.cisecurity.org/benchmarks/22008"
      file        : "/etc/pam.d/password-auth"
      regex       : "^[\\s]*password[^#\\n\\r]+pam_unix\\.so[^#\\n\\r]+"
      expect      : "^[\\s]*password[^#\\n\\r]+pam_unix\\.so[^#\\n\\r]+rounds=@HASHING_ROUNDS@"
    </custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "tipc /bin/false"
          file            : "/etc/modprobe.d/* /etc/modprobe.conf"

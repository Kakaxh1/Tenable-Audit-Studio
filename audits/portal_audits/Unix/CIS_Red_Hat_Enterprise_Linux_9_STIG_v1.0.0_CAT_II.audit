    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "update-crypto-policies"
          cmd         : "/bin/update-crypto-policies --show"
          expect      : "^[\\s]*@FIPS_POLICY@[\\s]*$"
        </custom_item>

        <custom_item>
          type          : FILE_CONTENT_CHECK_NOT
          description   : "no AD-SUPPORT"
          file          : "/etc/crypto-policies/policies/modules/REQUIRE.pmod"
          regex         : "AD-SUPPORT"
          expect        : "AD-SUPPORT"
          file_required : NO
        </custom_item>

        <custom_item>
          type          : FILE_CONTENT_CHECK_NOT
          description   : "NO-ENFORCE-EMS"
          file          : "/etc/crypto-policies/policies/modules/REQUIRE.pmod"
          regex         : "NO-ENFORCE-EMS"
          expect        : "NO-ENFORCE-EMS"
          file_required : NO
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHA2-256"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA2-256"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHA2-384"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA2-384"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHA2-512"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA2-512"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHA2-224"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA2-224"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHA3-256"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA3-256"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHA3-384"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA3-384"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHA3-512"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA3-512"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "hash SHAKE-256"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHAKE-256"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "min rsa size"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*min_rsa_size[\\s]*=[\\s]*"
          expect      : "^(?i)[\\s]*min_rsa_size[\\s]*=[\\s]*(204[89]|20[5-9][0-9]|2[1-9][0-9][0-9]|[3-9][0-9][0-9][0-9]|[0-9]{5,})[\\s]*$"
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK_NOT
          description : "no hash SHA1"
          file        : "/etc/crypto-policies/state/CURRENT.pol"
          regex       : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA1"
          expect      : "^(?i)[\\s]*hash[\\s]*=[\\s]*[^#\\n\\r]+SHA1"

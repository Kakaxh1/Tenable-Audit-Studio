          description : "sysctl"
          cmd         : "/sbin/sysctl kernel.unprivileged_bpf_disabled"
          expect      : "^[\\s]*kernel\\.unprivileged_bpf_disabled[\\s]*=[\\s]*1[\\s]*$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "sysctl config files"
          cmd         : "/usr/lib/systemd/systemd-sysctl --cat-config | /bin/grep -Ev '^(#|;)' | /bin/grep -F kernel.unprivileged_bpf_disabled | /bin/tail -1"
          expect      : "^[\\s]*kernel\\.unprivileged_bpf_disabled[\\s]*=[\\s]*1[\\s]*$"

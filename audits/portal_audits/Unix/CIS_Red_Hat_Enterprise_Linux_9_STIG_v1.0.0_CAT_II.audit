      see_also    : "https://workbench.cisecurity.org/benchmarks/22008"
      cmd         : "/sbin/sshd -T | /bin/grep -i X11Forwarding"
      expect      : "(?i)[\\s]*X11Forwarding[\\s]+\"?no[\"?\\s]*$"

      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "Check that the current GRUB 2 configuration enabled"
          cmd         : "(/sbin/grubby --info=ALL | /bin/grep args | /bin/grep -v 'audit=1') 2>&1 | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"

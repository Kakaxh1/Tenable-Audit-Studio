      cmd         : "/sbin/sshd -dd 2>&1 | /bin/awk '/filename/ {print $4}' | /bin/tr -d '\\r' | /bin/tr '\\n' ' ' | /bin/xargs /bin/grep -iH '^\\s*LogLevel'"
      expect      : "(?i)[\\s]*LogLevel[\\s]+\"?VERBOSE\"?[\\s]*$"
    </custom_item>


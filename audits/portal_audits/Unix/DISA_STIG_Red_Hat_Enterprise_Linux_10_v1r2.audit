      regex           : "sysadm_r"
      expect          : "^[\\s]*%?@DESIGNATED_ACCT@[\\s]+ALL=\\(ALL\\)[\\s]+TYPE=sysadm_t[\\s]+ROLE=sysadm_r[\\s]+ALL[\\s]*$"

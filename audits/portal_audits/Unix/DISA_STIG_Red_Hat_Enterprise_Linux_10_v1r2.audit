          expect          : "^[\\s]*Defaults[\\s]+!runaspw"
          file_required   : NO
          min_occurrences : "1"
          string_required : NO
        </custom_item>

        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "targetpw"
          file            : "/etc/sudoers /etc/sudoers.d/*"
          regex           : "^[^#\\n\\r]+!targetpw"
          expect          : "^[\\s]*Defaults[\\s]+!targetpw"
          file_required   : NO
          min_occurrences : "1"
          string_required : NO
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "RHEL-10-600550 - RHEL 10 must use the invoking user's password for privilege escalation when using \"sudo\"."
          info        : "If the \"rootpw\", \"targetpw\", or \"runaspw\" flags are defined and not disabled, by default the operating system will prompt the invoking user for the \"root\" user password."
          solution    : "Configure RHEL 10 to use the invoking user's password for privilege escalation when using \"sudo\".

Define the following in the Defaults section of the /etc/sudoers file or a single configuration file in the /etc/sudoers.d/ directory:

Defaults !targetpw
Defaults !rootpw
Defaults !runaspw"
          reference   : "800-171r3|03.05.01b.,800-53|IA-11,800-53r5|IA-11,CAT|II,CCI|CCI-002038,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|RHEL_10_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(d),QCSC-v1|13.2,Rule-ID|SV-281210r1166582_rule,STIG-ID|RHEL-10-600550,Vuln-ID|V-281210"
          see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_RHEL_10_V1R2_STIG.zip"
          show_output : YES
        </report>
      </then>
    </if>

    <custom_item>
      type        : FILE_CONTENT_CHECK_NOT
      description : "RHEL-10-600560 - RHEL 10 must require users to provide a password for privilege escalation."
      info        : "Without reauthentication, users may access resources or perform tasks for which they do not have authorization.

When operating systems provide the capability to escalate a functional capability, it is critical that the user reauthenticate.

Satisfies: SRG-OS-000373-GPOS-00156, SRG-OS-000373-GPOS-00157, SRG-OS-000373-GPOS-00158"
      solution    : "Configure RHEL 10 to not allow users to execute privileged actions without authenticating with a password.

Remove any occurrence of \"NOPASSWD\" found in the \"/etc/sudoers\" file or files in the \"/etc/sudoers.d\" directory:

$ sudo find /etc/sudoers /etc/sudoers.d -type f -exec sed -i '/NOPASSWD/ s/^/# /g' {} \\;"
      reference   : "800-171r3|03.05.01b.,800-53|IA-11,800-53r5|IA-11,CAT|I,CCI|CCI-002038,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,DISA_Benchmark|RHEL_10_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(d),QCSC-v1|13.2,Rule-ID|SV-281211r1166585_rule,STIG-ID|RHEL-10-600560,Vuln-ID|V-281211"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_RHEL_10_V1R2_STIG.zip"

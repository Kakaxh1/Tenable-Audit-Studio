          expect      : "^[\\s]*-a[\\s]+(?:always,exit|exit,always)(?:[\\s]+-S[\\s]+all)?[\\s]+-F[\\s]+arch=b32[\\s]+-S[\\s]+mount[\\s]+(?:-F[\\s]+perm=[rwa]*x[rwa]*[\\s]+)?-F[\\s]+auid>=1000[\\s]+-F[\\s]+auid!=(?:4294967295|-1|unset)(?:[\\s]+(?:-k[\\s]+|-F[\\s]+key=)[\\S]+)*[\\s]*$"

        <custom_item>
          type        : CMD_EXEC
          description : "Check that the current GRUB 2 configuration has page poisoning enabled"
          cmd         : "(/sbin/grubby --info=ALL | /bin/grep args | /bin/grep -v 'init_on_free=1') 2>&1 | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
          expect      : "^pass$"

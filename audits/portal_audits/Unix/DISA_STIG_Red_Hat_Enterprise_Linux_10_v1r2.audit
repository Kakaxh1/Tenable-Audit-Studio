      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "single instance ExecStart"
          cmd         : "/bin/grep -E -s \"^[\\s]*ExecStart=-\" /usr/lib/systemd/system/emergency.service /etc/systemd/system/emergency.service.d/*.conf 2>&1 | /bin/awk '{print} END {if (NR == 1) print \"pass\"; else print \"fail\"}'"

      cmd         : "/bin/awk '/^[^#]+=/ { split($0, p, \"=\"); gsub(/ /, \"\", p[1]); gsub(/ /, \"\", p[2]); r[p[1]] = p[2]; } /^[^#=!@]/ && !/=/ { x=$2; for (v in r) { c = sprintf(\"(^|+| )%s(+| |$)\", v); gsub(c, r[v], x); } if ($0) { if (x !~ /xattrs/) { print $0\" (\"x\")\"; f++ } } } END { if (f) { print \"fail\" } else { print \"pass\" } }' @AIDE_CONF@"

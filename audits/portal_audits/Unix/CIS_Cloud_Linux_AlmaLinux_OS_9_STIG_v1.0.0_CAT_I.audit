# description : This .audit is designed against the CIS Cloud Linux AlmaLinux OS 9 STIG Benchmark v1.0.0
#
#<ui_metadata>
#<display_name>CIS Cloud Linux AlmaLinux OS 9 STIG v1.0.0 CAT I</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Cloud Linux AlmaLinux OS 9 STIG</name>
#  <profile>CAT I</profile>
#  <version>1.0.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/27039</link>
#</spec>
#<labels>agent,alma_linux_9,cis</labels>
#<benchmark_refs>800-53,800-53r5,CCI,LEVEL,Rule-ID,STIG-ID,Vuln-ID</benchmark_refs>
#<variables>
#  <variable>
#    <name>PLATFORM_VERSION</name>
#    <default>9</default>
#    <description>Linux Distribution Version</description>
#    <info>Linux Distribution Version</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>SSH_INCLUDE_CRYPTO</name>
#    <default>/etc/ssh/sshd_config.d/50-redhat.conf</default>
#    <description>Unix file for SSH crypto includes</description>
#    <info>Unix file that includes the /etc/crypto-policies/back-ends/opensshserver.config</info>
#    <value_type>UNIX_FILE_PATH</value_type>
#  </variable>
#  <variable>
#    <name>HASHING_ROUNDS</name>
#    <default>[1-9][0-9]{5,}</default>
#    <description>Password encryption hashing round</description>
#    <info>Password encryption hashing rounds found in /etc/login.defs</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>PASSWORD_ENCRYPTION</name>
#    <default>SHA512</default>
#    <description>Password encryption method</description>
#    <info>Password encryption method found in /etc/login.defs</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>FIPS_POLICY</name>
#    <default>FIPS</default>
#    <description>FIPS Crypto Policy and submodule</description>
#    <info>Valid values include FIPS, FIPS:AD-SUPPORT, FIPS:NO-ENFORCE-EMS</info>
#    <value_type>STRING</value_type>
#  </variable>
#</variables>
#</ui_metadata>

<check_type:"Unix">

<if>
  <condition type:"AND">
    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "check AlmaLinux release"
      file        : "/etc/system-release"
      regex       : "^[\\s]*AlmaLinux release"
      expect      : "^[\\s]*AlmaLinux release @PLATFORM_VERSION@"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "CIS_Cloud_Linux_AlmaLinux_OS_9_STIG_v1.0.0_CAT_I.audit from CIS Cloud Linux AlmaLinux OS 9 STIG v1.0.0"
      see_also    : "https://workbench.cisecurity.org/benchmarks/27039"
      show_output : YES
    </report>

    <if>
      <condition type:"AND">
        <custom_item>
          type        : RPM_CHECK
          description : "Check GDM installed"
          rpm         : "gdm-0.0.0-0"
          operator    : "gt"
          required    : YES
        </custom_item>
      </condition>

      <then>
        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "1.113 ALMA-09-015420"
          info        : "AlmaLinux OS 9 must not allow unattended or automatic logon via the graphical user interface.

GROUP ID: V-269216
RULE ID: SV-269216r1050098

Failure to restrict system access to authenticated users negatively impacts operating system security."
          solution    : "Configure the GNOME desktop display manager to disable automatic login.

Set AutomaticLoginEnable to false in the [daemon] section in /etc/gdm/custom.conf. For example:

[daemon]
AutomaticLoginEnable=false"
          reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,LEVEL|1A,NESA|T3.2.1,Rule-ID|SV-269216r1050098_rule,STIG-ID|ALMA-09-015420,SWIFT-CSCv1|2.3,Vuln-ID|V-269216"
          see_also    : "https://workbench.cisecurity.org/benchmarks/27039"
          file        : "/etc/gdm/custom.conf"
          regex       : "^[\\s]*(?i)AutomaticLoginEnable[\\s]*=[\\s]*"
          expect      : "^[\\s]*(?i)AutomaticLoginEnable[\\s]*=[\\s]*false[\\s]*$"
        </custom_item>
      </then>

      <else>
        <report type:"PASSED">
          description : "1.113 ALMA-09-015420"
          info        : "AlmaLinux OS 9 must not allow unattended or automatic logon via the graphical user interface.

GROUP ID: V-269216
RULE ID: SV-269216r1050098

Failure to restrict system access to authenticated users negatively impacts operating system security."
          solution    : "Configure the GNOME desktop display manager to disable automatic login.

Set AutomaticLoginEnable to false in the [daemon] section in /etc/gdm/custom.conf. For example:

[daemon]
AutomaticLoginEnable=false"
          reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,LEVEL|1A,NESA|T3.2.1,Rule-ID|SV-269216r1050098_rule,STIG-ID|ALMA-09-015420,SWIFT-CSCv1|2.3,Vuln-ID|V-269216"
          see_also    : "https://workbench.cisecurity.org/benchmarks/27039"
        </report>
      </else>
    </if>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "1.12 ALMA-09-002990"
      info        : "AlmaLinux OS 9 SSH client must be configured to use only encryption ciphers employing FIPS 140-3-validated cryptographic hash algorithms to protect the confidentiality of SSH client connections.

GROUP ID: V-269113
RULE ID: SV-269113r1184081

Without cryptographic integrity protections, information can be altered by unauthorized users without detection.

Remote access (e.g., RDP) is access to DOD nonpublic information systems by an authorized user (or an information system) communicating through an external, nonorganization-controlled network. Remote access methods include, for example, dial-up, broadband, and wireless.

Cryptographic mechanisms used for protecting the integrity of information include, for example, signed hash functions using asymmetric cryptography enabling distribution of the public key to verify the hash information while maintaining the confidentiality of the secret key used to generate the hash.

AlmaLinux OS 9 incorporates systemwide crypto policies by default. Configuration files in /etc/ssh/ have no effect on the ciphers, MACs, or algorithms used by the operating system. The employed ssh client algorithms can be viewed in the /etc/crypto-policies/back-ends/openssh.config file."
      solution    : "Configure the AlmaLinux OS 9 SSH client to use only ciphers employing FIPS 140-3-approved algorithms.

Reinstall crypto-policies with the following command:

$ sudo dnf -y reinstall crypto-policies

Set the crypto-policy to FIPS with the following command:

$ sudo update-crypto-policies --set FIPS

Setting system policy to FIPS"
      reference   : "800-171|3.1.13,800-171r3|03.13.08,800-53|AC-17(2),800-53r5|AC-17(2),CCI|CCI-001453,CN-L3|7.1.2.7(g),CN-L3|7.1.3.1(d),CN-L3|8.1.4.1(c),CSF|PR.AC-3,CSF|PR.PT-4,CSF2.0|PR.AA-05,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.14,ISO-27001-2022|A.6.7,ISO/IEC-27001|A.6.2.2,ITSG-33|AC-17(2),LEVEL|1A,NESA|T5.4.2,NIAv2|AM37,PCI-DSSv3.2.1|2.3,PCI-DSSv4.0|2.2.7,QCSC-v1|3.2,QCSC-v1|5.2.1,QCSC-v1|5.2.2,Rule-ID|SV-269113r1184081_rule,STIG-ID|ALMA-09-002990,SWIFT-CSCv1|2.6,Vuln-ID|V-269113"
      see_also    : "https://workbench.cisecurity.org/benchmarks/27039"
      file        : "/etc/crypto-policies/back-ends/openssh.config"
      regex       : "(?i)^[\\s]*Ciphers[\\s]+"
      expect      : "(?i)^[\\s]*Ciphers[\\s]+\"?(aes256-gcm@openssh.com,?[\\s]*|aes128-gcm@openssh.com,?[\\s]*|aes256-ctr,?[\\s]*|aes128-ctr,?[\\s]*){4}\"?$"
    </custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "Include /etc/ssh/sshd_config.d/*.conf"
          file            : "/etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf"
          regex           : "^(?i)[\\s]*Include[\\s]+/etc/ssh/sshd_config\\.d/\\*\\.conf[\\s]*$"
          expect          : "^(?i)[\\s]*Include[\\s]+/etc/ssh/sshd_config\\.d/\\*\\.conf[\\s]*$"
          required        : NO
          min_occurrences : "1"
        </custom_item>

        <custom_item>
          type            : FILE_CONTENT_CHECK
          description     : "Include /etc/crypto-policies/back-ends/opensshserver.config"
          file            : "@SSH_INCLUDE_CRYPTO@"
          regex           : "^(?i)[\\s]*Include[\\s]+/etc/crypto-policies/back-ends/opensshserver\\.config[\\s]*$"
          expect          : "^(?i)[\\s]*Include[\\s]+/etc/crypto-policies/back-ends/opensshserver\\.config[\\s]*$"
          required        : NO
          min_occurrences : "1"
        </custom_item>

        <custom_item>
          type        : FILE_CHECK
          description : "50-redhat.conf required"
          file        : "@SSH_INCLUDE_CRYPTO@"
          required    : YES
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "1.13 ALMA-09-003100"
          info        : "AlmaLinux OS 9 must implement DOD-approved encryption ciphers to protect the confidentiality of SSH connections.

GROUP ID: V-283675
RULE ID: SV-283675r1193286

Without cryptographic integrity protections, information can be altered by unauthorized users without detection.

Remote access (e.g., RDP) is access to DOD nonpublic information systems by an authorized user (or an information system) communicating through an external, nonorganization-controlled network. Remote access methods include, for example, dial-up, broadband, and wireless.

Cryptographic mechanisms used for protecting the integrity of information include, for example, signed hash functions using asymmetric cryptography enabling distribution of the public key to verify the hash information while maintaining the confidentiality of the secret key used to generate the hash.

AlmaLinux OS 9 incorporates systemwide crypto policies by default. The SSH configuration file has no effect on the ciphers, MACs, or algorithms unless specifically defined in the /etc/sysconfig/sshd file. The employed algorithms can be viewed in the /etc/crypto-policies/back-ends/opensshserver.config file."
          solution    : "Configure the AlmaLinux OS 9 SSH daemon to use systemwide crypto policies by running the following commands:

$ sudo dnf reinstall openssh-server"
          reference   : "800-171|3.1.13,800-171r3|03.13.08,800-53|AC-17(2),800-53r5|AC-17(2),CCI|CCI-001453,CN-L3|7.1.2.7(g),CN-L3|7.1.3.1(d),CN-L3|8.1.4.1(c),CSF|PR.AC-3,CSF|PR.PT-4,CSF2.0|PR.AA-05,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.14,ISO-27001-2022|A.6.7,ISO/IEC-27001|A.6.2.2,ITSG-33|AC-17(2),LEVEL|1A,NESA|T5.4.2,NIAv2|AM37,PCI-DSSv3.2.1|2.3,PCI-DSSv4.0|2.2.7,QCSC-v1|3.2,QCSC-v1|5.2.1,QCSC-v1|5.2.2,Rule-ID|SV-283675r1193286_rule,STIG-ID|ALMA-09-003100,SWIFT-CSCv1|2.6,Vuln-ID|V-283675"
          see_also    : "https://workbench.cisecurity.org/benchmarks/27039"
          show_output : YES
        </report>
      </then>
    </if>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "1.14 ALMA-09-003210"
      info        : "AlmaLinux OS 9 SSH client must be configured to use only Message Authentication Codes (MACs) employing FIPS 140-3-validated cryptographic hash algorithms.

GROUP ID: V-269115
RULE ID: SV-269115r1184083

Without cryptographic integrity protections, information can be altered by unauthorized users without detection.

Remote access (e.g. RDP) is access to DOD nonpublic information systems by an authorized user (or an information system) communicating through an external, nonorganization-controlled network. Remote access methods include, for example, dial-up, broadband, and wireless.

Cryptographic mechanisms used for protecting the integrity of information include, for example, signed hash functions using asymmetric cryptography enabling distribution of the public key to verify the hash information while maintaining the confidentiality of the secret key used to generate the hash.

AlmaLinux OS 9 incorporates systemwide crypto policies by default. The /etc/ssh/ssh_config file has no effect on the ciphers, MACs, or algorithms. The employed algorithms can be viewed in the /etc/crypto-policies/back-ends/openssh.config file."
      solution    : "Configure the SSH client to use only MACs employing FIPS 140-3-approved algorithms.

Reinstall crypto-policies with the following command:

$ sudo dnf -y reinstall crypto-policies

Set the crypto-policy to FIPS with the following command:

$ sudo update-crypto-policies --set FIPS

Setting system policy to FIPS"
      reference   : "800-171|3.1.13,800-171r3|03.13.08,800-53|AC-17(2),800-53r5|AC-17(2),CCI|CCI-001453,CN-L3|7.1.2.7(g),CN-L3|7.1.3.1(d),CN-L3|8.1.4.1(c),CSF|PR.AC-3,CSF|PR.PT-4,CSF2.0|PR.AA-05,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.14,ISO-27001-2022|A.6.7,ISO/IEC-27001|A.6.2.2,ITSG-33|AC-17(2),LEVEL|1A,NESA|T5.4.2,NIAv2|AM37,PCI-DSSv3.2.1|2.3,PCI-DSSv4.0|2.2.7,QCSC-v1|3.2,QCSC-v1|5.2.1,QCSC-v1|5.2.2,Rule-ID|SV-269115r1184083_rule,STIG-ID|ALMA-09-003210,SWIFT-CSCv1|2.6,Vuln-ID|V-269115"
      see_also    : "https://workbench.cisecurity.org/benchmarks/27039"
      file        : "/etc/crypto-policies/back-ends/openssh.config"
      regex       : "(?i)^[\\s]*MACs[\\s]+"
      expect      : "(?i)^[\\s]*MACs[\\s]+\"?(hmac-sha2-256-etm@openssh.com,?[\\s]*|hmac-sha2-512-etm@openssh.com,?[\\s]*|hmac-sha2-256,?[\\s]*|hmac-sha2-512,?[\\s]*){4}\"?$"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "1.15 ALMA-09-003320"
      info        : "The AlmaLinux 9 SSH server must be configured to use only DOD-approved encryption ciphers employing FIPS 140-3-validated cryptographic hash algorithms to protect the confidentiality of SSH server connections.


#  <variable>
#    <name>MAX_LOG_FILES</name>
#    <default>20</default>
#    <description>Maximum number of log files</description>
#    <info>The maximum number of files to use for log output rotation.</info>
#    <value_type>INTEGER</value_type>
#  </variable>
#  <variable>
#    <name>MAX_LOG_FILE_SIZE</name>
#    <default>40</default>
#    <description>Maximum size of each log file</description>
#    <info>The maximum size (in MB) for a single log file.</info>
#    <value_type>INTEGER</value_type>
#  </variable>
#  <variable>
#    <name>AUDIT_VERSION</name>
#    <default>1.0</default>
#    <description>WebSphere Liberty Server Audit Version</description>
#    <info>The web apps configuration which enables auditing for WebSphere applications.</info>
#    <value_type>SAFE_STRING</value_type>
#  </variable>
#  <variable>
#    <name>KEY_STORE_ID</name>
#    <default>auditEncKeyStore</default>
#    <description>WebSphere Liberty Server Encryption Keystore ID</description>
#    <info>The Keystore ID of the audit file handlers encryption key</info>

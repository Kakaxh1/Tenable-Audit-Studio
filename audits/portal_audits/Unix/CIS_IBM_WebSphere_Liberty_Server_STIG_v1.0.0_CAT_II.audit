          see_also    : "https://workbench.cisecurity.org/benchmarks/23823"
          cmd         : "/bin/grep -Pzo '(?s)<reader-role>(.*?)</reader-role>' @APP_Config_catalogs@/configDropins/defaults/*.xml @APP_Config_files@ @APP_Config_catalogs@/configDropins/overrides/*.xml"
          expect      : "^Manual Review Required$"
          severity    : MEDIUM
        </custom_item>
      </then>


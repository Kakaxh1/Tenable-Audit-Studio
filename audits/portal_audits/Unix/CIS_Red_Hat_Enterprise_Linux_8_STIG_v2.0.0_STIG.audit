          see_also    : "https://workbench.cisecurity.org/benchmarks/19886"
          cmd         : "/bin/systemctl status usbguard.service"
          expect      : "^[\\s]*Active:[\\s]*active[\\s]*\\(running\\)"
        </custom_item>
      </then>


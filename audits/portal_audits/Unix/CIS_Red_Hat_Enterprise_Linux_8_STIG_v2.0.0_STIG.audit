      see_also        : "https://workbench.cisecurity.org/benchmarks/19886"
      file            : "/etc/security/pwquality.conf /etc/security/pwquality.conf*/*"
      regex           : "^[\\s]*minlen[\\s]*=[\\s]*"
      expect          : "^[\\s]*minlen[\\s]*=[\\s]*@PASSWORD_MINIMUM_LENGTH@[\\s]*$"
      file_required   : NO

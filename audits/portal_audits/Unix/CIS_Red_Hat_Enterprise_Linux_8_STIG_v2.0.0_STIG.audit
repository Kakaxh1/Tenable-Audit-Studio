          see_also    : "https://workbench.cisecurity.org/benchmarks/19886"
          file        : "/etc/pam.d/system-auth"
          regex       : "^[^#\\n\\r]*pam_pwquality.so[\\s]+[^#\\n\\r]*retry[\\s]*=[\\s]*@PAM_RETRY_VALUE@([\\s]*|$)"
          expect      : "^[^#\\n\\r]*pam_pwquality.so[\\s]+[^#\\n\\r]*retry[\\s]*=[\\s]*@PAM_RETRY_VALUE@([\\s]*|$)"
        </custom_item>

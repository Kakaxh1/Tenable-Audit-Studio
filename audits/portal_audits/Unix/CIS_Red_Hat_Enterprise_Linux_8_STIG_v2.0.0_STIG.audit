      cmd         : "/bin/awk -F: '{if ($3 >= 1000 && $7 !~ \"nologin\") print $1}' /etc/passwd | /bin/xargs -I {} /bin/bash -c '/bin/echo Username: {}; /bin/echo \"=========\"; /bin/chage -l {} | /bin/grep -i \"account expires\"; /bin/echo '''"
      expect      : "^Manual Review Required$"

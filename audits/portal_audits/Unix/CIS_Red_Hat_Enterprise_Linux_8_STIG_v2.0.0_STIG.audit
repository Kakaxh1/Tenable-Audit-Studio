        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              type        : FILE_CONTENT_CHECK
              description : "password-auth"
              file        : "/etc/pam.d/password-auth"
              regex       : "^[\\s]*auth[\\s]+(required|requisite)[\\s]+pam_faillock\\.so[\\s]+preauth[^#\\n\\r]+fail_interval=@PAM_FAIL_INTERVAL@\\b"
              expect      : "^[\\s]*auth[\\s]+(required|requisite)[\\s]+pam_faillock\\.so[\\s]+preauth[^#\\n\\r]+fail_interval=@PAM_FAIL_INTERVAL@\\b"
            </custom_item>

            <custom_item>
              type        : FILE_CONTENT_CHECK
              description : "system-auth"
              file        : "/etc/pam.d/system-auth"
              regex       : "^[\\s]*auth[\\s]+(required|requisite)[\\s]+pam_faillock\\.so[\\s]+preauth[^#\\n\\r]+fail_interval=@PAM_FAIL_INTERVAL@\\b"
              expect      : "^[\\s]*auth[\\s]+(required|requisite)[\\s]+pam_faillock\\.so[\\s]+preauth[^#\\n\\r]+fail_interval=@PAM_FAIL_INTERVAL@\\b"
            </custom_item>
          </condition>


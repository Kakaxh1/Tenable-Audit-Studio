          expect      : "^[\\s]*auth[\\s]+(required|requisite)[\\s]+pam_faillock\\.so[\\s]+preauth[^#\\n\\r]+deny=@PASSWORD_LOCKOUT_DENY@[^#\\n\\r]*$"
        </custom_item>
      </then>


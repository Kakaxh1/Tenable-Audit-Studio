      <condition auto:"WARNING" type:"AND">
        <custom_item>
          type        : CMD_EXEC
          description : "tmux shell"
          cmd         : "/bin/grep -r tmux /etc/bashrc /etc/profile.d"
          expect      : "^Manual Review Required$"
          severity    : MEDIUM
        </custom_item>

        <custom_item>
          type        : PROCESS_CHECK

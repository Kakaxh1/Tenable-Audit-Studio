    <if>
      <condition type:"AND">
        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "Red Hat <= 8.3 is installed"
          file        : "/etc/redhat-release"
          regex       : ".*[\\s]+release[\\s]+8\\.[0-3][\\s]+.*$"
          expect      : ".*[\\s]+release[\\s]+8\\.[0-3][\\s]+.*$"
        </custom_item>

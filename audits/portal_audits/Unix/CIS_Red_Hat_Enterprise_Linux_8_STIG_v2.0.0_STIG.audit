      cmd         : "home_dirs=`/bin/awk -F: '($3>=1000)&&($7 !~ /nologin/)&&($1 !~ /nobody/){print $6}' /etc/passwd | /bin/sort -u`; for dirs in $home_dirs; do g=$(/bin/stat -c %G $dirs); o=$(/bin/stat -c %U $dirs); p=$(/bin/id -gn $o); if [ $p != $g ]; then echo \"${dirs} group-owned by ${g} (should be owned by ${p})\"; fi; done | /bin/awk '{print} END {if (NR <= 0) print \"All local interactive user home directories have correct group ownership\"}'"

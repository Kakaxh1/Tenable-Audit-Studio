          file        : "/etc/pam.d/password-auth"
          regex       : "(?i)^\\h*password\\h+(requisite|required)\\h+pam_pwquality\\.so\\b"
          expect      : "(?i)^\\h*password\\h+(requisite|required)\\h+pam_pwquality\\.so\\b"

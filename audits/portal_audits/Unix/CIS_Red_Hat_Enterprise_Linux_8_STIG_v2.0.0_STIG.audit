      see_also    : "https://workbench.cisecurity.org/benchmarks/19886"
      file        : "/etc/audit/audit.rules"
      regex       : "^[\\s]*-w[\\s]+@FAILLOCK_AUDIT_LOG_FILE@([\\s]+-p[\\s]*([rx]*w[rx]*a[rx]*|[rx]*a[rx]*w[rx]*))?([\\s]+(-k[\\s]+|-F[\\s]+key=)\\w+)?[\\s]*$"
      expect      : "^[\\s]*-w[\\s]+@FAILLOCK_AUDIT_LOG_FILE@([\\s]+-p[\\s]*([rx]*w[rx]*a[rx]*|[rx]*a[rx]*w[rx]*))?([\\s]+(-k[\\s]+|-F[\\s]+key=)\\w+)?[\\s]*$"

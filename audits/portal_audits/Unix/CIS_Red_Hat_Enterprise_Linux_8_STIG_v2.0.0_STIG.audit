    <if>
      <condition auto:"WARNING" type:"AND">
        <item>
          description : "world writable files"
          name        : "find_world_writeable_files"
        </item>

        <custom_item>
          type        : FIND_CMD
          description : "/home initialization files"
          not_expect  : ".+"
          exec        : "/bin/ls -ld '{}' \\;"
          find_name   : ".*"
          find_type   : "f"

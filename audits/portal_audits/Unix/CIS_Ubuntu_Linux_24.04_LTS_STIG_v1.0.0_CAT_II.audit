              file        : "/etc/sysctl.conf /etc/sysctl.d/*"
              regex       : "^[\\s]*kernel\\.randomize_va_space[\\s]*=[\\s]*[^2][\\s]*$"
              expect      : "^[\\s]*kernel\\.randomize_va_space[\\s]*=[\\s]*[^2][\\s]*$"
            </custom_item>

            <custom_item>

          expect      : "^[\\s]*-a[\\s]+(?:always,exit|exit,always)[\\s]+-F[\\s]+arch=b64[\\s]+(?:-S[\\s]+[\\S]+[\\s]+)*-S[\\s]+[\\S]*\\bopenat\\b[\\S]*[\\s]+(?:-S[\\s]+[\\S]+[\\s]+)*-F[\\s]+exit=-EPERM[\\s]+-F[\\s]+auid>=1000[\\s]+-F[\\s]+auid!=(?:4294967295|-1|unset)(?:[\\s]+(?:-k[\\s]+|-F[\\s]+key=)[-\\w]+)*[\\s]*$"
        </custom_item>


      expect      : "^\\s*-w\\s+/var/log/faillog(?:\\s+-p\\s+(?:[rx]*w[rx]*a[rx]*|[rx]*a[rx]*w[rx]*))?(?:\\s+(?:-k\\s+|-F\\s+key=)\\S+)*\\s*$"

$ sudo sysctl --system"
              reference   : "800-53|SI-16,800-53r5|SI-16,CAT|II,CCI|CCI-002824,CSCv7|8.3,CSCv8|10.5,CSF2.0|PR.DS-10,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|SI-16,LEVEL|2A,Rule-ID|SV-270772r1066805_rule,STIG-ID|UBTU-24-700310,Vuln-ID|V-270772"
              see_also    : "https://workbench.cisecurity.org/benchmarks/22775"
              show_output : YES
            </report>
          </then>
        </if>

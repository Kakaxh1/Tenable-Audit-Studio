              cmd         : "/bin/gsettings get org.gnome.desktop.session idle-delay"
              expect      : "^uint32[\\s]+(?:[1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)$"
            </custom_item>

            <custom_item>
              type        : CMD_EXEC

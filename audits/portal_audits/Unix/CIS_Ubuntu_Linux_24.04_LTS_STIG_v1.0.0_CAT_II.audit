          cmd         : "/sbin/auditctl -l | /bin/grep -E 'open|truncate|creat'"
          expect      : "^[\\s]*-a[\\s]+(?:always,exit|exit,always)[\\s]+-F[\\s]+arch=b32[\\s]+(?:-S[\\s]+[\\S]+[\\s]+)*-S[\\s]+[\\S]*\\bopen_by_handle_at\\b[\\S]*[\\s]+(?:-S[\\s]+[\\S]+[\\s]+)*-F[\\s]+exit=-EACCES[\\s]+-F[\\s]+auid>=1000[\\s]+-F[\\s]+auid!=(?:4294967295|-1|unset)(?:[\\s]+(?:-k[\\s]+|-F[\\s]+key=)[-\\w]+)*[\\s]*$"

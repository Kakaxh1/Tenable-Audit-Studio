      expect          : "(?i)^[\\s]*KexAlgorithms[\\s]+\"?ecdh-sha2-nistp521,[\\s]*ecdh-sha2-nistp384,[\\s]*ecdh-sha2-nistp256,[\\s]*diffie-hellman-group-exchange-sha256,[\\s]*diffie-hellman-group16-sha512,[\\s]*diffie-hellman-group14-sha256\"?[\\s]*$"

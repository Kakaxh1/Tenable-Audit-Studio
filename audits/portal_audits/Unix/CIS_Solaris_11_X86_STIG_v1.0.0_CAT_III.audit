              file        : "/etc/gdm/Init/Default"
              regex       : "(?i)^[\\s]*/usr/bin/zenity[\\s]+"
              expect      : "(?i)^[\\s]*/usr/bin/zenity[\\s]+--text-info[\\s]+--width=800[\\s]+--height=300[\\s]+--title=\"Security Message\"[\\s]+--filename=/etc/issue[\\s]*$"
            </custom_item>


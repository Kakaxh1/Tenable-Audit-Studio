                  cmd         : "/usr/bin/pfexec /usr/sbin/auditconfig -t -getflags | /usr/xpg4/bin/grep -E '^active[\\s]*' | /usr/bin/sed s/\'active user default audit flags =\'// | /usr/xpg4/bin/grep -E '[\\s]*-ps,?' | /usr/bin/awk \'{ print } END { if (NR != 0) print \"pass\" }\'"
                  expect      : "^pass$"
                </custom_item>


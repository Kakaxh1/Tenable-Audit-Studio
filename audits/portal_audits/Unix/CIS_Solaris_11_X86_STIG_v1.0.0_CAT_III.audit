          see_also    : "https://workbench.cisecurity.org/benchmarks/23873"
          cmd         : "/usr/sbin/zfs list -o name,mountpoint,encryption"
          expect      : "^Manual Review Required$"
          severity    : MEDIUM
        </custom_item>
      </then>

      <else>
        <report type:"PASSED">

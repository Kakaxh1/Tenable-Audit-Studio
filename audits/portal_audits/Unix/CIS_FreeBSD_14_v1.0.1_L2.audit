      see_also    : "https://workbench.cisecurity.org/benchmarks/19044"
      cmd         : "/usr/sbin/sysrc auditd_enable | /usr/bin/awk -F: '{gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", $2); if ($2 == \"YES\") print \"PASS\"; else print \"FAIL: auditd_enable is set to \" $2}'"

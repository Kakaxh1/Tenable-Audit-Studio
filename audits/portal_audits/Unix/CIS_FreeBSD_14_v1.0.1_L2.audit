      cmd         : "#!/bin/sh

  {
  [ -f /etc/security/audit_control ] && /usr/bin/find \"$(/usr/bin/awk -F \":\" '/^dir/ {print $2}' /etc/security/audit_control | /usr/bin/xargs)\" -type f \\( ! -perm 600 -a ! -perm 0400 -a ! -perm 0200 -a ! -perm 0000 -a ! -perm 0640 -a ! -perm 0440 -a ! -perm 0040 \\) -exec /usr/bin/stat -Lf \"%N %Lp\" {} +

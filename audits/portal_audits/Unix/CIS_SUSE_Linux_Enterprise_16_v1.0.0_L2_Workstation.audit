  /bin/awk \"(/^ *-a *always,exit/ || /^ *-a *exit,always/ || /-w/) && (/perm=wa/ || /-p *wa/) && /(path=)?${LOGFILE}/\" /etc/audit/audit.rules | /bin/awk '{print} END {if (NR>0) print \"pass\"; else print \"fail\";}'

          expect      : "^pass$"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "rules.d /etc/issue"
          cmd         : "/bin/awk '(/^ *-a *always,exit/||/^ *-a *exit,always/ || /-w/) && /(path=)?\\/etc\\/issue / && (/perm=wa/ || /-p wa/)' /etc/audit/audit.rules | /bin/awk '{print} END {if (NR != 0) print \"pass\" ; else print \"fail\"}'"
          expect      : "^pass$"

      see_also    : "https://workbench.cisecurity.org/benchmarks/26236"
      file        : "/proc/self/mountinfo"
      regex       : "[\\s]+/var/log[\\s]+"
      expect      : "[\\s]+/var/log[\\s]+"
    </custom_item>

    <custom_item>
      type        : FILE_CONTENT_CHECK

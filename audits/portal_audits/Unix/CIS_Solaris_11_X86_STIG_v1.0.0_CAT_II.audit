      </condition>

      <then>
        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              system      : "SunOS"
              type        : FILE_CHECK_NOT
              description : "/etc/cron.d/cron.deny"
              file        : "/etc/cron.d/cron.deny"
            </custom_item>

            <custom_item>
              system      : "SunOS"
              type        : FILE_CHECK_NOT
              description : "/etc/cron.d/at.deny"
              file        : "/etc/cron.d/at.deny"
            </custom_item>

            <custom_item>
              system      : "SunOS"
              type        : FILE_CHECK_NOT
              description : "/etc/cron.d/cron.allow file"
              file        : "/etc/cron.d/cron.allow"
            </custom_item>

            <custom_item>
              system      : "SunOS"
              type        : FILE_CHECK_NOT
              description : "/etc/cron.d/at.allow file"

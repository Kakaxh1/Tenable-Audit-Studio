          regex       : "(?i)^[\\s]*umask[\\s]*="
          expect      : "(?i)^[\\s]*umask[\\s]*=[\\s]*077[\\s]*$"
        </custom_item>

        <custom_item>
          system      : "SunOS"
          type        : CMD_EXEC
          description : "check individual user umask"
          cmd         : "ul=$(/usr/bin/logins -u | /usr/bin/cut -f1 -d' '); uc=$(/usr/bin/echo \"$ul\" | /usr/bin/wc -l); sc=0; for user in $ul; do homedir=$(/usr/bin/getent passwd \"$user\" | /usr/bin/cut -d: -f6); if [ -z \"$homedir\" ] || [ ! -d \"$homedir\" ]; then echo \"No home directory found for user: $user\"; continue; fi; if /usr/xpg4/bin/grep -lE \"umask[[:space:]]+077\" \"$homedir\"/.* 2>/dev/null | /usr/bin/grep -q '.'; then /usr/bin/echo \"$user has correct umask\"; sc=$((sc + 1)); else /usr/bin/echo \"$user does NOT have correct umask\"; fi; done; if [ \"$sc\" -eq \"$uc\" ] && [ \"$uc\" -gt 0 ]; then /usr/bin/echo \"pass\"; else /usr/bin/echo \"fail\"; fi"
          expect      : "^pass$"
        </custom_item>
      </condition>


        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              system      : "SunOS"
              type        : FILE_CONTENT_CHECK
              description : "*timeout"
              file        : "/usr/share/X11/app-defaults/XScreenSaver"
              regex       : "(?i)^[\\s]*\\*timeout[\\s]*:"
              expect      : "(?i)^[\\s]*\\*timeout[\\s]*:[\\s]*0:((0[0-9]|1[0-4]):[0-5][0-9]|15:00)[\\s]*$"
            </custom_item>

            <custom_item>
              system      : "SunOS"
              type        : FILE_CONTENT_CHECK
              description : "*lockTimeout"
              file        : "/usr/share/X11/app-defaults/XScreenSaver"
              regex       : "(?i)^[\\s]*\\*lockTimeout[\\s]*:"
              expect      : "(?i)^[\\s]*\\*lockTimeout[\\s]*:[\\s]*0:00:0[1-5][\\s]*$"
            </custom_item>

            <custom_item>
              system      : "SunOS"
              type        : CMD_EXEC
              description : "user lock"
              cmd         : "#!/bin/sh

STIG_VALUE=True
FIELD=lock
FAIL=0

/usr/bin/logins -u -o -x | /usr/bin/awk -F: '{print $6}' | while read -r HOMEDIR; do

    XS_FILE=\"$HOMEDIR/.xscreensaver\"

    if [ ! -r \"$XS_FILE\" ]; then
        /usr/bin/echo \"FAIL: $HOMEDIR (File not found or not readable)\"
        FAIL=1
        continue
    fi

    if ! LINE=$(/usr/xpg4/bin/grep -E \"$FIELD[:space:]*:\" \"$XS_FILE\" 2>/dev/null); then
        /usr/bin/echo \"FAIL: $HOMEDIR ($FIELD setting is missing)\"
        FAIL=1
        continue
    fi

    VALUE=$(/usr/bin/echo \"$LINE\" | /usr/bin/awk '{print $2}')

    if [ \"$VALUE\" != \"$STIG_VALUE\" ]; then
        /usr/bin/echo \"FAIL: $HOMEDIR ($FIELD is $VALUE)\"
        FAIL=1
    fi

done

if [ \"$FAIL\" -eq 0 ]; then
    /usr/bin/echo \"PASS: all users compliant\"
fi"
              expect      : "PASS: all users compliant"
            </custom_item>

            <custom_item>
              system      : "SunOS"
              type        : CMD_EXEC
              description : "user lockTimeout"
              cmd         : "#!/bin/sh

STIG_VALUE=5
FIELD=lockTimeout
FAIL=0

/usr/bin/logins -u -o -x | /usr/bin/awk -F: '{print $6}' | while read -r HOMEDIR; do

    XS_FILE=\"$HOMEDIR/.xscreensaver\"

    if [ ! -r \"$XS_FILE\" ]; then
        /usr/bin/echo \"FAIL: $HOMEDIR (File not found or not readable)\"
        FAIL=1
        continue
    fi

    if ! LINE=$(/usr/xpg4/bin/grep -E \"$FIELD[:space:]*:\" \"$XS_FILE\" 2>/dev/null); then
        /usr/bin/echo \"FAIL: $HOMEDIR ($FIELD setting is missing)\"
        FAIL=1
        continue
    fi

    TIME_VAL=$(/usr/bin/echo \"$LINE\" | /usr/bin/awk '{print $2}')
    SECONDS=$(/usr/bin/echo \"$TIME_VAL\" | /usr/bin/awk -F: '{ print ($1 * 3600) + ($2 * 60) + $3 }')

    if [ \"$SECONDS\" -gt \"$STIG_VALUE\" ]; then
        /usr/bin/echo \"FAIL: $HOMEDIR ($FIELD is $TIME_VAL)\"
        FAIL=1
    fi

done

if [ \"$FAIL\" -eq 0 ]; then
    /usr/bin/echo \"PASS: all users compliant\"
fi"
              expect      : "PASS: all users compliant"
            </custom_item>

            <custom_item>
              system      : "SunOS"
              type        : CMD_EXEC
              description : "user timeout"
              cmd         : "#!/bin/sh

STIG_VALUE=900
FIELD=timeout
FAIL=0

/usr/bin/logins -u -o -x | /usr/bin/awk -F: '{print $6}' | while read -r HOMEDIR; do

    XS_FILE=\"$HOMEDIR/.xscreensaver\"

    if [ ! -r \"$XS_FILE\" ]; then
        /usr/bin/echo \"FAIL: $HOMEDIR (File not found or not readable)\"
        FAIL=1
        continue
    fi
    if ! LINE=$(/usr/xpg4/bin/grep -E \"$FIELD[:space:]*:\" \"$XS_FILE\" 2>/dev/null); then
        /usr/bin/echo \"FAIL: $HOMEDIR ($FIELD setting is missing)\"
        FAIL=1
        continue
    fi
    TIME_VAL=$(/usr/bin/echo \"$LINE\" | /usr/bin/awk '{print $2}')
    SECONDS=$(/usr/bin/echo \"$TIME_VAL\" | /usr/bin/awk -F: '{ print ($1 * 3600) + ($2 * 60) + $3 }')

    if [ \"$SECONDS\" -gt \"$STIG_VALUE\" ]; then
        /usr/bin/echo \"FAIL: $HOMEDIR ($FIELD is $TIME_VAL)\"
        FAIL=1
    fi
done
if [ \"$FAIL\" -eq 0 ]; then
    /usr/bin/echo \"PASS: all users compliant\"
fi"
              expect      : "PASS: all users compliant"
            </custom_item>
          </condition>


      </condition>

      <then>
        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              system      : "SunOS"
              type        : FILE_CHECK
              description : "AUDIT_FILES"
              file        : "@AUDIT_FILES@"
              mask        : "7137"
            </custom_item>

            <custom_item>
              system      : "SunOS"

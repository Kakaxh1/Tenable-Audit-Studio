#    <name>SSH_KEY_GROUP</name>
#    <default>wheel</default>
#    <description>Restricted group to own the SSH private host key files</description>
#    <info>The group that can own SSH private host key files. Default is wheel.</info>
#    <value_type>UNIX_ACCT</value_type>
#  </variable>
#  <variable>
#    <name>PASSWORD_ENCRYPTION</name>
#    <default>SHA512</default>
#    <description>Password encryption method</description>
#    <info>Password encryption method found in /etc/login.conf</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>PASSWORD_MAX_DAYS</name>
#    <default>([0-9]|[1-9][0-9]|[1-2][0-9]{2}|3[0-5][0-9]|36[0-5])d</default>
#    <description>Password maximum age in days</description>
#    <info>Password maximum age parameter found in /etc/login.conf</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>PASSWORD_WARN_DAYS</name>
#    <default>([7-9]|[1-9][0-9]+)d</default>
#    <description>Password expiration warning days</description>
#    <info>Password expiration warning days parameter found in /etc/login.conf</info>
#    <value_type>STRING</value_type>
#  </variable>
#</variables>

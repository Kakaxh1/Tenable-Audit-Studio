      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "autrace"
          file        : "@AIDE_CONF@"
          regex       : "^[\\s]*/sbin/autrace[\\s]+p\\+i\\+n\\+u\\+g\\+s\\+b\\+acl\\+xattrs\\+sha512"
          expect      : "^[\\s]*/sbin/autrace[\\s]+p\\+i\\+n\\+u\\+g\\+s\\+b\\+acl\\+xattrs\\+sha512"

      see_also    : "https://workbench.cisecurity.org/benchmarks/22168"
      cmd         : "logfile=$(/bin/grep -iw ^\\s*log_file /etc/audit/auditd.conf); if [ ! -z \"${logfile}\" ]; then /bin/stat -c \"%n %U\" $(/bin/dirname $(/bin/grep -iw log_file /etc/audit/auditd.conf) | /bin/grep \"/\")/* | /bin/grep -Ev 'root' | /bin/awk '{print} END {if (NR == 0) print \"All files owned by root\"; else print \"Failing files found\"}'; else echo \"log_file variable in /etc/audit/auditd.conf not set\"; fi"

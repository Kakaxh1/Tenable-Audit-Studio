          see_also    : "https://workbench.cisecurity.org/benchmarks/22168"
          cmd         : "/bin/gsettings get org.gnome.desktop.screensaver lock-enabled"
          expect      : "true"
        </custom_item>
      </then>

      <else>
        <report type:"PASSED">
          description : "1.69 UBTU-22-271020"

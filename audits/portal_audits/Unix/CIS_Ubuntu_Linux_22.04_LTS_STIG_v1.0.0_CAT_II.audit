          description : "apparmor_status profiles are enforced"
          cmd         : "/sbin/apparmor_status | /bin/grep profiles"
          expect      : "^[\\s]*[1-9][0-9]*[\\s]+profiles[\\s]+are[\\s]+in[\\]s+enforce[\\s]+mode"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "apparmor.service enabled"
          cmd         : "/bin/systemctl is-enabled apparmor.service"
          expect      : "^[\\s]*enabled$"
        </custom_item>

      see_also    : "https://workbench.cisecurity.org/benchmarks/22168"
      cmd         : "/sbin/auditctl -l | /bin/grep '/sbin/apparmor_parser'"
      expect      : "^[\\s]*-a[\\s]+(?:always,exit|exit,always)(?:[\\s]+-S[\\s]+all)?[\\s]+-F[\\s]+path=/sbin/apparmor_parser[\\s]+(?:-F[\\s]+perm=[rwa]*x[rwa]*[\\s]+)?-F[\\s]+auid>=1000[\\s]+-F[\\s]+auid!=(?:4294967295|-1|unset)(?:[\\s]+(?:-k[\\s]+|-F[\\s]+key=)[\\S]+)*[\\s]*$"

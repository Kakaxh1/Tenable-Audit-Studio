          expect      : "^[\\s]*smtpd_client_restrictions[\\s]*=[\\s]*(permit_mynetworks,[\\s]*reject|reject,[\\s]*permit_mynetworks)[\\s]*$"
        </custom_item>
      </then>

      <else>

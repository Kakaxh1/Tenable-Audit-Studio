      see_also    : "https://workbench.cisecurity.org/benchmarks/27024"
      cmd         : "logfile=$(/bin/grep -iw ^\\s*log_file /etc/audit/auditd.conf | /bin/awk -F= '{print $2}'); if [ ! -z \"${logfile}\" ]; then /bin/stat -c \"%n %G\" ${logfile}; else echo \"log_file variable in /etc/audit/auditd.conf not set\"; fi"

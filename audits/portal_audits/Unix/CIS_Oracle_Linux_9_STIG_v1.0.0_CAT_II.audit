          see_also        : "https://workbench.cisecurity.org/benchmarks/27024"
          file            : "/etc/dconf/db/*.d/locks/*"
          regex           : "^[\\s]*/org/gnome/settings-daemon/plugins/media-keys/logout[\\s]*$"
          expect          : "^[\\s]*/org/gnome/settings-daemon/plugins/media-keys/logout[\\s]*$"
          file_required   : NO
          min_occurrences : "1"
          string_required : NO
        </custom_item>

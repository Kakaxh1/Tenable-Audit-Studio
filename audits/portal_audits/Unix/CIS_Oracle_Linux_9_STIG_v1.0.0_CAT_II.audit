      see_also    : "https://workbench.cisecurity.org/benchmarks/27024"
      file        : "/etc/audit/auditd.conf"
      regex       : "(?i)^[\\s]*local_events[\\s]*=[\\s]*"
      expect      : "(?i)^[\\s]*local_events[\\s]*=[\\s]*yes[\\s]*$"
    </custom_item>


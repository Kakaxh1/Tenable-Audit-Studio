      see_also    : "https://workbench.cisecurity.org/benchmarks/27024"
      cmd         : "/bin/rpm -Va --noconfig | /bin/awk '$1 ~ /..5/ && $2 != \"c\"'| /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"

      see_also    : "https://workbench.cisecurity.org/benchmarks/27024"
      file        : "/etc/security/faillock.conf"
      regex       : "^[\\s]*fail_interval[\\s]*=[\\s]*"
      expect      : "^[\\s]*fail_interval[\\s]*=[\\s]*(?:[1-9]|[1-9][0-9]|[1-8][0-9]{2}|900)[\\s]*$"
    </custom_item>


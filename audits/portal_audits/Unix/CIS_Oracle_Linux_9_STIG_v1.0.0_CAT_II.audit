          expect      : "^[^#]+\\bvsyscall=none\\b"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "grubby"
          cmd         : "(/sbin/grubby --info=ALL | /bin/grep args | /bin/grep -v 'vsyscall=none') 2>&1 | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"

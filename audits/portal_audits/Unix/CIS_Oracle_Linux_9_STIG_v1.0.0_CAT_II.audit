      see_also    : "https://workbench.cisecurity.org/benchmarks/27024"
      file        : "/etc/fstab"
      regex       : "^[\\s]*[^#\\n\\r]*[\\s]+nfs([2-4])?[\\s]+"
      expect      : "^[\\s]*[^#\\n\\r]*[\\s]+nfs([2-4])?[\\s]+[^#\\n\\r]*nosuid"
      required    : NO
    </custom_item>


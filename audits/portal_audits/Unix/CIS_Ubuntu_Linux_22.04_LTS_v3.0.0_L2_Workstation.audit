          expect      : "^Status: install ok"
        </custom_item>
      </condition>

      <then>
        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              type        : FILE_CONTENT_CHECK
              description : "user profile check user-db"
              file        : "/etc/dconf/profile/* /etc/dconf/profile/*/*"
              regex       : "^[\\s]*([^#\\n\\r\\s]*:)?user-db:"
              expect      : "^[\\s]*([^#\\n\\r\\s]*:)?user-db:[^#\\n\\r]+"
            </custom_item>

            <custom_item>
              type        : FILE_CONTENT_CHECK
              description : "user profile check system-db"

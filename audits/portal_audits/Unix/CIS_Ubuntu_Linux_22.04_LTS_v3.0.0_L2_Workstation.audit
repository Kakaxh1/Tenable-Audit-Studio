      see_also    : "https://workbench.cisecurity.org/benchmarks/24330"
      file        : "/etc/sudoers /etc/sudoers.d/*"
      regex       : "^[^#]*NOPASSWD"
      expect      : "^[^#]*NOPASSWD"

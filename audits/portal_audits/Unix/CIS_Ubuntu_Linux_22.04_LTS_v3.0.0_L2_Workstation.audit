#<variables>
#  <variable>
#    <name>PLATFORM_VERSION</name>
#    <default>22.04</default>
#    <description>Ubuntu Version</description>
#    <info>Ubuntu Version</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>PASSWORD_ROOT_UNLOCK_TIME</name>
#    <default>([6-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9]{3,})</default>
#    <description>Time before the root account is unlocked</description>
#    <info>Time in seconds before the root account is unlocked found in faillock.conf</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>PASSWORD_MIN_DAYS</name>
#    <default>1</default>
#    <description>Password minimum days</description>
#    <info>Minimum days between password changes parameter found in /etc/login.defs</info>
#    <value_type>INTEGER</value_type>
#  </variable>
#  <variable>
#    <name>PASSWORD_MIN_DAYS_REGEX</name>
#    <default>([1-9]|[1-9][0-9]+)</default>
#    <description>Password minimum days (Regex range)</description>
#    <info>Minimum days between password changes parameter found in /etc/login.defs (Regex range)</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>MAX_AUDIT_LOG_FILE_SIZE</name>
#    <default>32</default>
#    <description>Log file size</description>
#    <info>The max size, in MBs, each audit log can be before log file rotation.</info>
#    <value_type>STRING</value_type>
#  </variable>
#</variables>

          expect          : "(?i)^\\h*auth\\h+([^#\\n\\r]+\\h+)pam_faillock\\.so\\h+([^#\\n\\r]+\\h+)?root_unlock_time\\h*=\\h*@PASSWORD_ROOT_UNLOCK_TIME@\\b"
          string_required : NO

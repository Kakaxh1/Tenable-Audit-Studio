      see_also    : "https://workbench.cisecurity.org/benchmarks/26107"
      file        : "/etc/pki/tls/openssl.cnf"
      regex       : "opensslcnf\\.config"
      expect      : "\\.include[\\s]*=?[\\s]*/etc/crypto-policies/back-ends/opensslcnf\\.config"
    </custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "TLS1.2"
          file        : "/etc/crypto-policies/back-ends/opensslcnf.config"

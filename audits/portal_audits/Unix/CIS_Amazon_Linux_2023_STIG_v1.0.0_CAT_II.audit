          cmd         : "/sbin/auditctl -l | /bin/grep execve"
          expect      : "^[\\s]*-a[\\s]+(?:always,exit|exit,always)[\\s]+-F[\\s]+arch=b64[\\s]+(?:-S[\\s]+[\\s]+[\\s]+)*-S[\\s]+[\\s]*\\bexecve\\b[\\s]*[\\s]+(?:-S[\\s]+[\\s]+[\\s]+)*-C[\\s]+gid!=egid[\\s]+-F[\\s]+egid=0(?:[\\s]+(?:-k[\\s]+|-F[\\s]+key=)[\\s]+)*[\\s]*"

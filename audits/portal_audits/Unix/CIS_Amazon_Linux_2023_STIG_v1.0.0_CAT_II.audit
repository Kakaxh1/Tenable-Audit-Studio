          expect      : "^[\\s]*-a[\\s]+(?:always,exit|exit,always)[\\s]+-F[\\s]+arch=b64[\\s]+(?:-S[\\s]+[\\S]+[\\s]+)*-S[\\s]+[\\S]*\\binit_module\\b[\\S]*[\\s]+(?:-S[\\s]+[\\S]+[\\s]+)*-F[\\s]+auid>=1000[\\s]+-F[\\s]+auid!=(?:4294967295|-1|unset).*(-k[\\s]+|-F[\\s]+key=)[-\\w]+[\\s]*$"

      xsl_stmt          : "<xsl:for-each select=\"server\">"
      xsl_stmt          : "<xsl:choose>"
      xsl_stmt          : "<xsl:when test=\"authCache/@timeout='10m'\">"
      xsl_stmt          : "<xsl:text>PASS - authCache timeout set to 10m</xsl:text><xsl:text>&#xa;</xsl:text>"

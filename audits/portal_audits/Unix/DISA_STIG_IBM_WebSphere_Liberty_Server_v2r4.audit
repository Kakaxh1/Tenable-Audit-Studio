      xsl_stmt          : "<xsl:text>PASS - </xsl:text><xsl:value-of select=\"ssl/@enabledCiphers\" />"
      xsl_stmt          : "</xsl:when>"
      xsl_stmt          : "<xsl:otherwise>"
      xsl_stmt          : "<xsl:text>FAIL - </xsl:text><xsl:value-of select=\"ssl/@enabledCiphers\" />"
      xsl_stmt          : "</xsl:otherwise>"
      xsl_stmt          : "</xsl:choose>"
      xsl_stmt          : "</xsl:when>"

          xsl_stmt          : "</xsl:for-each>"
          xsl_stmt          : "</xsl:variable>"
          xsl_stmt          : "<xsl:choose>"
          xsl_stmt          : "<xsl:when test=\"contains($disallowed_users, 'FAIL')\">"
          xsl_stmt          : "<xsl:text>FAIL</xsl:text>"
          xsl_stmt          : "<xsl:for-each select=\"//administrator-role/user\">"
          xsl_stmt          : "<xsl:variable name=\"admin_user\" select=\"normalize-space(.)\"/>"
          xsl_stmt          : "<xsl:choose>"
          xsl_stmt          : "<xsl:when test=\"//basicRegistry/user[@name=$admin_user]\">"
          xsl_stmt          : "<xsl:text>  - Admin user '</xsl:text><xsl:value-of select=\"$admin_user\"/><xsl:text>' is in basicRegistry.</xsl:text>"
          xsl_stmt          : "</xsl:when>"
          xsl_stmt          : "</xsl:choose>"
          xsl_stmt          : "</xsl:for-each>"
          xsl_stmt          : "</xsl:when>"
          xsl_stmt          : "<xsl:otherwise>"
          xsl_stmt          : "<xsl:text>PASS - No admin users found in basicRegistries.</xsl:text>"
          xsl_stmt          : "</xsl:otherwise>"
          xsl_stmt          : "</xsl:choose>"
          xsl_stmt          : "</xsl:template>"
          regex             : "(?i)PASS|FAIL"
          expect            : "PASS"
          file_supersedence : YES
        </custom_item>


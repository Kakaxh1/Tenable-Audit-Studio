                  see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_IBM_WebSphere_Liberty_Server_V2R4_STIG.zip"
                  show_output : YES
                </report>
              </then>
            </if>
          </then>

          <else>
            <if>
              <condition auto:"FAILED" type:"AND">
                <custom_item>
                  type        : FILE_CONTENT_CHECK
                  description : "check profile provider config (any of install/server/client location)"
                  file        : "@APP_Install_path@/etc/FIPS140-3-Liberty-Application.properties @APP_Config_catalogs@/resources/security/FIPS140-3-Liberty-Application.properties @APP_Install_path@/usr/clients/*/resources/security/FIPS140-3-Liberty-Application.properties"
                  regex       : "^[\\s]*RestrictedSecurity.OpenJCEPlusFIPS.FIPS140-3-Liberty-Application.jce.provider.1[\\s]*="
                  expect      : "^[\\s]*RestrictedSecurity.OpenJCEPlusFIPS.FIPS140-3-Liberty-Application.jce.provider.1[\\s]*=[\\s]*com\\.ibm\\.crypto\\.plus\\..+$"
                </custom_item>

                <custom_item>
                  type              : FILE_CONTENT_CHECK
                  description       : "TLS protocol check"
                  file              : "@APP_Config_catalogs@/configDropins/defaults/*.xml @APP_Config_files@ @APP_Config_catalogs@/configDropins/overrides/*.xml"
                  xsl_stmt          : "<xsl:template match=\"/\">"
                  xsl_stmt          : "<xsl:for-each select=\"server\">"
                  xsl_stmt          : "<xsl:variable name=\"sslConfig\" select=\"ssl[@id='defaultSSLConfig']\"/>"
                  xsl_stmt          : "<xsl:choose>"
                  xsl_stmt          : "<xsl:when test=\"not($sslConfig)\">"
                  xsl_stmt          : "<xsl:text>FAIL - No default SSL configuration (id='defaultSSLConfig') found.&#xa;</xsl:text>"
                  xsl_stmt          : "</xsl:when>"
                  xsl_stmt          : "<xsl:when test=\"$sslConfig/@sslProtocol='TLSv1.2' or $sslConfig/@sslProtocol='TLSv1.3'\">"
                  xsl_stmt          : "<xsl:text>PASS - sslProtocol: </xsl:text><xsl:value-of select=\"$sslConfig/@sslProtocol\"/><xsl:text>&#xa;</xsl:text>"
                  xsl_stmt          : "</xsl:when>"
                  xsl_stmt          : "<xsl:otherwise>"
                  xsl_stmt          : "<xsl:text>FAIL - sslProtocol: </xsl:text><xsl:value-of select=\"$sslConfig/@sslProtocol\"/><xsl:text> (Expected: TLSv1.2 or TLSv1.3)&#xa;</xsl:text>"
                  xsl_stmt          : "</xsl:otherwise>"
                  xsl_stmt          : "</xsl:choose>"
                  xsl_stmt          : "</xsl:for-each>"
                  xsl_stmt          : "</xsl:template>"
                  regex             : "PASS|FAIL"
                  expect            : "PASS"
                  file_supersedence : YES
                </custom_item>

                <custom_item>
                  type        : FILE_CHECK
                  description : "LTPA keys exist"
                  file        : "@APP_Config_catalogs@/resources/security/ltpa.keys"
                </custom_item>

                <custom_item>
                  type              : FILE_CONTENT_CHECK
                  description       : "SAML signature algorithm check (FIPS 140-3 approved: SHA256, SHA384, SHA512, ECDSAwithSHA256, ECDSAwithSHA384, ECDSAwithSHA512)"
                  file              : "@APP_Config_catalogs@/configDropins/defaults/*.xml @APP_Config_files@ @APP_Config_catalogs@/configDropins/overrides/*.xml"
                  xsl_stmt          : "<xsl:template match=\"/\">"
                  xsl_stmt          : "<xsl:choose>"
                  xsl_stmt          : "<xsl:when test=\"not(//samlWebSso20)\">"
                  xsl_stmt          : "<xsl:text>PASS - No samlWebSso20 configuration found (SAML not in use).&#xa;</xsl:text>"
                  xsl_stmt          : "</xsl:when>"
                  xsl_stmt          : "<xsl:otherwise>"
                  xsl_stmt          : "<xsl:for-each select=\"//samlWebSso20\">"
                  xsl_stmt          : "<xsl:variable name=\"alg\" select=\"@signatureMethodAlgorithm\"/>"
                  xsl_stmt          : "<xsl:choose>"
                  xsl_stmt          : "<xsl:when test=\"$alg='SHA256' or $alg='SHA384' or $alg='SHA512' or $alg='ECDSAwithSHA256' or $alg='ECDSAwithSHA384' or $alg='ECDSAwithSHA512'\">"
                  xsl_stmt          : "<xsl:text>PASS - samlWebSso20 id='</xsl:text><xsl:value-of select=\"@id\"/><xsl:text>' signatureMethodAlgorithm: </xsl:text><xsl:value-of select=\"$alg\"/><xsl:text>&#xa;</xsl:text>"
                  xsl_stmt          : "</xsl:when>"
                  xsl_stmt          : "<xsl:otherwise>"
                  xsl_stmt          : "<xsl:text>FAIL - samlWebSso20 id='</xsl:text><xsl:value-of select=\"@id\"/><xsl:text>' signatureMethodAlgorithm: </xsl:text><xsl:value-of select=\"$alg\"/><xsl:text> (Expected: SHA256, SHA384, SHA512, ECDSAwithSHA256, ECDSAwithSHA384, or ECDSAwithSHA512)&#xa;</xsl:text>"
                  xsl_stmt          : "</xsl:otherwise>"
                  xsl_stmt          : "</xsl:choose>"
                  xsl_stmt          : "</xsl:for-each>"
                  xsl_stmt          : "</xsl:otherwise>"
                  xsl_stmt          : "</xsl:choose>"
                  xsl_stmt          : "</xsl:template>"
                  regex             : "PASS|FAIL"
                  expect            : "PASS"
                  file_supersedence : YES
                </custom_item>
              </condition>

              <then>
                <report type:"PASSED">
                  description : "IBMW-LS-001200 - The WebSphere Liberty Server must use FIPS 140-3-approved encryption modules when authenticating users and processes."
                  info        : "Encryption is only as good as the encryption modules in use. Unapproved cryptographic module algorithms cannot be verified and cannot be relied upon to provide confidentiality or integrity, and DOD data may be compromised due to weak algorithms. The use of TLS provides confidentiality of data in transit between the application server and client. FIPS 140-3-approved TLS versions include TLS V1.0 or greater.

TLS must be enabled and non-FIPS-approved SSL versions must be disabled. NIST SP 800-52 specifies the preferred configurations for government systems."

<check_type:"F5">

<report type:"WARNING">
  description : "1.1.1 Ensure default password of root is not allowed"
  info        : "To assist users in changing default password for \"root\" account

Using Default passwords for 'root' access could cause a compromise to the overall system security

NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
  solution    : "- Log in to the Configuration utility.
- For System, select Platform.
- Under User Administration, choose the Password box for either Root Account or Admin Account.
- Enter the new password.
- Enter the same password in the Confirm box for the account that you chose in step 3.
- Select Update.
- If you have updated the password for Admin Account, the system logs you out of the Configuration
utility, and you must log in again using the new password.

Impact:

Failure of changing default root's password brings high risk to the system as the root account might be abused by unauthorized users who would have full privilege on F5 systems"
  reference   : "800-171|3.5.2,800-171r3|03.05.07,800-53|IA-5(1),800-53r5|IA-5(1),CSCv7|4.2,CSCv8|5.2,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ITSG-33|IA-5(1),LEVEL|1A,NESA|T5.2.3,QCSC-v1|5.2.2,QCSC-v1|13.2,SWIFT-CSCv1|4.1"
  see_also    : "https://workbench.cisecurity.org/files/3587"
</report>

<report type:"WARNING">
  description : "1.1.2 Ensure default password of admin is not used"
  info        : "To assist users in changing default password for 'admin' account

Using Default passwords for 'admin' access could cause a compromise to the overall system security

NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
  solution    : "- Log in to the Configuration utility.
- For System, select Platform.
- Under User Administration, choose the Password box for either Root Account or Admin Account.
- Enter the new password.
- Enter the same password in the Confirm box for the account that you chose in step 3.
- Select Update.
- If you have updated the password for Admin Account, the system logs you out of the Configuration
utility, and you must log in again using the new password.

Impact:

Failure of changing default root's password brings high risk to the system as the root account might be abused by unauthorized users who would have full privilege on F5 systems"
  reference   : "800-171|3.5.2,800-171r3|03.05.07,800-53|IA-5(1),800-53r5|IA-5(1),CSCv7|4.2,CSCv8|5.2,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ISO-27001-2022|A.5.16,ISO-27001-2022|A.5.17,ITSG-33|IA-5(1),LEVEL|1A,NESA|T5.2.3,QCSC-v1|5.2.2,QCSC-v1|13.2,SWIFT-CSCv1|4.1"
  see_also    : "https://workbench.cisecurity.org/files/3587"
</report>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for required special"
      context     : "auth password-policy"
      regex       : "required-special"
      expect      : "required-special \b@REQUIRED_SPECIAL@\b"
    </custom_item>

    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for lockout duration"
      context     : "auth password-policy"
      regex       : "lockout-duration"
      expect      : "lockout-duration \b@LOCKOUT_DURATION@\b"
    </custom_item>

    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for required numeric"
      context     : "auth password-policy"
      regex       : "required-numeric"
      expect      : "required-numeric \b@REQUIRED_NUMERIC@\b"
    </custom_item>

    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for policy-enforcement"
      context     : "auth password-policy"
      regex       : "policy-enforcement"
      expect      : "policy-enforcement enabled"
    </custom_item>

    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for expiration warning"
      context     : "auth password-policy"
      regex       : "expiration-warning"
      expect      : "expiration-warning \b@EXPIRATION_WARNING@\b"
    </custom_item>

    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for required uppercase"
      context     : "auth password-policy"
      regex       : "required-uppercase"
      expect      : "required-uppercase \b@REQUIRED_UPPERCASE@\b"
    </custom_item>

    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for minimum length"
      context     : "auth password-policy"

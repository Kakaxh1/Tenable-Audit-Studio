<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for Timezone"
      context     : "cm device "
      regex       : "time-zone"
      expect      : "time-zone UTC"
    </custom_item>

    <custom_item>
      description    : "Check REST API for Timezone"

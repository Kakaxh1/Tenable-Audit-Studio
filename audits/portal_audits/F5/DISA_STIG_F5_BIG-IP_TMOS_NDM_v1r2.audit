</report>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for Secure Password Enforcement"
      context     : "auth password-policy"
      regex       : "policy-enforcement"
      expect      : "policy-enforcement enabled"
    </custom_item>

    <custom_item>
      type        : OFFLINE_CONFIG_CHECK
      description : "Check offline config for Minimum Length"
      context     : "auth password-policy"
      regex       : "minimum-length"
      expect      : "minimum-length \b@MINIMUM_LENGTH@\b"
    </custom_item>

    <custom_item>
      description    : "Check REST API for Secure Password Enforcement"
      f5_command     : "/tm/auth/password-policy"
      json_transform : ".policyEnforcement"
      expect         : "enabled"
    </custom_item>

    <custom_item>
      description    : "Check REST API for Minimum Length"
      f5_command     : "/tm/auth/password-policy"
      json_transform : ".minimumLength"
      expect         : "\b@MINIMUM_LENGTH@\b"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "F5BI-DM-300049 - The F5 BIG-IP appliance must enforce a minimum 15-character password length."
      info        : "Password complexity, or strength, is a measure of the effectiveness of a password in resisting attempts at guessing and brute-force attacks. Password length is one factor of several that helps to determine strength and how long it takes to crack a password.

The shorter the password, the lower the number of possible combinations that need to be tested before the password is compromised. Use of more characters in a password helps to exponentially increase the time and/or resources required to compromise the password."
      solution    : "From the BIG-IP GUI:
1. System.
2. Users.
3. Authentication.
4. Under \"Password Policy\" set \"Secure Password Enforcement\" to \"Enabled\".
5. Configure \"Minimum Length\" to 15.
6. Click \"Update\".

From the BIG-IP console, type the following command(s):

tmsh modify auth password-policy minimum-length 15
tmsh save sys config"

  see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Apple_iOS-iPadOS_18_V2R3_STIG.zip"
</report>

<report type:"WARNING">
  description : "AIOS-18-016400 - Apple iOS/iPadOS 18 must disable automatic downloads of apps purchased on other Apple devices."
  info        : "The automatic download of apps to a DOD mobile device could cause the exposure of sensitive DOD information when an unauthorized app is installed.

SFR ID: FMT_MOF_EXT.1.2 #47

NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."

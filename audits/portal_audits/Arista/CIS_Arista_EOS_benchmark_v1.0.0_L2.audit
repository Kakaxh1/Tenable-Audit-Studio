# description : This .audit is designed against the CIS Arista EOS benchmark v1.0.0
#
#<ui_metadata>
#<display_name>CIS Arista EOS benchmark v1.0.0 L2</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Arista EOS benchmark</name>
#  <profile>L2</profile>
#  <version>1.0.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/25683</link>
#</spec>
#<labels>cis</labels>
#<benchmark_refs>LEVEL</benchmark_refs>
#<variables>
#  <variable>
#    <name>SSL_PROFILE</name>
#    <default>syslog-profile</default>
#    <description>Syslog TLS SSL profile name</description>
#    <info>SSL profile used for syslog TLS authentication.</info>
#    <value_type>STRING</value_type>
#  </variable>
#</variables>
#</ui_metadata>

<check_type:"Arista">

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      description : "NTP authentication key configured"
      expect      : "^[\s]*ntp authentication-key [0-9]+ (md5|sha1)( 7)? .+[ ]*$"
    </custom_item>

    <custom_item>
      description : "NTP trusted key configured"
      expect      : "^[\s]*ntp trusted-key [0-9]+[ ]*$"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "1.1.5 NTP authentication"
      info        : "NTP authentication verifies that time updates come from a trusted server, preventing bad actors from spoofing time or altering your clock.

The NTP authentication model is the opposite of the typical client-server authentication model. NTP authentication enables an NTP client or peer to authenticate time received from their servers and peers. It's not used to authenticate NTP clients because NTP servers don't care about the authenticity of their clients as they never accept any time from them.

Authentication support allows the NTP client to verify that servers are in fact known and trusted and not intruders intending accidentally or intentionally to masquerade as a legitimate server."
      solution    : "switch(config)#ntp authentication-key 1 sha1 timesync
switch(config)#ntp trusted-key 1

Impact:

NTP authentication requires server side configuration with a matching key. Mismatches will prevent successful synchronization."
      reference   : "800-171|3.3.7,800-171r3|03.03.07,800-53|AU-8,800-53r5|AU-8,CN-L3|8.1.4.3(b),CSF|PR.PT-1,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(b),ISO-27001-2022|A.8.17,ITSG-33|AU-8,LEVEL|2M,NESA|T3.6.2,QCSC-v1|8.2.1,QCSC-v1|13.2,TBA-FIISB|37.4"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
      show_output : YES
    </report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      description : "Syslog host configured with TLS and SSL profile"
      expect      : "^[\s]*logging (vrf [A-Za-z0-9_-]+ )?host [0-9a-fA-F:\.]+ protocol tls ssl-profile @SSL_PROFILE@[ ]*$"
    </custom_item>

    <custom_item>
      description : "SSL profile defined in management security"
      context     : "management security"
      regex       : "ssl profile"
      expect      : "^[\s]*ssl profile @SSL_PROFILE@[ ]*$"
    </custom_item>

    <custom_item>
      description : "SSL profile has client certificate configured"
      context     : "ssl profile @SSL_PROFILE@"
      regex       : "certificate"
      expect      : "^[\s]*certificate .+ key .+[ ]*$"
    </custom_item>

    <custom_item>
      description : "SSL profile has trust certificate configured"
      context     : "ssl profile @SSL_PROFILE@"
      regex       : "trust certificate"
      expect      : "^[\s]*trust certificate .+[ ]*$"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "1.1.9 Syslog with TLS support"
      info        : "Syslog over TLS is a secure standard (RFC 5425) that encrypts log messages in transit using Transport Layer Security. It protects sensitive operational and security data from interception and tampering

Syslog messages may transit several hops to arrive at the intended
collector. Some intermediary networks may not be trusted by the
originator, relay, or receiver because the network is in a different
security domain or at a different security level from the originator,
relay, or collector. Another security concern is that the
originator, relay, or receiver itself is in an insecure network.

By using TLS connections, syslog is better protected against attacks and information leakage."
      solution    : "- Create an SSL profile

switch(config-mgmt-security)#ssl profile syslog-profile
switch(config-mgmt-sec-ssl-profile-syslog-profile)#certificate clientCert key ClientKey
switch(config-mgmt-sec-ssl-profile-syslog-profile)# trust certificate serverCA
switch(config-mgmt-sec-ssl-profile-syslog-profile)#

 - Define syslog server
switch(config)#logging vrf MGMT host 10.1.1.1 protocol tls ssl-profile syslog-profile"
      reference   : "800-171|3.3.8,800-171r3|03.03.08,800-53|AU-9(3),800-53r5|AU-9(3),CN-L3|8.1.4.3(d),CSF|PR.PT-1,CSF2.0|PR.DS-10,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(b),ISO-27001-2022|A.5.33,ISO-27001-2022|A.8.15,ISO/IEC-27001|A.12.4.2,ITSG-33|AU-9(3),LEVEL|2M,NESA|M5.2.3,NESA|M5.5.2,NIAv2|SM5,NIAv2|SM6,PCI-DSSv3.2.1|10.5,PCI-DSSv3.2.1|10.5.2,PCI-DSSv4.0|10.3.2,QCSC-v1|8.2.1,QCSC-v1|13.2,TBA-FIISB|37.3.3"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
      show_output : YES
    </report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      description : "SSH approved cipher algorithms configured"
      context     : "management ssh"
      regex       : "cipher"
      expect      : "^\s*cipher(?=.*\baes256-gcm\S*)(?=.*\baes128-gcm\S*)(?=.*\baes256-ctr\b)(?=.*\baes192-ctr\b)(?=.*\baes128-ctr\b)(?!.*\b(3des|des-cbc|rc4|arcfour|blowfish|cast128)\b)"
    </custom_item>

    <custom_item>
      description : "SSH approved key-exchange algorithms configured"
      context     : "management ssh"
      regex       : "key-exchange"
      expect      : "^\s*key-exchange(?=.*\bcurve25519-sha256\S*)(?=.*\becdh-sha2-nistp521\b)(?=.*\becdh-sha2-nistp256\b)(?=.*\becdh-sha2-nistp384\b)(?=.*\bdiffie-hellman-group14-sha1\b)(?!.*\bdiffie-hellman-group1-sha1\b)"
    </custom_item>

    <custom_item>
      description : "SSH approved MAC algorithms configured"
      context     : "management ssh"
      regex       : "^ *mac "
      expect      : "^\s*mac(?=.*\bhmac-sha2-512-etm\S*)(?=.*\bhmac-sha2-256-etm\S*)(?=.*\bhmac-sha1-etm\S*)(?=.*\bhmac-sha2-512\b)(?=.*\bhmac-sha2-256\b)(?=.*\bhmac-sha1\b)(?!.*\bhmac-md5\b)"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "2.6.3 Remove cryptographically weak algorithms"
      info        : "Outdated and insecure ciphers and algorithms should not be used.

An attacker can possibly break the encryption of transported data if weak ciphers and algorithms are used
to access sensitive data."
      solution    : "management ssh
        cipher aes128-ctr aes256-ctr
        key-exchange diffie-hellman-group14-sha256
        mac hmac-sha2-256

Impact:

The alogithms used in an ssh session are negotiated between the client and the server. Restricting the list of accepted algorithms could prevent some clients connecting to the device."
      reference   : "800-171|3.13.11,800-171r3|03.13.11,800-53|SC-13,800-53r5|SC-13,CSF|PR.DS-5,CSF2.0|PR.DS-01,CSF2.0|PR.DS-02,CSF2.0|PR.DS-10,GDPR|32.1.a,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(iv),HIPAA|164.312(e)(2)(ii),ISO-27001-2022|A.8.24,ISO/IEC-27001|A.10.1.1,ITSG-33|SC-13,ITSG-33|SC-13a.,LEVEL|2M,NESA|M5.2.6,NESA|T7.4.1,NIAv2|CY3,NIAv2|CY4,NIAv2|CY5b,NIAv2|CY5c,NIAv2|CY5d,NIAv2|CY7,NIAv2|NS5e,QCSC-v1|6.2"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
      show_output : YES
    </report>
  </then>
</if>

<if>
  <condition type:"AND">
    <custom_item>
      description : "management API is enabled"
      context     : "management api http-commands"
      expect      : "^[\s]*no shutdown[ ]*$"
    </custom_item>
  </condition>

  <then>
    <custom_item>
      description : "2.9 API access using https"
      info        : "The Arista Command eAPI is a simple and complete API that allows you to configure and monitor your Arista switches. Once the API is enabled, the switch accepts HTTPS requests containing a list of industry standard CLI commands, and responds with machine-readable output and errors serialized in JSON (served over HTTP or HTTPS). HTTP can be enabled but should be left disabled.

EOS API provides structured output more suitable for programmatic parsing than cli scraping.
If the API is enabled, it should only use https, not http."
      solution    : "switch(config)#management api http-commands
switch(config-mgmt-api-http-cmds)#no shutdown
switch(config-mgmt-api-http-cmds)#default protocol http
switch(config-mgmt-api-http-cmds)#vrf MGMT
switch(config-mgmt-api-http-cmds-vrf-MGMT)#no shutdown
switch(config-mgmt-api-http-cmds-vrf-MGMT)#"
      reference   : "800-171|3.13.11,800-171r3|03.13.11,800-53|SC-13,800-53r5|SC-13,CSF|PR.DS-5,CSF2.0|PR.DS-01,CSF2.0|PR.DS-02,CSF2.0|PR.DS-10,GDPR|32.1.a,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(iv),HIPAA|164.312(e)(2)(ii),ISO-27001-2022|A.8.24,ISO/IEC-27001|A.10.1.1,ITSG-33|SC-13,ITSG-33|SC-13a.,LEVEL|2M,NESA|M5.2.6,NESA|T7.4.1,NIAv2|CY3,NIAv2|CY4,NIAv2|CY5b,NIAv2|CY5c,NIAv2|CY5d,NIAv2|CY7,NIAv2|NS5e,QCSC-v1|6.2"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
      context     : "management api http-commands"
      not_expect  : "^[\s]*protocol http[ ]*$"
    </custom_item>
  </then>

  <else>
    <report type:"PASSED">
      description : "2.9 API access using https"
      info        : "The Arista Command eAPI is a simple and complete API that allows you to configure and monitor your Arista switches. Once the API is enabled, the switch accepts HTTPS requests containing a list of industry standard CLI commands, and responds with machine-readable output and errors serialized in JSON (served over HTTP or HTTPS). HTTP can be enabled but should be left disabled.

EOS API provides structured output more suitable for programmatic parsing than cli scraping.
If the API is enabled, it should only use https, not http."
      solution    : "switch(config)#management api http-commands
switch(config-mgmt-api-http-cmds)#no shutdown
switch(config-mgmt-api-http-cmds)#default protocol http
switch(config-mgmt-api-http-cmds)#vrf MGMT
switch(config-mgmt-api-http-cmds-vrf-MGMT)#no shutdown
switch(config-mgmt-api-http-cmds-vrf-MGMT)#"
      reference   : "800-171|3.13.11,800-171r3|03.13.11,800-53|SC-13,800-53r5|SC-13,CSF|PR.DS-5,CSF2.0|PR.DS-01,CSF2.0|PR.DS-02,CSF2.0|PR.DS-10,GDPR|32.1.a,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(iv),HIPAA|164.312(e)(2)(ii),ISO-27001-2022|A.8.24,ISO/IEC-27001|A.10.1.1,ITSG-33|SC-13,ITSG-33|SC-13a.,LEVEL|2M,NESA|M5.2.6,NESA|T7.4.1,NIAv2|CY3,NIAv2|CY4,NIAv2|CY5b,NIAv2|CY5c,NIAv2|CY5d,NIAv2|CY7,NIAv2|NS5e,QCSC-v1|6.2"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
    </report>
  </else>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      description : "OSPF message-digest authentication enabled on interface"
      context     : "interface .+"
      regex       : "ip ospf authentication"
      expect      : "^\s*ip ospf authentication message-digest[ ]*$"
    </custom_item>

    <custom_item>
      description : "OSPF authentication key uses SHA256"
      context     : "interface .+"
      regex       : "ip ospf authentication message-digest-key"
      expect      : "^\s*ip ospf authentication message-digest-key \d+ sha256"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "3.1.1 OSPF Interface Authentication"
      info        : "OSPF authentication secures routing updates by verifying the identity of neighboring routers, preventing malicious devices from injecting false routing information.

The OSPFv2 Secure Hash Algorithms (SHA) Authentication support as defined in RFC 5709 supports the configuration of SHA1, SHA256, SHA384 and SHA512 Message-Digest authentication as an alternative to the MD5 Message-Digest authentication.

Because a routing protocol contains information that need not be kept
secret, privacy is not a requirement. However, authentication of the
messages within the protocol is of interest in order to reduce the
risk of an adversary compromising the routing system by deliberately
injecting false information into the routing system.

SHA256 or higher should be used due to concerns about the overall strength of the MD5 and SHA1 algorithm."
      solution    : "Configure OSPF authentication on interfaces connected to OSPF neighbors

interface {interface-name}
   ip ospf authentication message-digest
   ip ospf authentication message-digest-key {number} sha256 {key text}"
      reference   : "800-171r3|03.05.02,800-53|IA-3(1),800-53r5|IA-3(1),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ITSG-33|IA-3(1),NESA|T5.4.3,QCSC-v1|13.2,TBA-FIISB|27.1"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
      show_output : YES
    </report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      description : "ISIS interface authentication mode md5 present"
      regex       : "isis authentication mode md5"
      expect      : "^\s*isis authentication mode md5[ ]*$"
    </custom_item>

    <custom_item>
      description : "ISIS interface authentication key present"
      regex       : "isis authentication key"
      expect      : "^\s*isis authentication key .+"
    </custom_item>

    <custom_item>
      description : "ISIS instance authentication mode md5 configured"
      context     : "router isis [0-9]+"
      regex       : "authentication mode"
      expect      : "^\s*authentication mode md5[ ]*$"
    </custom_item>

    <custom_item>
      description : "ISIS instance authentication key configured"
      context     : "router isis [0-9]+"
      regex       : "authentication key"
      expect      : "^\s*authentication key .+"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "3.1.2 ISIS Interface and Instance Authentication"
      info        : "Enable authentication of ISIS hellos on interfaces and LSPs, CSNPs, and PSNPs for the protocol instance.

IS-IS authentication secures routing adjacencies and LSDB updates by validating the source of protocol packets."
      solution    : "interface Ethernet {X}
  isis authentication mode md5
  isis authentication key {key}

router isis {protocol instance}
  authentication mode md5
  authentication key {key}"
      reference   : "800-171r3|03.05.02,HIPAA|164.306(a)(1),800-53|IA-3(1),QCSC-v1|13.2,800-53r5|IA-3(1),HIPAA|164.312(a)(2)(i),CSF|PR.AC-1,NESA|T5.4.3,CSF2.0|PR.AA-01,HIPAA|164.312(d),CSF2.0|PR.AA-03,TBA-FIISB|27.1,GDPR|32.1.b,ITSG-33|IA-3(1)"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
      show_output : YES
    </report>
  </then>
</if>

<custom_item>
  description : "3.2.1 BGP Authentication"
  info        : "The neighbor password command enables authentication on a TCP connection with a BGP peer

When utilizing BGP the threat profile becomes much larger as routes external to the data center will be updating routing information in the devices. Much like with the IGP an attacker could redirect traffic to an insecure location where traffic could be analyzed and confidential information extracted. In the case of BGP a peer AS can send erroneous prefix information and as a result could allow packets to be sent to an insecure network. It is recommended that peer authentication be used for all peers. A password or key should be defined for each BGP neighbor regardless of the peer's autonomous system.

NOTE: Nessus has provided the target output to assist in reviewing the benchmark to ensure target compliance."
  solution    : "Configure passwords for each neighbor as appropriate

router bgp
   neighbor {IP address} password"
  reference   : "800-171r3|03.05.02,800-53|IA-3(1),800-53r5|IA-3(1),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ITSG-33|IA-3(1),LEVEL|2M,NESA|T5.4.3,QCSC-v1|13.2,TBA-FIISB|27.1"
  see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
  context     : "router bgp [0-9]+"
  regex       : "neighbor .+ password"
  expect      : "^Manual Review Required$"
  severity    : MEDIUM
</custom_item>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      description : "Shared secret profile configured"
      context     : "management security"
      regex       : "session shared-secret profile"
      expect      : "^\s*session shared-secret profile .+$"
    </custom_item>

    <custom_item>
      description : "Shared secret configured with receive and transmit lifetime"
      context     : "management security"
      regex       : "receive-lifetime"
      expect      : "^\s*secret .+ receive-lifetime .+ transmit-lifetime .+$"
    </custom_item>

    <custom_item>
      description : "BGP neighbor using shared secret profile with algorithm"
      context     : "router bgp [0-9]+"
      regex       : "password shared-secret"
      expect      : "^\s*neighbor .+ password shared-secret profile .+ algorithm .+$"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "3.2.2 BGP TCP Authentication Option (TCP-AO)"
      info        : "BGP TCP Authentication Option (TCP-AO) (RFC 5925) support adds a new option for BGP message and TCP segments authentication using superior hashing algorithms such as HMACs and CMACs as an improvement over TCP MD5, with stronger hashing algorithms providing higher security and protection against replays attacks. It also provides better key management by coordinating between the endpoints to rotate to a new secret key or the master key tuple (MKT) without resetting the TCP connection.

EOS supports BGP message authentication via the TCP MD5 Signature (TCP MD5) option (RFC 2385) to protect the BGP sessions from spoofed TCP segments. However, research has shown many concerns that the TCP MD5 algorithm is cryptographically ineffective with a just simple keyed hash for authentication."
      solution    : "Enable TCP-AO using the secret keys in Shared Secret Profile NAME with a specified algorithm:

router bgp {ASN}
 neighbor NEIGHBOR_ID password shared-secret profile NAME algorithm ALGORITHM"
      reference   : "800-171r3|03.05.02,800-53|IA-3(1),800-53r5|IA-3(1),CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(i),HIPAA|164.312(d),ITSG-33|IA-3(1),LEVEL|2M,NESA|T5.4.3,QCSC-v1|13.2,TBA-FIISB|27.1"
      see_also    : "https://workbench.cisecurity.org/benchmarks/25683"
      show_output : YES
    </report>
  </then>
</if>

</check_type>

#<ui_metadata>
#<display_name>DISA Microsoft IIS 10.0 Server STIG v3r7</display_name>
#<spec>
#  <type>DISA STIG</type>
#  <name>Microsoft IIS 10.0 Server</name>
#  <version>3.7.0</version>

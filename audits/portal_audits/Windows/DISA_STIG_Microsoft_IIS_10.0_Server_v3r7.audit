              powershell_args : "$output=(Get-WebConfiguration -Filter system.webServer/staticContent/mimeMap | Where-Object { $_.fileExtension -ieq '.dll' }); if(-not $output){ $result='No entries found' } elseif($output.mimeType -match '^application/'){ $result='application type found' } else { $result='No entries found' }; $result;"
            </custom_item>

            <custom_item>
              type            : AUDIT_POWERSHELL
              description     : "Verify com extension is not included"
              value_type      : POLICY_TEXT
              value_data      : "No entries found"
              powershell_args : "$output=(Get-WebConfiguration -Filter system.webServer/staticContent/mimeMap | Where-Object { $_.fileExtension -ieq '.com' }); if(-not $output){ $result='No entries found' } elseif($output.mimeType -match '^application/'){ $result='application type found' } else { $result='No entries found' }; $result;"
            </custom_item>

            <custom_item>

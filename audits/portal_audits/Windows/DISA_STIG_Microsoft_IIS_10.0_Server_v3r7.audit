<check_type:"Windows" version:"2">
<group_policy:"DISA Microsoft IIS 10.0 Server STIG">

<file_acl:"inetpub">
  <user:"Administrators">
    acl_inheritance : "not inherited"
    acl_apply       : "This folder, subfolders and files"
    acl_allow       : "change permissions" | "create files / write data" | "create folders / append data" | "delete" | "delete subfolder and files" | "full control" | "list folder / read data" | "read attributes" | "read extended attributes" | "read permissions" | "take ownership" | "traverse folder / execute file" | "write attributes" | "write extended attributes"
  </user>

  <user:"SYSTEM">
    acl_inheritance : "not inherited"
    acl_apply       : "This folder, subfolders and files"
    acl_allow       : "change permissions" | "create files / write data" | "create folders / append data" | "delete" | "delete subfolder and files" | "full control" | "list folder / read data" | "read attributes" | "read extended attributes" | "read permissions" | "take ownership" | "traverse folder / execute file" | "write attributes" | "write extended attributes"
  </user>

  <user:"TrustedInstaller">
    acl_inheritance : "not inherited"
    acl_apply       : "This folder, subfolders and files"
    acl_allow       : "change permissions" | "create files / write data" | "create folders / append data" | "delete" | "delete subfolder and files" | "full control" | "list folder / read data" | "read attributes" | "read extended attributes" | "read permissions" | "take ownership" | "traverse folder / execute file" | "write attributes" | "write extended attributes"
  </user>

  <user:"Users">
    acl_inheritance : "not inherited"
    acl_apply       : "This folder, subfolders and files"
    acl_allow       : "list folder / read data" | "read attributes" | "read extended attributes" | "read permissions" | "traverse folder / execute file"
  </user>

  <user:"Creator Owner">
    acl_inheritance : "not inherited"
    acl_apply       : "subfolders and files only"
    acl_allow       : "change permissions" | "create files / write data" | "create folders / append data" | "delete" | "delete subfolder and files" | "full control" | "list folder / read data" | "read attributes" | "read extended attributes" | "read permissions" | "take ownership" | "traverse folder / execute file" | "write attributes" | "write extended attributes"
  </user>

  <user:"ALL APPLICATION PACKAGES">
    acl_inheritance : "not inherited"
    acl_apply       : "This folder, subfolders and files"
    acl_allow       : "list folder / read data" | "read attributes" | "read extended attributes" | "read permissions" | "traverse folder / execute file"
  </user>

  <user:"ALL RESTRICTED APPLICATION PACKAGES">
    acl_inheritance : "not inherited"
    acl_apply       : "This folder, subfolders and files"
    acl_allow       : "list folder / read data" | "read attributes" | "read extended attributes" | "read permissions" | "traverse folder / execute file"
  </user>
</file_acl>

<if>
  <condition type:"AND">
    <custom_item>
      type        : REGISTRY_SETTING
      description : "Verify IIS is installed."
      value_type  : POLICY_TEXT
      value_data  : "(internet|iis)"
      reg_key     : "HKLM\SYSTEM\CurrentControlSet\Services\W3SVC"
      reg_item    : "ImagePath"
      check_type  : CHECK_REGEX
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "Verify IIS 10 installed."
      value_type  : POLICY_TEXT
      value_data  : "^Version @PRODUCT_VERSION@[\s]*$"
      reg_key     : "HKLM\Software\Microsoft\Inetstp"
      reg_item    : "VersionString"
      check_type  : CHECK_REGEX
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "Windows Server 2016/2019/2022 and Windows 10"
      value_type  : POLICY_TEXT
      value_data  : "^[a-zA-Z0-9\(\)\s]*@PLATFORM_VERSION@[a-zA-Z0-9\(\)\s]*$"
      reg_key     : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
      reg_item    : "ProductName"
      check_type  : CHECK_REGEX
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "DISA_STIG_Microsoft_IIS_10.0_Server_v3r7.audit from DISA Microsoft IIS 10.0 Server STIG v3r7"
      see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_IIS_10-0_Y26M07_STIG.zip"
      show_output : YES
    </report>

    <if>
      <condition type:"OR">
        <custom_item>
          type        : REG_CHECK
          description : "Verify WSUS server role is installed (registry)."
          value_type  : POLICY_TEXT
          value_data  : "HKLM\Software\Microsoft\Update Services\Server\Setup"
          reg_option  : MUST_EXIST
        </custom_item>

        <custom_item>
          type            : AUDIT_POWERSHELL
          description     : "Verify WSUS server role is installed (service present, any state)."
          value_type      : POLICY_TEXT
          value_data      : ".*WSUSInstalled.*"
          powershell_args : "if (Get-Service -Name 'WsusService' -ErrorAction SilentlyContinue) {'WSUSInstalled'} else {'NotInstalled'}"
          check_type      : CHECK_REGEX
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "IIST-SV-000103 - Both the log file and Event Tracing for Windows (ETW) for the IIS 10.0 web server must be enabled."
          info        : "Internet Information Services (IIS) on Windows Server 2012 provides basic logging capabilities. However, because IIS takes some time to flush logs to disk, administrators do not have access to logging information in real-time. In addition, text-based log files can be difficult and time-consuming to process.

In IIS 10.0, the administrator has the option of sending logging information to Event Tracing for Windows (ETW). This option gives the administrator the ability to use standard query tools, or create custom tools, for viewing real-time logging information in ETW. This provides a significant advantage over parsing text-based log files that are not updated in real time.

Satisfies: SRG-APP-000092-WSR-000055, SRG-APP-000108-WSR-000166, SRG-APP-000358-WSR-000063"
          solution    : 'Open the IIS 10.0 Manager.

Click the IIS 10.0 server name.

Click the \'Logging\' icon.

Under Log Event Destination, select the \'Both log file and ETW event\' radio button.

Under the \'Actions\' pane, click \'Apply\'.'
          reference   : "800-171|3.3.4,800-171r3|03.03.04a.,800-53|AU-4(1),800-53|AU-5a.,800-53|AU-14(1),800-53r5|AU-4(1),800-53r5|AU-5a.,800-53r5|AU-14(1),CAT|II,CCI|CCI-000139,CCI|CCI-001464,CCI|CCI-001851,CN-L3|7.1.3.3(e),CSF|PR.DS-4,CSF|PR.PT-1,DISA_Benchmark|IIS_10-0_Server_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(b),ISO-27001-2022|A.8.6,ISO-27001-2022|A.8.15,ITSG-33|AU-4,ITSG-33|AU-5a.,ITSG-33|AU-14,NESA|T3.3.1,NESA|T3.6.2,QCSC-v1|8.2.1,QCSC-v1|13.2,Rule-ID|SV-218786r1022652_rule,STIG-ID|IIST-SV-000103,STIG-Legacy|SV-109211,STIG-Legacy|V-100107,SWIFT-CSCv1|6.4,Vuln-ID|V-218786"
          see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_IIS_10-0_Y26M07_STIG.zip"
          show_output : YES
        </report>
      </then>

      <else>
        <custom_item>
          type        : AUDIT_IIS_APPCMD
          description : "IIST-SV-000103 - Both the log file and Event Tracing for Windows (ETW) for the IIS 10.0 web server must be enabled."
          info        : "Internet Information Services (IIS) on Windows Server 2012 provides basic logging capabilities. However, because IIS takes some time to flush logs to disk, administrators do not have access to logging information in real-time. In addition, text-based log files can be difficult and time-consuming to process.

In IIS 10.0, the administrator has the option of sending logging information to Event Tracing for Windows (ETW). This option gives the administrator the ability to use standard query tools, or create custom tools, for viewing real-time logging information in ETW. This provides a significant advantage over parsing text-based log files that are not updated in real time.

Satisfies: SRG-APP-000092-WSR-000055, SRG-APP-000108-WSR-000166, SRG-APP-000358-WSR-000063"
          solution    : 'Open the IIS 10.0 Manager.

Click the IIS 10.0 server name.

Click the \'Logging\' icon.

Under Log Event Destination, select the \'Both log file and ETW event\' radio button.

Under the \'Actions\' pane, click \'Apply\'.'
          reference   : "800-171|3.3.4,800-171r3|03.03.04a.,800-53|AU-4(1),800-53|AU-5a.,800-53|AU-14(1),800-53r5|AU-4(1),800-53r5|AU-5a.,800-53r5|AU-14(1),CAT|II,CCI|CCI-000139,CCI|CCI-001464,CCI|CCI-001851,CN-L3|7.1.3.3(e),CSF|PR.DS-4,CSF|PR.PT-1,DISA_Benchmark|IIS_10-0_Server_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(b),ISO-27001-2022|A.8.6,ISO-27001-2022|A.8.15,ITSG-33|AU-4,ITSG-33|AU-5a.,ITSG-33|AU-14,NESA|T3.3.1,NESA|T3.6.2,QCSC-v1|8.2.1,QCSC-v1|13.2,Rule-ID|SV-218786r1022652_rule,STIG-ID|IIST-SV-000103,STIG-Legacy|SV-109211,STIG-Legacy|V-100107,SWIFT-CSCv1|6.4,Vuln-ID|V-218786"
          see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_IIS_10-0_Y26M07_STIG.zip"
          value_type  : POLICY_TEXT
          value_data  : "File, ETW"
          appcmd_args : "list config /section:system.applicationHost/sites /text:siteDefaults.logfile.logTargetW3C"
        </custom_item>
      </else>
    </if>

    <if>
      <condition type:"OR">
        <custom_item>
          type        : REG_CHECK
          description : "Verify WSUS server role is installed (registry)."
          value_type  : POLICY_TEXT
          value_data  : "HKLM\Software\Microsoft\Update Services\Server\Setup"
          reg_option  : MUST_EXIST
        </custom_item>

        <custom_item>
          type            : AUDIT_POWERSHELL
          description     : "Verify WSUS server role is installed (service present, any state)."
          value_type      : POLICY_TEXT
          value_data      : ".*WSUSInstalled.*"
          powershell_args : "if (Get-Service -Name 'WsusService' -ErrorAction SilentlyContinue) {'WSUSInstalled'} else {'NotInstalled'}"
          check_type      : CHECK_REGEX
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "IIST-SV-000110 - The IIS 10.0 web server must produce log records that contain sufficient information to establish the outcome (success or failure) of IIS 10.0 web server events."
          info        : "Web server logging capability is critical for accurate forensic analysis. Without sufficient and accurate information, a correct replay of the events cannot be determined.

Ascertaining the success or failure of an event is important during forensic analysis. Correctly determining the outcome will add information to the overall reconstruction of the loggable event. By determining the success or failure of the event correctly, analysis of the enterprise can be undertaken to determine if events tied to the event occurred in other areas within the enterprise.

Without sufficient information establishing the success or failure of the logged event, investigation into the cause of event is severely hindered. The success or failure also provides a means to measure the impact of an event and help authorized personnel determine the appropriate response. Log record content that may be necessary to satisfy the requirement of this control includes, but is not limited to, time stamps, source and destination IP addresses, user/process identifiers, event descriptions, application-specific events, success/fail indications, file names involved, access control, or flow control rules invoked."
          solution    : 'Access the IIS 10.0 web server IIS Manager.
Click the IIS 10.0 web server name.
Under \'IIS\', double-click the \'Logging\' icon.
Verify the \'Format:\' under \'Log File\' is configured to \'W3C\'.
Select \'Fields\'.
Under \'Custom Fields\', click \'Add Field...\'.
For each field being added, give a name unique to what the field is capturing.
Click on the \'Source Type\' drop-down list and select \'Request Header\'.
Click the \'Source\' drop-down list, and select \'Connection\'.
Click \'OK\' to add.

Click the \'Source Type\' drop-down list, and select \'Request Header\'.
Click the \'Source\' drop-down list, and select \'Warning\'.
Click \'OK\' to add.
Click \'Apply\' under the \'Actions\' pane.'
          reference   : "800-171|3.3.1,800-171|3.3.2,800-171r3|03.03.02a.,800-53|AU-3,800-53r5|AU-3e.,CAT|II,CCI|CCI-000134,CN-L3|7.1.2.3(a),CN-L3|7.1.2.3(b),CN-L3|7.1.3.3(a),CN-L3|8.1.4.3(b),CSF|PR.PT-1,CSF2.0|PR.PS-04,DISA_Benchmark|IIS_10-0_Server_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(b),ISO-27001-2022|A.5.28,ISO-27001-2022|A.8.15,ITSG-33|AU-3,NESA|T3.6.2,NIAv2|AM34a,NIAv2|AM34b,NIAv2|AM34c,NIAv2|AM34d,NIAv2|AM34e,NIAv2|AM34f,NIAv2|AM34g,PCI-DSSv3.2.1|10.3,PCI-DSSv3.2.1|10.3.1,PCI-DSSv3.2.1|10.3.2,PCI-DSSv3.2.1|10.3.3,PCI-DSSv3.2.1|10.3.4,PCI-DSSv3.2.1|10.3.5,PCI-DSSv3.2.1|10.3.6,PCI-DSSv4.0|10.2.2,QCSC-v1|8.2.1,QCSC-v1|13.2,Rule-ID|SV-218788r1156543_rule,STIG-ID|IIST-SV-000110,STIG-Legacy|SV-109215,STIG-Legacy|V-100111,SWIFT-CSCv1|6.4,Vuln-ID|V-218788"
          see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_IIS_10-0_Y26M07_STIG.zip"
          show_output : YES
        </report>
      </then>

      <else>
        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              type            : AUDIT_POWERSHELL
              description     : "Verify Request Header is set to 'Warning'"
              value_type      : POLICY_TEXT
              value_data      : "Warning"
              powershell_args : "$output=(Get-WebConfiguration -filter 'system.applicationhost/sites/sitedefaults/logfile/customFields' | select -expandproperty collection | where {$_.sourceType -eq 'RequestHeader'} | select sourceName | format-table -HideTableHeaders); foreach-object { if(!$output){ $result='No entries found' } else { $result=$output }; $result };"
              check_type      : CHECK_REGEX
            </custom_item>

            <custom_item>
              type        : AUDIT_IIS_APPCMD
              description : "Verify log format is W3C"
              value_type  : POLICY_TEXT
              value_data  : "W3C"
              appcmd_args : "list config /section:system.applicationHost/sites /text:siteDefaults.logfile.logFormat"
              check_type  : CHECK_REGEX
            </custom_item>

            <custom_item>
              type            : AUDIT_POWERSHELL
              description     : "Verify Request Header is set to 'Connection'"
              value_type      : POLICY_TEXT
              value_data      : "Connection"
              powershell_args : "$output=(Get-WebConfiguration -filter 'system.applicationhost/sites/sitedefaults/logfile/customFields' | select -expandproperty collection | where {$_.sourceType -eq 'RequestHeader'} | select sourceName | format-table -HideTableHeaders); foreach-object { if(!$output){ $result='No entries found' } else { $result=$output }; $result };"
              check_type      : CHECK_REGEX
            </custom_item>
          </condition>

          <then>
            <report type:"PASSED">
              description : "IIST-SV-000110 - The IIS 10.0 web server must produce log records that contain sufficient information to establish the outcome (success or failure) of IIS 10.0 web server events."
              info        : "Web server logging capability is critical for accurate forensic analysis. Without sufficient and accurate information, a correct replay of the events cannot be determined.

Ascertaining the success or failure of an event is important during forensic analysis. Correctly determining the outcome will add information to the overall reconstruction of the loggable event. By determining the success or failure of the event correctly, analysis of the enterprise can be undertaken to determine if events tied to the event occurred in other areas within the enterprise.

Without sufficient information establishing the success or failure of the logged event, investigation into the cause of event is severely hindered. The success or failure also provides a means to measure the impact of an event and help authorized personnel determine the appropriate response. Log record content that may be necessary to satisfy the requirement of this control includes, but is not limited to, time stamps, source and destination IP addresses, user/process identifiers, event descriptions, application-specific events, success/fail indications, file names involved, access control, or flow control rules invoked."
              solution    : 'Access the IIS 10.0 web server IIS Manager.
Click the IIS 10.0 web server name.
Under \'IIS\', double-click the \'Logging\' icon.
Verify the \'Format:\' under \'Log File\' is configured to \'W3C\'.
Select \'Fields\'.
Under \'Custom Fields\', click \'Add Field...\'.
For each field being added, give a name unique to what the field is capturing.
Click on the \'Source Type\' drop-down list and select \'Request Header\'.
Click the \'Source\' drop-down list, and select \'Connection\'.
Click \'OK\' to add.

Click the \'Source Type\' drop-down list, and select \'Request Header\'.
Click the \'Source\' drop-down list, and select \'Warning\'.
Click \'OK\' to add.
Click \'Apply\' under the \'Actions\' pane.'
              reference   : "800-171|3.3.1,800-171|3.3.2,800-171r3|03.03.02a.,800-53|AU-3,800-53r5|AU-3e.,CAT|II,CCI|CCI-000134,CN-L3|7.1.2.3(a),CN-L3|7.1.2.3(b),CN-L3|7.1.3.3(a),CN-L3|8.1.4.3(b),CSF|PR.PT-1,CSF2.0|PR.PS-04,DISA_Benchmark|IIS_10-0_Server_STIG,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(b),ISO-27001-2022|A.5.28,ISO-27001-2022|A.8.15,ITSG-33|AU-3,NESA|T3.6.2,NIAv2|AM34a,NIAv2|AM34b,NIAv2|AM34c,NIAv2|AM34d,NIAv2|AM34e,NIAv2|AM34f,NIAv2|AM34g,PCI-DSSv3.2.1|10.3,PCI-DSSv3.2.1|10.3.1,PCI-DSSv3.2.1|10.3.2,PCI-DSSv3.2.1|10.3.3,PCI-DSSv3.2.1|10.3.4,PCI-DSSv3.2.1|10.3.5,PCI-DSSv3.2.1|10.3.6,PCI-DSSv4.0|10.2.2,QCSC-v1|8.2.1,QCSC-v1|13.2,Rule-ID|SV-218788r1156543_rule,STIG-ID|IIST-SV-000110,STIG-Legacy|SV-109215,STIG-Legacy|V-100111,SWIFT-CSCv1|6.4,Vuln-ID|V-218788"

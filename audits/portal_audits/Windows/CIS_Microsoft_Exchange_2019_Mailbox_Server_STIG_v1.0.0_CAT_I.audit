# description : This .audit is designed against the CIS Microsoft Exchange 2019 Mailbox Server STIG Benchmark v1.0.0
#
#<ui_metadata>
#<display_name>CIS Microsoft Exchange 2019 Mailbox Server STIG v1.0.0 CAT I</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Microsoft Exchange 2019 Mailbox Server STIG</name>
#  <profile>CAT I</profile>
#  <version>1.0.0</version>

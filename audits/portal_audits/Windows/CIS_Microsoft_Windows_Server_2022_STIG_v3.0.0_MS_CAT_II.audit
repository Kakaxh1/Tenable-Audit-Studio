      reference   : "800-171r3|03.05.01b.,800-53|IA-11,800-53r5|IA-11,CAT|II,CCI|CCI-002038,CSF|PR.AC-1,CSF2.0|PR.AA-01,CSF2.0|PR.AA-03,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(d),LEVEL|2A,QCSC-v1|13.2,Rule-ID|SV-254383r1051100_rule,STIG-ID|WN22-CC-000520,Vuln-ID|V-254383"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22357"
      value_type  : POLICY_DWORD

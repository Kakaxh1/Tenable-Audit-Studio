    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.145 WN22-CC-000520"
      info        : "Windows Server 2022 Windows Remote Management (WinRM) service must not store RunAs credentials.

GROUP ID: V-254383
RULE ID: SV-254383r1051100


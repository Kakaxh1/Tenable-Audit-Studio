              see_also    : "https://workbench.cisecurity.org/benchmarks/22357"
              value_type  : USER_RIGHT
              value_data  : (("Domain Admins" && "Enterprise Admins" && "Local Account" && "Guests") || ("Domain Admins" && "Enterprise Admins" && "Local account and member of Administrators group" && "Guests"))
              right_type  : SeDenyNetworkLogonRight
              check_type  : CHECK_SUPERSET
            </custom_item>
          </then>

          <else>
            <custom_item>
              type        : USER_RIGHTS_POLICY
              description : "1.198 WN22-MS-000080"

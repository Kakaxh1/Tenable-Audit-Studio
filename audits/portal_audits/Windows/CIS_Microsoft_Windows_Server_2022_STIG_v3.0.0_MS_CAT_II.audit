      see_also    : "https://workbench.cisecurity.org/benchmarks/22357"
      value_type  : USER_RIGHT
      value_data  : "Administrators" || ("Auditors" && "Administrators")
      right_type  : SeSecurityPrivilege
    </custom_item>

    <custom_item>
      type        : USER_RIGHTS_POLICY
      description : "1.271 WN22-UR-000180"
      info        : 'Windows Server 2022 modify firmware environment values user right must only be assigned to the Administrators group.


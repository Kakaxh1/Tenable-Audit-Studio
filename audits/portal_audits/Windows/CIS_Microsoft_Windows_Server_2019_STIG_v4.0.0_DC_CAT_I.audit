#
# description : This .audit is designed against the CIS Microsoft Windows Server 2019 STIG Benchmark v4.0.0
#
#<ui_metadata>
#<display_name>CIS Microsoft Windows Server 2019 STIG v4.0.0 DC CAT I</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Microsoft Windows Server 2019 STIG</name>
#  <profile>DC CAT I</profile>
#  <version>4.0.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/22176</link>
#</spec>
#<labels>agent,windows_server_dc_2019</labels>
#<benchmark_refs>800-53,800-53r5,CAT,CCI,LEVEL,Rule-ID,STIG-ID,Vuln-ID</benchmark_refs>
#<variables>
#  <variable>
#    <name>PLATFORM_VERSION</name>
#    <default>2019</default>
#    <description>Windows Server Version</description>
#    <info>Windows Server Version</info>
#    <value_type>INTEGER</value_type>
#  </variable>
#</variables>
#</ui_metadata>

<check_type:"Windows" version:"2">
<group_policy:"CIS Microsoft Windows Server 2019 STIG">

<if>
  <condition type:"AND">
    <custom_item>
      type        : REGISTRY_SETTING
      description : "Windows Server 2019 is installed"
      value_type  : POLICY_TEXT
      value_data  : "^[a-zA-Z0-9\(\)\s]*@PLATFORM_VERSION@[\s]*[a-zA-Z0-9\(\)\s:]*$"
      reg_key     : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
      reg_item    : "ProductName"
      check_type  : CHECK_REGEX
    </custom_item>

    <custom_item>
      type          : WMI_POLICY
      description   : "Check if server is Domain Controller"
      value_type    : POLICY_DWORD
      value_data    : 4 || 5
      wmi_namespace : "root/CIMV2"
      wmi_request   : "select DomainRole from Win32_ComputerSystem"
      wmi_attribute : "DomainRole"
      wmi_key       : "DomainRole"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "CIS_Microsoft_Windows_Server_2019_STIG_v4.0.0_DC_CAT_I.audit from CIS Microsoft Windows Server 2019 STIG v4.0.0"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      show_output : YES
    </report>

    <report type:"WARNING">
      description : "1.1 WN19-00-000010"
      info        : "Windows Server 2019 users with Administrative privileges must have separate accounts for administrative duties and normal operational tasks.

GROUP ID: V-205844
RULE ID: SV-205844r991589

Using a privileged account to perform routine functions makes the computer vulnerable to malicious software inadvertently introduced during a session that has been granted full privileges.

NOTE: Nessus has not performed this check. Please review the benchmark to ensure target compliance."
      solution    : "Ensure each user with administrative privileges has a separate account for user duties and one for privileged duties."
      reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CAT|I,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,LEVEL|1M,NESA|T3.2.1,Rule-ID|SV-205844r991589_rule,STIG-ID|WN19-00-000010,SWIFT-CSCv1|2.3,Vuln-ID|V-205844"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
    </report>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.10 WN19-00-000100"
      info        : "Windows Server 2019 must be maintained at a supported servicing level.

GROUP ID:V-205849
RULE ID:SV-205849r991589

Systems at unsupported servicing levels will not receive security updates for new vulnerabilities, which leave them subject to exploitation. Systems must be maintained at a servicing level supported by the vendor with new security updates"
      solution    : "Update the system to a Version 1809 (Build 17763.xxx) or greater."
      reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CAT|I,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,LEVEL|1M,NESA|T3.2.1,Rule-ID|SV-205849r991589_rule,STIG-ID|WN19-00-000100,SWIFT-CSCv1|2.3"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type  : POLICY_TEXT
      value_data  : "^(1776[3-9]|177[7-9][0-9]|17[8-9][0-9]{2}|1[8-9][0-9]{3}|[2-9][0-9]{4})"
      reg_key     : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
      reg_item    : "CurrentBuildNumber"
      check_type  : CHECK_REGEX
    </custom_item>

    <custom_item>
      type            : AUDIT_POWERSHELL
      description     : "1.11 WN19-00-000110"
      info            : "Windows Server 2019 must use an anti-virus program.

GROUP ID:V-205850
RULE ID:SV-205850r991589

Malicious software can establish a base on individual desktops and servers. Employing an automated mechanism to detect this type of software will aid in elimination of the software from the operating system.

NOTE: Nessus has provided the target output to assist in reviewing the benchmark to ensure target compliance."
      solution        : 'If no anti-virus software is in use, install Windows Defender or third-party anti-virus.

Open \'PowerShell\'.

Enter

Install-WindowsFeature -Name Windows-Defender

For third-party anti-virus, install per anti-virus instructions and disable Windows Defender.

Open \'PowerShell\'.

Enter

Uninstall-WindowsFeature -Name Windows-Defender'
      reference       : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CAT|I,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,LEVEL|1M,NESA|T3.2.1,Rule-ID|SV-205850r991589_rule,STIG-ID|WN19-00-000110,SWIFT-CSCv1|2.3"
      see_also        : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type      : POLICY_TEXT
      value_data      : "^Manual Review Required$"
      powershell_args : "get-service | where {($_.DisplayName -Like '*Defender*') -or ($_.DisplayName -Like '*symantec*') -or ($_.DisplayName -Like '*mcafee*')} | Select Status,DisplayName"
      severity        : MEDIUM
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.114 WN19-CC-000210"
      info        : "Windows Server 2019 Autoplay must be turned off for non-volume devices.

GROUP ID:V-205804
RULE ID:SV-205804r958804

Allowing AutoPlay to execute may introduce malicious code to a system. AutoPlay begins reading from a drive as soon as media is inserted into the drive. As a result, the setup file of programs or music on audio media may start. This setting will disable AutoPlay for non-volume devices, such as Media Transfer Protocol (MTP) devices."
      solution    : 'Configure the policy value for

Computer Configuration >> Administrative Templates >> Windows Components >> AutoPlay Policies >> \'Disallow Autoplay for non-volume devices\' to \'Enabled\'.'
      reference   : "800-171|3.4.7,800-171r3|03.04.06,800-53|CM-7(2),800-53r5|CM-7(2),CAT|I,CCI|CCI-001764,CSF|PR.IP-1,CSF|PR.PT-3,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|CM-7(2),LEVEL|1A,NIAv2|SS15a,PCI-DSSv3.2.1|2.2.2,QCSC-v1|3.2,Rule-ID|SV-205804r958804_rule,STIG-ID|WN19-CC-000210,SWIFT-CSCv1|2.3"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type  : POLICY_DWORD
      value_data  : "1"
      reg_key     : "HKLM\Software\Policies\Microsoft\Windows\Explorer"
      reg_item    : "NoAutoplayfornonVolume"
      reg_option  : CAN_NOT_BE_NULL
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.115 WN19-CC-000220"
      info        : "Windows Server 2019 default AutoRun behavior must be configured to prevent AutoRun commands.

GROUP ID:V-205805
RULE ID:SV-205805r958804

Allowing AutoRun commands to execute may introduce malicious code to a system. Configuring this setting prevents AutoRun commands from executing."
      solution    : 'Configure the policy value for

Computer Configuration >> Administrative Templates >> Windows Components >> AutoPlay Policies >> \'Set the default behavior for AutoRun\' to \'Enabled\' with \'Do not execute any autorun commands\' selected.'
      reference   : "800-171|3.4.7,800-171r3|03.04.06,800-53|CM-7(2),800-53r5|CM-7(2),CAT|I,CCI|CCI-001764,CSF|PR.IP-1,CSF|PR.PT-3,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|CM-7(2),LEVEL|1A,NIAv2|SS15a,PCI-DSSv3.2.1|2.2.2,QCSC-v1|3.2,Rule-ID|SV-205805r958804_rule,STIG-ID|WN19-CC-000220,SWIFT-CSCv1|2.3"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type  : POLICY_DWORD
      value_data  : "1"
      reg_key     : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
      reg_item    : "NoAutorun"
      reg_option  : CAN_NOT_BE_NULL
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.116 WN19-CC-000230"
      info        : "Windows Server 2019 AutoPlay must be disabled for all drives.

GROUP ID:V-205806
RULE ID:SV-205806r958804

Allowing AutoPlay to execute may introduce malicious code to a system. AutoPlay begins reading from a drive as soon media is inserted into the drive. As a result, the setup file of programs or music on audio media may start. By default, AutoPlay is disabled on removable drives, such as the floppy disk drive (but not the CD-ROM drive) and on network drives. Enabling this policy disables AutoPlay on all drives."
      solution    : 'Configure the policy value for

Computer Configuration >> Administrative Templates >> Windows Components >> AutoPlay Policies >> \'Turn off AutoPlay\' to \'Enabled\' with \'All Drives\' selected.'
      reference   : "800-171|3.4.7,800-171r3|03.04.06,800-53|CM-7(2),800-53r5|CM-7(2),CAT|I,CCI|CCI-001764,CSF|PR.IP-1,CSF|PR.PT-3,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|CM-7(2),LEVEL|1A,NIAv2|SS15a,PCI-DSSv3.2.1|2.2.2,QCSC-v1|3.2,Rule-ID|SV-205806r958804_rule,STIG-ID|WN19-CC-000230,SWIFT-CSCv1|2.3"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type  : POLICY_DWORD
      value_data  : "255"
      reg_key     : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
      reg_item    : "NoDriveTypeAutoRun"
      reg_option  : CAN_NOT_BE_NULL
    </custom_item>

    <custom_item>
      type            : AUDIT_POWERSHELL
      description     : "1.13 WN19-00-000130"
      info            : "Windows Server 2019 local volumes must use a format that supports NTFS attributes.

GROUP ID:V-205663
RULE ID:SV-205663r958472

The ability to set access permissions and auditing is critical to maintaining the security and proper access controls of a system. To support this, volumes must be formatted using a file system that supports NTFS attributes."
      solution        : "Format volumes to use NTFS or ReFS."
      reference       : "800-171|3.1.1,800-171r3|03.01.02,800-53|AC-3,800-53r5|AC-3,CAT|I,CCI|CCI-000213,CN-L3|8.1.4.2(f),CN-L3|8.1.4.11(b),CN-L3|8.1.10.2(c),CN-L3|8.5.3.1,CN-L3|8.5.4.1(a),CSF|PR.AC-4,CSF|PR.PT-3,CSF2.0|PR.AA-05,CSF2.0|PR.DS-10,CSF2.0|PR.IR-01,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.15,ISO-27001-2022|A.5.33,ISO-27001-2022|A.8.3,ISO-27001-2022|A.8.18,ISO-27001-2022|A.8.20,ISO/IEC-27001|A.9.4.1,ISO/IEC-27001|A.9.4.5,ITSG-33|AC-3,LEVEL|1M,NESA|T4.2.1,NESA|T5.4.4,NESA|T5.4.5,NESA|T5.5.4,NESA|T5.6.1,NESA|T7.5.2,NESA|T7.5.3,NIAv2|AM3,NIAv2|SS29,QCSC-v1|3.2,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-205663r958472_rule,STIG-ID|WN19-00-000130,TBA-FIISB|31.1"
      see_also        : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type      : POLICY_TEXT
      value_data      : "None"
      powershell_args : "[Array]$volumes=@(Get-Volume | Where {$_.DriveType -eq 'Fixed'} | Where {$_.FileSystem -ne 'NTFS'} | Where {$_.FileSystem -ne 'ReFS'} | Select DriveLetter, FileSystemLabel, FileSystemType, Path); [Array]$partitions=@(Get-Partition | Where {$_.Type -eq 'System'} | Where {$_.IsSystem -eq 'True'} | Select AccessPaths); $offenders = $volumes; ForEach ($partition in $partitions) { ForEach ($volume in $volumes) { if ($volume.Path -eq $partition.AccessPaths) { $offenders = $volumes -ne $volume } } } if ($offenders) {$offenders} else {'None'}"
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.136 WN19-CC-000430"
      info        : "Windows Server 2019 must disable the Windows Installer Always install with elevated privileges option.

GROUP ID:V-205802
RULE ID:SV-205802r1051079

Standard user accounts must not be granted elevated privileges. Enabling Windows Installer to elevate privileges when installing applications can allow malicious persons and applications to gain full control of a system."
      solution    : 'Configure the policy value for

Computer Configuration >> Administrative Templates >> Windows Components >> Windows Installer >> \'Always install with elevated privileges\' to \'Disabled\'.'
      reference   : "800-171|3.4.9,800-53|CM-11(2),800-53r5|CM-11(2),CAT|I,CCI|CCI-001812,CCI|CCI-003980,CSF|DE.CM-3,CSF2.0|DE.CM-03,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,CSF2.0|PR.PS-02,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.19,ISO/IEC-27001|A.12.6.2,LEVEL|1A,QCSC-v1|8.2.1,Rule-ID|SV-205802r1051079_rule,STIG-ID|WN19-CC-000430,SWIFT-CSCv1|5.1"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type  : POLICY_DWORD
      value_data  : "0"
      reg_key     : "HKLM\Software\Policies\Microsoft\Windows\Installer"
      reg_item    : "AlwaysInstallElevated"
      reg_option  : CAN_NOT_BE_NULL
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.140 WN19-CC-000470"
      info        : "Windows Server 2019 Windows Remote Management (WinRM) client must not use Basic authentication.

GROUP ID:V-205711
RULE ID:SV-205711r958510

Basic authentication uses plain-text passwords that could be used to compromise a system. Disabling Basic authentication will reduce this potential."
      solution    : 'Configure the policy value for

Computer Configuration >> Administrative Templates >> Windows Components >> Windows Remote Management (WinRM) >> WinRM Client >> \'Allow Basic authentication\' to \'Disabled\'.'
      reference   : "800-171|3.7.5,800-171r3|03.07.05b.,800-53|MA-4c.,800-53r5|MA-4c.,CAT|I,CCI|CCI-000877,CSF|PR.MA-2,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|MA-4c.,LEVEL|1A,NESA|T2.3.4,NESA|T5.4.4,QCSC-v1|5.2.2,Rule-ID|SV-205711r958510_rule,STIG-ID|WN19-CC-000470,TBA-FIISB|45.2.3"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type  : POLICY_DWORD
      value_data  : "0"
      reg_key     : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Client"
      reg_item    : "AllowBasic"
      reg_option  : CAN_NOT_BE_NULL
    </custom_item>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.143 WN19-CC-000500"
      info        : "Windows Server 2019 Windows Remote Management (WinRM) service must not use Basic authentication.

GROUP ID:V-205713
RULE ID:SV-205713r958510

Basic authentication uses plain-text passwords that could be used to compromise a system. Disabling Basic authentication will reduce this potential."
      solution    : 'Configure the policy value for

Computer Configuration >> Administrative Templates >> Windows Components >> Windows Remote Management (WinRM) >> WinRM Service >> \'Allow Basic authentication\' to \'Disabled\'.'
      reference   : "800-171|3.7.5,800-171r3|03.07.05b.,800-53|MA-4c.,800-53r5|MA-4c.,CAT|I,CCI|CCI-000877,CSF|PR.MA-2,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|MA-4c.,LEVEL|1A,NESA|T2.3.4,NESA|T5.4.4,QCSC-v1|5.2.2,Rule-ID|SV-205713r958510_rule,STIG-ID|WN19-CC-000500,TBA-FIISB|45.2.3"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
      value_type  : POLICY_DWORD
      value_data  : "0"
      reg_key     : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Service"
      reg_item    : "AllowBasic"
      reg_option  : CAN_NOT_BE_NULL
    </custom_item>

    <if>
      <condition type:"AND">
        <custom_item>
          type          : WMI_POLICY
          description   : "Check if server is Domain Controller"
          value_type    : POLICY_DWORD
          value_data    : "4" || "5"
          wmi_namespace : "root/CIMV2"
          wmi_request   : "select DomainRole from Win32_ComputerSystem"
          wmi_attribute : "DomainRole"
          wmi_key       : "DomainRole"
        </custom_item>
      </condition>

      <then>
        <custom_item>
          type            : AUDIT_POWERSHELL
          description     : "1.147 WN19-DC-000010"
          info            : "Windows Server 2019 must only allow administrators responsible for the domain controller to have Administrator rights on the system.

GROUP ID:V-205738
RULE ID:SV-205738r958726

An account that does not have Administrator duties must not have Administrator rights. Such rights would allow the account to bypass or modify required security restrictions on that machine and make it vulnerable to attack.

System administrators must log on to systems using only accounts with the minimum level of authority necessary.

Standard user accounts must not be members of the built-in Administrators group.

NOTE: Nessus has provided the target output to assist in reviewing the benchmark to ensure target compliance."
          solution        : "Configure the Administrators group to include only administrator groups or accounts that are responsible for the system.

Remove any standard user accounts."
          reference       : "800-171|3.1.7,800-171r3|03.01.07a.,800-53|AC-6(10),800-53r5|AC-6(10),CAT|I,CCI|CCI-002235,CN-L3|7.1.3.2(b),CN-L3|7.1.3.2(g),CN-L3|8.1.4.2(d),CN-L3|8.1.10.6(a),CSF|PR.AC-4,CSF2.0|PR.AA-05,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.15,ISO-27001-2022|A.8.2,ISO-27001-2022|A.8.18,ITSG-33|AC-6,LEVEL|1M,NESA|T5.1.1,NESA|T5.2.2,NESA|T5.4.1,NESA|T5.4.4,NESA|T5.4.5,NESA|T5.5.4,NESA|T5.6.1,NESA|T7.5.3,NIAv2|AM1,NIAv2|AM23f,NIAv2|SS13c,NIAv2|SS15c,PCI-DSSv3.2.1|7.1.2,PCI-DSSv4.0|7.2.1,PCI-DSSv4.0|7.2.2,QCSC-v1|5.2.2,QCSC-v1|6.2,Rule-ID|SV-205738r958726_rule,STIG-ID|WN19-DC-000010,SWIFT-CSCv1|5.1,TBA-FIISB|31.4.2,TBA-FIISB|31.4.3"
          see_also        : "https://workbench.cisecurity.org/benchmarks/22176"
          value_type      : POLICY_TEXT
          value_data      : "^Manual Review Required$"
          powershell_args : '$obj_group = [ADSI]\'WinNT://localhost/Administrators,group\'; \'ADMINISTRATORS:\'; @($obj_group.psbase.Invoke(\'Members\')) | foreach{ ([ADSI]$_).InvokeGet(\'Name\') };'
          severity        : MEDIUM
        </custom_item>
      </then>

      <else>
        <report type:"PASSED">
          description : "1.147 WN19-DC-000010"
          info        : "Windows Server 2019 must only allow administrators responsible for the domain controller to have Administrator rights on the system.

GROUP ID:V-205738
RULE ID:SV-205738r958726

An account that does not have Administrator duties must not have Administrator rights. Such rights would allow the account to bypass or modify required security restrictions on that machine and make it vulnerable to attack.

System administrators must log on to systems using only accounts with the minimum level of authority necessary.

Standard user accounts must not be members of the built-in Administrators group."
          solution    : "Configure the Administrators group to include only administrator groups or accounts that are responsible for the system.

Remove any standard user accounts."
          reference   : "800-171|3.1.7,800-171r3|03.01.07a.,800-53|AC-6(10),800-53r5|AC-6(10),CAT|I,CCI|CCI-002235,CN-L3|7.1.3.2(b),CN-L3|7.1.3.2(g),CN-L3|8.1.4.2(d),CN-L3|8.1.10.6(a),CSF|PR.AC-4,CSF2.0|PR.AA-05,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.15,ISO-27001-2022|A.8.2,ISO-27001-2022|A.8.18,ITSG-33|AC-6,LEVEL|1M,NESA|T5.1.1,NESA|T5.2.2,NESA|T5.4.1,NESA|T5.4.4,NESA|T5.4.5,NESA|T5.5.4,NESA|T5.6.1,NESA|T7.5.3,NIAv2|AM1,NIAv2|AM23f,NIAv2|SS13c,NIAv2|SS15c,PCI-DSSv3.2.1|7.1.2,PCI-DSSv4.0|7.2.1,PCI-DSSv4.0|7.2.2,QCSC-v1|5.2.2,QCSC-v1|6.2,Rule-ID|SV-205738r958726_rule,STIG-ID|WN19-DC-000010,SWIFT-CSCv1|5.1,TBA-FIISB|31.4.2,TBA-FIISB|31.4.3"
          see_also    : "https://workbench.cisecurity.org/benchmarks/22176"
        </report>
      </else>
    </if>

    <if>
      <condition type:"AND">
        <custom_item>
          type          : WMI_POLICY
          description   : "Check if server is Domain Controller"
          value_type    : POLICY_DWORD
          value_data    : "4" || "5"
          wmi_namespace : "root/CIMV2"

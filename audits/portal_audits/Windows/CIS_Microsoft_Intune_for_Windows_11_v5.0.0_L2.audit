      see_also    : "https://workbench.cisecurity.org/benchmarks/27282"
      value_type  : POLICY_DWORD
      value_data  : "0"
      reg_key     : "HKLM\SOFTWARE\Policies\Microsoft\Windows\CurrentVersion\AppModel\StateManager"
      reg_item    : "AllowSharedLocalAppData"

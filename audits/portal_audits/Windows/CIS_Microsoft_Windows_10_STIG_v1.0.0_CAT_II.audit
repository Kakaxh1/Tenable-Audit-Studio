    </custom_item>

    <if>
      <condition type:"AND">
        <custom_item>
          type        : REGISTRY_SETTING
          description : "Network access: Let Everyone permissions apply to anonymous users is set to Disabled (WN11-SO-000160)"
          value_type  : POLICY_DWORD
          value_data  : "0"
          reg_key     : "HKLM\SYSTEM\CurrentControlSet\Control\Lsa"
          reg_item    : "EveryoneIncludesAnonymous"
          reg_option  : CAN_NOT_BE_NULL
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "1.21 WN10-00-000095"
          info        : "Permissions for system files and directories must conform to minimum requirements.

GROUP ID: V-220717RULE ID: SV-220717r1081048

Changing the system's file and directory permissions allows the possibility of unauthorized and anonymous modification to the operating system and installed applications."
          solution    : 'Maintain the default file system permissions and configure the Security Option: \'Network access: Let everyone permissions apply to anonymous users\' to \'Disabled\' (WN10-SO-000160).'
          reference   : "800-171|3.1.1,800-171r3|03.01.02,800-53|AC-3(4),800-53r5|AC-3(4),CCI|CCI-002165,CN-L3|8.1.4.2(f),CN-L3|8.1.4.11(b),CN-L3|8.1.10.2(c),CN-L3|8.5.3.1,CN-L3|8.5.4.1(a),CSF|PR.AC-4,CSF|PR.PT-3,CSF2.0|PR.AA-05,CSF2.0|PR.DS-10,CSF2.0|PR.IR-01,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.15,ISO-27001-2022|A.5.33,ISO-27001-2022|A.8.3,ISO-27001-2022|A.8.18,ISO-27001-2022|A.8.20,ISO/IEC-27001|A.9.4.1,ISO/IEC-27001|A.9.4.5,ITSG-33|AC-3(4),LEVEL|2M,NESA|T4.2.1,NESA|T5.4.4,NESA|T5.4.5,NESA|T5.5.4,NESA|T5.6.1,NESA|T7.5.2,NESA|T7.5.3,NIAv2|AM3,NIAv2|SS29,QCSC-v1|3.2,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-220717r1081048_rule,STIG-ID|WN10-00-000095,TBA-FIISB|31.1,Vuln-ID|V-220717"
          see_also    : "https://workbench.cisecurity.org/benchmarks/23869"
        </report>
      </then>

      <else>
        <if>
          <condition auto:"FAILED" type:"AND">
            <custom_item>
              type            : AUDIT_POWERSHELL
              description     : "c:\"
              value_type      : POLICY_TEXT
              value_data      : "STATUS: PASSED"
              powershell_args : "$f = $env:SYSTEMDRIVE + '\';
      $acls = (icacls $f);
      $status = 'PASSED';
      foreach ($acl in $acls) {
        if (!$acl) { continue }
        elseif ($acl -like '*S-1-15-3-65536-1888954469-739942743-1668119174-2468466756-4239452838-1296943325-355587736-700089176:(S,RD,X,RA)') { continue }
        elseif ($acl -like '*NT AUTHORITY\SYSTEM:(OI)(CI)(F)') { continue }
        elseif ($acl -like '*BUILTIN\Administrators:(OI)(CI)(F)') { continue }
        elseif ($acl -like '*BUILTIN\Users:(OI)(CI)(RX)') { continue }
        elseif ($acl -like '*NT AUTHORITY\Authenticated Users:(OI)(CI)(IO)(M)') { continue }
        elseif ($acl -like '*NT AUTHORITY\Authenticated Users:(AD)') { continue }
        elseif ($acl -like '*Mandatory Label\High Mandatory Level:(OI)(NP)(IO)(NW)') { continue }
        elseif ($acl -like 'Successfully processed*') { continue }
        $status = 'FAILED'
      }
      $acls;
      '';
      'STATUS: '+$status"
              check_type      : CHECK_REGEX
            </custom_item>

            <custom_item>
              type            : AUDIT_POWERSHELL
              description     : "c:\program files"
              value_type      : POLICY_TEXT
              value_data      : "STATUS: PASSED"
              powershell_args : "$f = $env:PROGRAMFILES;
      $acls = (icacls $f);
      $status = 'PASSED';
      foreach ($acl in $acls) {
        if (!$acl) { continue }
        elseif ($acl -like '*NT SERVICE\TrustedInstaller:*(F)') { continue }
        elseif ($acl -like '*NT SERVICE\TrustedInstaller:*(CI)(IO)(F)') { continue }
        elseif ($acl -like '*NT AUTHORITY\SYSTEM:*(M)') { continue }
        elseif ($acl -like '*NT AUTHORITY\SYSTEM:*(OI)(CI)(IO)(F)') { continue }
        elseif ($acl -like '*BUILTIN\Administrators:*(M)') { continue }
        elseif ($acl -like '*BUILTIN\Administrators:*(OI)(CI)(IO)(F)') { continue }
        elseif ($acl -like '*BUILTIN\Users:*(RX)') { continue }
        elseif ($acl -like '*BUILTIN\Users:*(OI)(CI)(IO)(GR,GE)') { continue }
        elseif ($acl -like '*CREATOR OWNER:*(OI)(CI)(IO)(F)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL APPLICATION PACKAGES:*(RX)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL APPLICATION PACKAGES:*(OI)(CI)(IO)(GR,GE)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL RESTRICTED APPLICATION PACKAGES:*(RX)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL RESTRICTED APPLICATION PACKAGES:*(OI)(CI)(IO)(GR,GE)') { continue }
        elseif ($acl -like 'Successfully processed*') { continue }
        $status = 'FAILED'
      }
      $acls;
      '';
      'STATUS: '+$status"
              check_type      : CHECK_REGEX
            </custom_item>

            <custom_item>
              type            : AUDIT_POWERSHELL
              description     : "c:\windows"
              value_type      : POLICY_TEXT
              value_data      : "STATUS: PASSED"
              powershell_args : "$f = $env:SystemRoot;
      $acls = (icacls $f);
      $status = 'PASSED';
      foreach ($acl in $acls) {
        if (!$acl) { continue }
        elseif ($acl -like '*NT SERVICE\TrustedInstaller:(F)') { continue }
        elseif ($acl -like '*NT SERVICE\TrustedInstaller:(CI)(IO)(F)') { continue }
        elseif ($acl -like '*NT AUTHORITY\SYSTEM:*(M)') { continue }
        elseif ($acl -like '*NT AUTHORITY\SYSTEM:*(OI)(CI)(IO)(F)') { continue }
        elseif ($acl -like '*BUILTIN\Administrators:*(M)') { continue }
        elseif ($acl -like '*BUILTIN\Administrators:*(OI)(CI)(IO)(F)') { continue }
        elseif ($acl -like '*BUILTIN\Users:*(RX)') { continue }
        elseif ($acl -like '*BUILTIN\Users:*(OI)(CI)(IO)(GR,GE)') { continue }
        elseif ($acl -like '*CREATOR OWNER:*(OI)(CI)(IO)(F)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL APPLICATION PACKAGES:*(RX)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL APPLICATION PACKAGES:*(OI)(CI)(IO)(GR,GE)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL RESTRICTED APPLICATION PACKAGES:*(RX)') { continue }
        elseif ($acl -like '*APPLICATION PACKAGE AUTHORITY\ALL RESTRICTED APPLICATION PACKAGES:*(OI)(CI)(IO)(GR,GE)') { continue }
        elseif ($acl -like 'Successfully processed*') { continue }
        $status = 'FAILED'
      }
      $acls;
      '';
      'STATUS: '+$status"
              check_type      : CHECK_REGEX
            </custom_item>
          </condition>

          <then>
            <report type:"PASSED">
              description : "1.21 WN10-00-000095"
              info        : "Permissions for system files and directories must conform to minimum requirements.

GROUP ID: V-220717RULE ID: SV-220717r1081048

Changing the system's file and directory permissions allows the possibility of unauthorized and anonymous modification to the operating system and installed applications."
              solution    : 'Maintain the default file system permissions and configure the Security Option: \'Network access: Let everyone permissions apply to anonymous users\' to \'Disabled\' (WN10-SO-000160).'
              reference   : "800-171|3.1.1,800-171r3|03.01.02,800-53|AC-3(4),800-53r5|AC-3(4),CCI|CCI-002165,CN-L3|8.1.4.2(f),CN-L3|8.1.4.11(b),CN-L3|8.1.10.2(c),CN-L3|8.5.3.1,CN-L3|8.5.4.1(a),CSF|PR.AC-4,CSF|PR.PT-3,CSF2.0|PR.AA-05,CSF2.0|PR.DS-10,CSF2.0|PR.IR-01,GDPR|32.1.b,HIPAA|164.306(a)(1),HIPAA|164.312(a)(1),ISO-27001-2022|A.5.15,ISO-27001-2022|A.5.33,ISO-27001-2022|A.8.3,ISO-27001-2022|A.8.18,ISO-27001-2022|A.8.20,ISO/IEC-27001|A.9.4.1,ISO/IEC-27001|A.9.4.5,ITSG-33|AC-3(4),LEVEL|2M,NESA|T4.2.1,NESA|T5.4.4,NESA|T5.4.5,NESA|T5.5.4,NESA|T5.6.1,NESA|T7.5.2,NESA|T7.5.3,NIAv2|AM3,NIAv2|SS29,QCSC-v1|3.2,QCSC-v1|5.2.2,QCSC-v1|13.2,Rule-ID|SV-220717r1081048_rule,STIG-ID|WN10-00-000095,TBA-FIISB|31.1,Vuln-ID|V-220717"
              see_also    : "https://workbench.cisecurity.org/benchmarks/23869"
              show_output : YES
            </report>
          </then>
        </if>
      </else>
    </if>

    <custom_item>
      type        : REGISTRY_SETTING
      description : "1.210 WN10-SO-000160"
      info        : "The system must be configured to prevent anonymous users from having the same rights as the Everyone group.

GROUP ID: V-220931RULE ID: SV-220931r991589

Access by anonymous users must be restricted. If this setting is enabled, then anonymous users have the same rights and permissions as the built-in Everyone group. Anonymous users must not have these permissions or rights."
      solution    : 'Configure the policy value for

Computer Configuration >> Windows Settings >> Security Settings >> Local Policies >> Security Options >> \'Network access: Let Everyone permissions apply to anonymous users\'

to \'Disabled\'.'
      reference   : "800-171|3.4.2,800-171r3|03.04.02a.,800-53|CM-6b.,800-53r5|CM-6b.,CCI|CCI-000366,CN-L3|8.1.10.6(d),CSF|PR.IP-1,CSF2.0|DE.CM-09,CSF2.0|PR.PS-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.9,ITSG-33|CM-6b.,LEVEL|2M,NESA|T3.2.1,Rule-ID|SV-220931r991589_rule,STIG-ID|WN10-SO-000160,SWIFT-CSCv1|2.3,Vuln-ID|V-220931"
      see_also    : "https://workbench.cisecurity.org/benchmarks/23869"
      value_type  : POLICY_DWORD
      value_data  : "0"
      reg_key     : "HKLM\SYSTEM\CurrentControlSet\Control\Lsa"
      reg_item    : "EveryoneIncludesAnonymous"
      reg_option  : CAN_NOT_BE_NULL
    </custom_item>


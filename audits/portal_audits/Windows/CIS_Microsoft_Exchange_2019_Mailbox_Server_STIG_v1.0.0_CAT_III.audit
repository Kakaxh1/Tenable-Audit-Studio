# description : This .audit is designed against the CIS Microsoft Exchange 2019 Mailbox Server STIG Benchmark v1.0.0
#
#<ui_metadata>
#<display_name>CIS Microsoft Exchange 2019 Mailbox Server STIG v1.0.0 CAT III</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Microsoft Exchange 2019 Mailbox Server STIG</name>
#  <profile>CAT III</profile>
#  <version>1.0.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/23653</link>
#</spec>
#<labels>agent,cis,exchange_server_2019_mailbox</labels>

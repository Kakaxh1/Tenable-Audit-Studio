    <if>
      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type            : AUDIT_POWERSHELL
          description     : "session_cookie_module"
          value_type      : POLICY_TEXT
          value_data      : '^[\\s]*session_cookie_module[\\s]+\\(shared\\)'
          powershell_args : '$output=(@HTTPD_EXECUTABLE_LOCATION@ -M | select-string session_cookie_module); foreach-object { if(!$output){ $result=\\"No entries found\\" } else { $result=$output }; $result };'
          check_type      : CHECK_REGEX
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "Session On"
          value_type  : POLICY_TEXT
          value_data  : "@HTTPD_CONF_LOCATION@\\httpd.conf"
          regex       : '^[\\s]*Session[\\s]+'
          expect      : '^[\\s]*Session[\\s]+[Oo]n[\\s]*$'
        </custom_item>

        <custom_item>
          type        : FILE_CONTENT_CHECK
          description : "SessionCookieName"
          value_type  : POLICY_TEXT
          value_data  : "@HTTPD_CONF_LOCATION@\\httpd.conf"
          regex       : '^[\\s]*SessionCookieName[\\s]+'
          expect      : '^[\\s]*SessionCookieName[\\s]+.*httpOnly.*secure'
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "AS24-W2-000870 - Cookies exchanged between the Apache web server and the client, such as session cookies, must have cookie properties set to prohibit client-side scripts from reading the cookie data"
          info        : "A cookie can be read by client-side scripts easily if cookie properties are not set properly. By allowing cookies to be read by the client-side scripts, information such as session identifiers could be compromised and used by an attacker who intercepts the cookie. Setting cookie properties (i.e., HttpOnly property) to disallow client-side scripts from reading cookies better protects the information inside the cookie."
          solution    : "Set 'Session' to 'on'.

Ensure the 'SessionCookieName' directive includes 'httpOnly' and 'secure'."

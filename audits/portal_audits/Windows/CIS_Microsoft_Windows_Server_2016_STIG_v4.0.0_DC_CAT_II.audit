          see_also    : "https://workbench.cisecurity.org/benchmarks/23093"
          value_type  : POLICY_DWORD
          value_data  : "2"
          reg_key     : "HKLM\System\CurrentControlSet\Services\NTDS\Parameters"
          reg_item    : "LDAPServerIntegrity"
          reg_option  : CAN_NOT_BE_NULL
        </custom_item>
      </then>


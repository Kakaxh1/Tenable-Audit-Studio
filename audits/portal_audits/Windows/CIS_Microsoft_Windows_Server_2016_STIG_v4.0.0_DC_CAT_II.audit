          see_also    : "https://workbench.cisecurity.org/benchmarks/23093"
          value_type  : USER_RIGHT
          value_data  : "builtin\Administrators" || ("builtin\Administrators" && "NT VIRTUAL MACHINE\Virtual Machines")

          see_also    : "https://workbench.cisecurity.org/benchmarks/23093"
          value_type  : USER_RIGHT
          value_data  : "Administrators" && "Authenticated Users" && "Enterprise Domain Controllers"
          right_type  : SeNetworkLogonRight
        </custom_item>
      </then>


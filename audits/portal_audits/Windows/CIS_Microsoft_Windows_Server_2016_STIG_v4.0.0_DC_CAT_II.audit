          see_also        : "https://workbench.cisecurity.org/benchmarks/23093"
          value_type      : POLICY_TEXT
          value_data      : "^Manual Review Required$"
          powershell_args : "Get-ADUser -Filter {(Enabled -eq $True) -and (SmartcardLogonRequired -eq $False)} | FT Name"
          severity        : MEDIUM
        </custom_item>

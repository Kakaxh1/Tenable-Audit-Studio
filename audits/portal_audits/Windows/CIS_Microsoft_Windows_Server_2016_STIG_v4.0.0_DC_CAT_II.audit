#  <variable>
#    <name>PASSWORD_LAST_SET</name>
#    <default>365</default>
#    <description>Password Last Set</description>
#    <info>The date a password was last changed - WN16-00-000070.</info>
#    <value_type>INTEGER</value_type>
#  </variable>
#  <variable>
#    <name>MAN_SVC_ACCT</name>
#    <default>ServiceAccount</default>
#    <description>Manually-created service account name</description>
#    <info>Name of manually-created service account to be evaluated for WN16-00-000070.</info>
#    <value_type>WIN_ACCT</value_type>

      see_also    : "https://workbench.cisecurity.org/benchmarks/23698"
      value_type  : POLICY_TEXT
      value_data  : '^([1-9][0-9]{0,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$'
      appcmd_args : 'list config {} /section:requestFiltering /text:requestLimits.maxURL'
      appcmd_list : 'list sites'
      check_type  : CHECK_REGEX
    </custom_item>


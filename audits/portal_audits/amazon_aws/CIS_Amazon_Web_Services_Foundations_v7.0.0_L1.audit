  <xsl:for-each select=\"//rds:DBInstance\">
  <xsl:value-of select=\"rds:DBInstanceIdentifier\"/><xsl:text> : MultiAZ = </xsl:text><xsl:value-of select=\"rds:MultiAZ\"/><xsl:text>&#10;</xsl:text>
  </xsl:for-each>
  </xsl:when>

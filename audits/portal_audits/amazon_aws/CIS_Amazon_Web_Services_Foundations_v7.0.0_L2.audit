  aws_action     : "DescribeTrails"
  json_transform : 'if .[0].trailList == [] then "No Trails defined" else .[0].trailList[] end | "\(.Name) - KmsKeyId = \(.KmsKeyId // "No Key Defined")"'
  regex          : "KmsKeyId = "
  not_expect     : "KmsKeyId = No Key Defined"

#    <name>MONGO_REPO_FILE</name>
#    <default>/etc/yum.repos.d/mongodb-enterprise-8.0.repo</default>
#    <description>Path to the MongoDB Enterprise yum repo file</description>
#    <info>Default location for the MongoDB Enterprise 8.0 yum repository definition</info>
#    <value_type>UNIX_FILE_PATH</value_type>
#  </variable>
#  <variable>
#    <name>CAFILE_PATH</name>
#    <default>/etc/ssl/mongo-ca.pem</default>
#    <description>Full path to the MongoDB TLS CA file</description>

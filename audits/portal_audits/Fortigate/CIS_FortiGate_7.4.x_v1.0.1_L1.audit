</custom_item>

<if>
  <condition auto:"FAILED" type:"AND">
    <custom_item>
      description : "check that fortianalyzer is set to reliable"
      context     : "config log fortianalyzer setting"
      expect      : "set[\s]+reliable[\s]+enable"
    </custom_item>

    <custom_item>

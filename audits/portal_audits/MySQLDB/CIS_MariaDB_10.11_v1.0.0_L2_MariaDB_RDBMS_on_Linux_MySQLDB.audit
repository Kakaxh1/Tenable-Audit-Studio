    <if>
      <condition type:"AND">
        <custom_item>
          type        : SQL_POLICY
          description : "Check if replication is running"
          sql_request : "SELECT variable_value FROM information_schema.global_status WHERE variable_name = 'Slave_running';"
          sql_types   : STRING

#    <info>MariaDB Version</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>SSL_CIPHERS</name>
#    <default>ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384</default>

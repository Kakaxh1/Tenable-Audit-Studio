#    <name>MARIADB_INNODB_LOG_DIR</name>
#    <default>/var/lib/mysql</default>
#    <description>InnoDB log directory</description>
#    <info>innodb_log_group_home_dir location.</info>
#    <value_type>UNIX_FILE_PATH</value_type>
#  </variable>
#  <variable>
#    <name>MARIADB_INNODB_UNDO_DIR</name>
#    <default>/var/lib/mysql</default>
#    <description>InnoDB undo directory</description>
#    <info>innodb_undo_directory location.</info>
#    <value_type>UNIX_FILE_PATH</value_type>

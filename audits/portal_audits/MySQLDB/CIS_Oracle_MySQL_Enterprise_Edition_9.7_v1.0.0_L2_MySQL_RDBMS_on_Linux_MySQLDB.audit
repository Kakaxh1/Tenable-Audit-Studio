          description : "Condition: audit_log_encryption is set to AES"
          sql_request : "SELECT IFNULL((SELECT VARIABLE_VALUE FROM performance_schema.global_variables WHERE VARIABLE_NAME = 'audit_log_encryption'), 'NOT_CONFIGURED')"
          sql_types   : REGEX
          sql_expect  : "(?i)^AES$"
        </custom_item>

        <custom_item>
          type        : SQL_POLICY
          description : "Condition: SELECT INNODB_TABLESPACES.NAME, INNODB_TABLESPACES.ENCR..."
          sql_request : "SELECT INNODB_TABLESPACES.NAME, INNODB_TABLESPACES.ENCRYPTION FROM information_schema.INNODB_TABLESPACES WHERE NAME NOT IN ('innodb_temporary','sys/sys_config');"

#<ui_metadata>
#<display_name>CIS Oracle MySQL Enterprise Edition 9.7 v1.0.0 L2 MySQL RDBMS on Linux MySQLDB</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Oracle MySQL Enterprise Edition 9.7</name>
#  <profile>L2 MySQL RDBMS on Linux</profile>
#  <version>1.0.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/22687</link>
#</spec>
#<labels>cis,mysql_9.7_enterprise</labels>
#<benchmark_refs>800-53,800-53r5,CSCv7,CSCv8,LEVEL</benchmark_refs>
#<variables>
#  <variable>
#    <name>MYSQL_LICENSE</name>
#    <default>Commercial</default>
#    <description>Whether this is Commercial or GPL</description>
#    <info>This determines whether the version is Enterprise or Community.</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>MYSQL_VERSION</name>
#    <default>26\.7\..*</default>
#    <description>Regex to match the installed MySQL version string</description>
#    <info>Default targets Oracle MySQL 9.7</info>
#    <value_type>STRING</value_type>
#  </variable>

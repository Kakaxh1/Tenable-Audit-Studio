  sql_request : "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '@SECURITY_LABEL_SCHEMA@' UNION SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA = '@SECURITY_LABEL_SCHEMA@' AND TABLE_TYPE = 'BASE TABLE';"
  sql_types   : STRING
  sql_expect  : "^Manual Review Required$"
  severity    : MEDIUM
</custom_item>


    <if>
      <condition type:"AND">
        <custom_item>
          type        : SQL_POLICY
          description : "check if any connection limits are configured"
          sql_request : "SELECT 'limits_configured', COUNT(*) FROM (SELECT 1 FROM information_schema.global_variables WHERE VARIABLE_NAME = 'max_user_connections' AND CAST(VARIABLE_VALUE AS UNSIGNED) > 0 UNION ALL SELECT 1 FROM mysql.user WHERE user NOT LIKE 'mysql.%' AND user NOT LIKE 'root' AND (max_connections > 0 OR max_user_connections > 0)) t;"
          sql_types   : STRING, REGEX
          sql_expect  : "limits_configured", "^[1-9][0-9]*$"
        </custom_item>
      </condition>


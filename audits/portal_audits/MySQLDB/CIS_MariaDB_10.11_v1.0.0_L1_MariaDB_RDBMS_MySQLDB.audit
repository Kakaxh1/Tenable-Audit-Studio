      <condition auto:"FAILED" type:"AND">
        <custom_item>
          type        : SQL_POLICY
          description : "check password_reuse_check plugin is loaded"
          sql_request : "select plugin_status, load_option from information_schema.plugins where PLUGIN_NAME='password_reuse_check';"
          sql_types   : STRING, STRING
          sql_expect  : "ACTIVE", "FORCE_PLUS_PERMANENT"
        </custom_item>

        <custom_item>
          type        : SQL_POLICY

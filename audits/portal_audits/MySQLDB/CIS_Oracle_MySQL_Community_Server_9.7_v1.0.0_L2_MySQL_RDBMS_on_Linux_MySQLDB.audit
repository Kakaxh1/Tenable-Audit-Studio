          sql_types   : STRING, STRING, STRING, REGEX
          sql_expect  : "innodb_redo_log_encrypt", "ON", "AT REST ENCRYPTION", "AES|Encrypted|Not Encrypted"
        </custom_item>

        <custom_item>

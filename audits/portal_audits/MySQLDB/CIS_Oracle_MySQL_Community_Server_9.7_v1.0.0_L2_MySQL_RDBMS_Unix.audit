#
# description : This .audit is designed against the CIS Oracle MySQL Community Server 9.7 Benchmark v1.0.0
#
#<ui_metadata>
#<display_name>CIS Oracle MySQL Community Server 9.7 v1.0.0 L2 MySQL RDBMS Unix</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Oracle MySQL Community Server 9.7</name>
#  <profile>L2 MySQL RDBMS</profile>
#  <version>1.0.0</version>
#  <link>https://workbench.cisecurity.org/benchmarks/22688</link>
#</spec>
#<labels>agent,cis,linux_host_os</labels>
#<benchmark_refs>800-53,800-53r5,CSCv7,CSCv8,LEVEL</benchmark_refs>
#</ui_metadata>

<check_type:"Unix">

<if>
  <condition type:"AND">
    <custom_item>
      type        : CMD_EXEC
      description : "Linux found"
      cmd         : "uname -a"
      expect      : "Linux"
    </custom_item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "CIS_Oracle_MySQL_Community_Server_9.7_v1.0.0_L2_MySQL_RDBMS_Unix.audit from CIS Oracle MySQL Community Server 9.7 v1.0.0"
      see_also    : "https://workbench.cisecurity.org/benchmarks/22688"
      show_output : YES
    </report>

    <if>
      <condition auto:"FAILED" type:"OR">
        <custom_item>
          type        : CMD_EXEC
          description : "MySQL chroot configuration check"
          cmd         : "/bin/grep -E '^chroot=' /etc/mysql/my.cnf /etc/my.cnf 2>/dev/null | /bin/awk -F= '{if ($2 && $2 !~ /^[[:space:]]*$/) print \"chroot configured:\", $2; else print \"chroot empty or invalid\"}' | /bin/head -1; if [ $? -ne 0 ] || [ -z \"$(/bin/grep -E '^chroot=' /etc/mysql/my.cnf /etc/my.cnf 2>/dev/null | /bin/awk -F= '{if ($2 && $2 !~ /^[[:space:]]*$/) print $2}')\" ]; then /bin/echo 'chroot not configured'; fi"
          expect      : "^chroot configured:"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "MySQL systemd user configuration check"
          cmd         : "/bin/systemctl show mysqld.service mysql.service mariadb.service 2>/dev/null | /bin/grep '^User=' | /bin/head -1 | /bin/awk -F= '{if ($2 && $2 != \"root\" && $2 !~ /^[[:space:]]*$/) print \"systemd user configured:\", $2; else print \"systemd user not configured or running as root\"}'; if [ $(/bin/systemctl show mysqld.service mysql.service mariadb.service 2>/dev/null | /bin/grep -c '^User=') -eq 0 ]; then /bin/echo 'systemd service not found'; fi"
          expect      : "^systemd user configured:"
        </custom_item>

        <custom_item>
          type        : CMD_EXEC
          description : "MySQL Docker container running check"
          cmd         : "if /bin/docker -v >/dev/null 2>&1; then if /bin/docker images --format '{{.Repository}}' 2>/dev/null | /bin/grep -q mysql; then if /bin/docker ps --format '{{.Image}}' 2>/dev/null | /bin/grep -q mysql; then /bin/echo 'MySQL running in Docker container'; else /bin/echo 'MySQL Docker image exists but no container running'; fi; else /bin/echo 'No MySQL Docker image found'; fi; else /bin/echo 'Docker not installed'; fi"
          expect      : "^MySQL running in Docker container$"
        </custom_item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "1.7 Ensure MySQL is Run Under a Sandbox Environment"
          info        : "Use of the chroot() system call at startup, Systemd with settings to achieve isolation, or Docker will put MySQL in a sandbox environment.

Running MySQL in a Sandbox environment may reduce the impact of a MySQL-born vulnerability by making portions of the file system inaccessible to the MySQL instance."
          solution    : "Perform one of the following steps to remediate this setting:

 - Configure MySQL to use chroot:

 - Choose a non-system partition <chroot location> for MySQL
 - Add chroot= <chroot_location> to the my.cnf option file

 - Configure MySQL to run under systemd:

 - If mysql is managed by systemd and running, stop the service:
$ sudo systemctl stop <mysqld>.service

 - If a mysql user and group do not already exist, create them:
$ sudo groupadd mysql
$ sudo useradd -r -g mysql -s /bin/false mysql

 - Set the ownership of the base directory:
$ sudo chown -R mysql:mysql /usr/local/mysql/

 - Create or modify the <mysqld> .service file in /lib/systemd/system to include the following entries, if not already present:
[Unit]
Description=MySQL Server

[Install]
WantedBy=multi-user.target

[Service]
User=mysql
Group=mysql

 - If mysql was not already managed by systemd execute this command:
$ sudo systemctl daemon-reload

 - Start the MySQL server:
$ sudo systemctl start <mysqld>.service

 - If you would like mysql to automatically run at startup execute this command:
$ sudo systemctl enable <mysqld>.service

 - Follow documentation in the references for standing up MySQL in a Docker container.

Impact:

Use of the chroot option somewhat limits LOAD DATA INFILE and SELECT ... INTO OUTFILE."
          reference   : "800-171|3.13.4,800-171r3|03.13.04,800-53|SC-4,800-53r5|SC-4,CSCv7|2.10,CSCv8|3.12,CSF2.0|PR.DS-01,CSF2.0|PR.DS-02,CSF2.0|PR.DS-10,CSF2.0|PR.IR-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ITSG-33|SC-4,ITSG-33|SC-4a.,LEVEL|2M"
          see_also    : "https://workbench.cisecurity.org/benchmarks/22688"
          show_output : YES
        </report>
      </then>
    </if>
  </then>

  <else>
    <report type:"WARNING">
      description : "CIS_Oracle_MySQL_Community_Server_9.7_v1.0.0_L2_MySQL_RDBMS_Unix.audit from CIS Oracle MySQL Community Server 9.7 v1.0.0"
      info        : "NOTE: Nessus has not identified that the chosen audit applies to the target device."
      see_also    : "https://workbench.cisecurity.org/benchmarks/22688"
      show_output : YES
    </report>
  </else>
</if>

</check_type>

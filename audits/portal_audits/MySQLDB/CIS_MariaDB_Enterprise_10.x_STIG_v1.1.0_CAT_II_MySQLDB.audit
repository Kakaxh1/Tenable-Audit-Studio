      sql_request : "SELECT sau.host, sau.user, saf.filtername, JSON_DETAILED(saf.rule) AS rule FROM mysql.server_audit_filters saf JOIN mysql.server_audit_users sau ON saf.filtername = sau.filtername WHERE saf.filtername != 'default';"

      sql_expect  : "^Manual Review Required$"
      severity    : MEDIUM
    </custom_item>

    <custom_item>
      type        : SQL_POLICY
      description : "Audit filters include query_events (review mysql.server_audit_filters)"
      sql_request : "SELECT filtername, rule FROM mysql.server_audit_filters;"

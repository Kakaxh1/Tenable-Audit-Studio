      json_transform : '.[] | select(.settingName == "ServicePrincipalAccessGlobalAPIs") | .title as $title | if (.enabledSecurityGroups | length > 0) then (.enabledSecurityGroups[] | "Setting: \($title), Security Group: \(.name)") else "Setting: \($title), Enabled: \(.enabled), no security groups are set" end'

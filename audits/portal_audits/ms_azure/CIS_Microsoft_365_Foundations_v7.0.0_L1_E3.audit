  request        : "listConditionalAccess"
  json_transform : '.[] | .displayName as $displayName | .conditions.users.includeRoles as $roles
  | select(.state == "enabled")
  | select(.conditions.applications.includeApplications[]? == "All")
  | select(.sessionControls.signInFrequency.isEnabled == true)
  | select(.sessionControls.persistentBrowser.isEnabled == true)
  | select(.sessionControls.persistentBrowser.mode == "never")
  | select(
      (.sessionControls.signInFrequency.frequencyInterval == "everyTime")
      or
      (.sessionControls.signInFrequency.type == "hours" and .sessionControls.signInFrequency.value <= 4)
    )
  | (if .sessionControls.signInFrequency.frequencyInterval == "everyTime" then "every time" else "\(.sessionControls.signInFrequency.value) hour(s)" end) as $interval
  | ($roles[] | select(. == "9b895d92-2cd3-44c7-9d02-a6ac2d5ea5c3"))
  | ($roles[] | select(. == "158c047a-c907-4556-b7ef-446551a6b5f7"))
  | ($roles[] | select(. == "c4e39bd9-1100-46d3-8c65-fb160da0071f"))
  | ($roles[] | select(. == "7be44c8a-adaf-4e2a-84d6-ab2649e08a13"))

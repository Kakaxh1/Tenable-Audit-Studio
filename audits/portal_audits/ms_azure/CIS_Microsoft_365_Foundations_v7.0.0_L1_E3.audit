      description    : "ElevatedGuestsTenant disabled"
      request        : "getFabricTenantsettings"
      json_transform : '.[] | select(.settingName == "ElevatedGuestsTenant") | "Setting: \(.title), Enabled: \(.enabled)"'
      regex          : ".+"
      expect         : "Setting: Guest users can browse and access Fabric content, Enabled: false"
    </custom_item>

    <custom_item>
      description    : "ElevatedGuestsTenant enabledSecurityGroups set"
      request        : "getFabricTenantsettings"
      json_transform : '.[] | select(.settingName == "ElevatedGuestsTenant") | .title as $title | if (.enabledSecurityGroups | length > 0) then (.enabledSecurityGroups[] | "Setting: \($title), Security Group: \(.name)") else "Setting: \($title), Enabled: \(.enabled), no security groups are set" end'
      regex          : ".+"

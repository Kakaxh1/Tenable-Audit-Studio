  see_also    : "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_Dell_OS10_Switch_Y26M04_STIG.zip"
  regex       : "password-attributes"
  item        : "password-attributes character-restriction upper @UPPER_CASE@\b"
</custom_item>


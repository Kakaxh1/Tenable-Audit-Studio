<if>
  <condition auto:"WARNING" type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "internal"
      context     : "ip access-list @INTERNAL_ACL@"
      regex       : "^Manual Review Required$"
      item        : "deny icmp any host [^ ]+ fragments"
      severity    : MEDIUM
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "external"
      context     : "ip access-list @EXTERNAL_ACL@"
      regex       : "^Manual Review Required$"
      item        : "deny icmp any [^ ]+ fragments"
      severity    : MEDIUM
    </item>

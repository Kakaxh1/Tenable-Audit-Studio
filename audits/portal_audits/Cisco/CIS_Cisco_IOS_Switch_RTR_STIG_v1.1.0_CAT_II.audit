SW1(config)#ipv6 access-list FILTER_IPV6
SW1(config-ipv6-acl)#deny any any dest-option-type 2
SW1(config-ipv6-acl)#deny any any dest-option-type 3
SW1(config-ipv6-acl)#deny any any dest-option-type 6

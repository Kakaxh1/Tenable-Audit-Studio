    </item>
  </condition>

  <then>
    <if>
      <condition auto:"WARNING" type:"AND">
        <item>
          type        : CONFIG_CHECK
          description : "router bgp"
          context     : "router bgp [^ ]+"
          item        : "neighbor [^ ]+ prefix-list [^ ]+"
          severity    : MEDIUM
        </item>

        <item>
          type        : CONFIG_CHECK
          description : "show ip prefix-list"

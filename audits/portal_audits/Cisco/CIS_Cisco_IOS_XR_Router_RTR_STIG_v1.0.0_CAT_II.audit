<if>
  <condition auto:"WARNING" type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "deny 0.0.0.0"
      context     : "ipv4 access-list @EXTERNAL_ACL_INBOUND@"
      item        : "deny ipv4 0.0.0.0 0.255.255.255 any log-input"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "deny 10.0.0.0"

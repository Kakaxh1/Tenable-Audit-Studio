    </item>

    <item>
      type        : CONFIG_CHECK
      description : "deny 192.0.0.0"
      context     : "ipv4 access-list @EXTERNAL_ACL_INBOUND@"
      item        : "deny ipv4 192.0.0.0 0.0.0.255 any log-input"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "deny 192.0.2.0"
      context     : "ipv4 access-list @EXTERNAL_ACL_INBOUND@"
      item        : "deny ipv4 192.0.2.0 0.0.0.255 any log-input"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "deny 192.168.0.0"
      context     : "ipv4 access-list @EXTERNAL_ACL_INBOUND@"
      item        : "deny ipv4 192.168.0.0 0.0.255.255 any log-input"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "deny 198.18.0.0"
      context     : "ipv4 access-list @EXTERNAL_ACL_INBOUND@"
      item        : "deny ipv4 198.18.0.0 0.1.255.255 any log-input"
    </item>

    <item>

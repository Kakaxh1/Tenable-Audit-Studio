    </item>

    <item>
      type        : CONFIG_CHECK
      description : "deny 100.64.0.0"
      context     : "ipv4 access-list @EXTERNAL_ACL_INBOUND@"
      item        : "deny ipv4 100.64.0.0 0.63.255.255 any log-input"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "deny 127.0.0.0"
      context     : "ipv4 access-list @EXTERNAL_ACL_INBOUND@"

<if>
  <condition auto:"WARNING" type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "ip pim register-policy"
      item        : "ip pim register-policy @PIM_REGISTER_FILTER@"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "route map"
      context     : "ip pim register-policy @PIM_REGISTER_FILTER@"
      regex       : "^Manual Review Required$"

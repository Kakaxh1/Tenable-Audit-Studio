  <then>
    <if>
      <condition auto:"WARNING" type:"AND">
        <item>
          type        : CONFIG_CHECK
          description : "ip as-path"
          regex       : "Manual Review Required"
          item        : "ip as-path access-list [^ ]+"
          severity    : MEDIUM
        </item>

        <item>
          type        : CONFIG_CHECK
          description : "router bgp filter-list"
          context     : "router bgp"
          item        : "filter-list [^ ]+ in"
          severity    : MEDIUM
        </item>
      </condition>


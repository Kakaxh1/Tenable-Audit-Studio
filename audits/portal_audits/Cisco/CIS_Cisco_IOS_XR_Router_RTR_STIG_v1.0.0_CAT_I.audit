      reference   : "800-53|CP-8,800-53r5|SC-47,CAT|I,CCI|CCI-004931,CSF|ID.BE-4,CSF|PR.PT-4,CSF2.0|PR.IR-04,GDPR|32.1.b,GDPR|32.1.c,HIPAA|164.306(a)(1),HIPAA|164.312(a)(2)(ii),ISO-27001-2022|A.5.29,ISO-27001-2022|A.7.11,ITSG-33|CP-8,ITSG-33|CP-8a.,LEVEL|1M,NESA|T2.2.4,NESA|T4.5.1,QCSC-v1|5.2.1,Rule-ID|SV-216792r991939_rule,STIG-ID|CISC-RT-000640,Vuln-ID|V-216792"
      see_also    : "https://workbench.cisecurity.org/benchmarks/23599"

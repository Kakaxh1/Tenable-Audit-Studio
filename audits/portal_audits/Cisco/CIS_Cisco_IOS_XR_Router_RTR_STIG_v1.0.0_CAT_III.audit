    </item>
  </condition>

  <then>
    <if>
      <condition auto:"WARNING" type:"AND">
        <item>
          type        : CONFIG_CHECK
          description : "accept-register ACL"
          context     : "ipv4 access-list @PIM_REGISTER_FILTER@"

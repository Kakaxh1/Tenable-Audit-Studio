        </item>

        <item>
          type        : CONFIG_CHECK
          description : "accept-register ACL mapped to router pim"
          context     : "router pim"
          item        : "allow-rp group-list @FILTER_PIM_JOINS@"
          severity    : MEDIUM
        </item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "1.85 CISC-RT-000840"
          info        : "The Cisco multicast Rendezvous Point (RP) router must be configured to filter Protocol Independent Multicast (PIM) Join messages received from the Designated Router (DR) for any undesirable multicast groups.


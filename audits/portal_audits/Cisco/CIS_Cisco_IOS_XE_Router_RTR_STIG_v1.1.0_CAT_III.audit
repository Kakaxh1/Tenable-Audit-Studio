R5(config-if)#exit
R5(config)#int g1/2
R5(config-if)#service-policy output QOS_POLICY
R5(config-if)#end"
      reference   : "800-53|SC-5(2),800-53r5|SC-5(2),CAT|III,CCI|CCI-001095,CSF|PR.DS-4,CSF2.0|DE.CM-01,CSF2.0|PR.IR-01,GDPR|32.1.b,HIPAA|164.306(a)(1),ISO-27001-2022|A.8.6,ITSG-33|SC-5(2),LEVEL|3M,NESA|T3.3.1,NIAv2|GS8e,NIAv2|GS10c,QCSC-v1|8.2.1,Rule-ID|SV-216715r917436_rule,STIG-ID|CISC-RT-000770,SWIFT-CSCv1|6.4,Vuln-ID|V-216715"

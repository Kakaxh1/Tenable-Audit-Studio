# description : This .audit is designed against the CIS Cisco NX OS Switch NDM STIG Benchmark v1.1.0
#
#<ui_metadata>
#<display_name>CIS Cisco NX OS Switch NDM STIG v1.1.0 CAT I</display_name>
#<spec>
#  <type>CIS</type>
#  <name>Cisco NX OS Switch NDM STIG</name>
#  <profile>CAT I</profile>
#  <version>1.1.0</version>

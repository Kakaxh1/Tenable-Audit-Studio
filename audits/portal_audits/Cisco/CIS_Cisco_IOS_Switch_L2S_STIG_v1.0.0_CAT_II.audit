#    <description>List of VLANs with Dynamic ARP Inspection (DAI) explicitly enabled.</description>
#    <info>This variable is used to confirm that ip arp inspection vlan is configured on all user VLANs, e.g., ip arp inspection vlan 2,4-8,11.</info>
#    <value_type>STRING</value_type>
#  </variable>
#  <variable>
#    <name>SNOOPING_VLAN_LIST</name>
#    <default>2,4-8,11</default>
#    <description>List of VLANs on which DHCP snooping is explicitly enabled.</description>
#    <info>This value is used to verify that DHCP snooping is configured on a per-VLAN basis, such as in ip dhcp snooping vlan 4,6-10.</info>
#    <value_type>STRING</value_type>
#  </variable>
#</variables>
